---
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import AnnouncementBanner from '../components/ui/AnnouncementBanner.astro';
import ChatWidget from '../components/ui/ChatWidget';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { 
  title, 
  description = "The Bluffline is a 20-mile multimodal corridor transforming how Pensacola connects neighborhoods, parks, and the waterfront.",
  currentPath = Astro.url.pathname
} = Astro.props;

const fullTitle = title === 'Home' 
  ? "The Bluffline | Pensacola's 20-Mile Multimodal Corridor"
  : `${title} | The Bluffline`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <!-- TODO: Replace with final logo files once provided -->
  <link rel="icon" type="image/svg+xml" href="/images/logos/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logos/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/logos/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/logos/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <AnnouncementBanner
    text="Our 2025 Annual Report is here."
    linkText="Read it now"
    href="/documents/annual-reports/2025"
  />

  <Header currentPath={currentPath} />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <!-- Floating chat widget (Astro React island, hydrated client-side) -->
  <ChatWidget client:load />

  <!-- ChatKit web component (registers <openai-chatkit> custom element) -->
  <script src="https://cdn.platform.openai.com/deployments/chatkit/chatkit.js" async></script>

  <!-- Kit (ConvertKit) Modal Script -->
  <script async data-uid="3f946cf4ba" src="https://bluffline.kit.com/3f946cf4ba/index.js"></script>
</body>
</html>
