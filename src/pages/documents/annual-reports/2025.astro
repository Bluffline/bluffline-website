---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReportHero from '../../../components/report/ReportHero.astro';
import BigQuote from '../../../components/report/BigQuote.astro';
import StatCard from '../../../components/report/StatCard.astro';
import MilestoneCard from '../../../components/report/MilestoneCard.astro';
import PartnerCard from '../../../components/report/PartnerCard.astro';
import ProjectSpotlight from '../../../components/report/ProjectSpotlight.astro';
import PhaseTracker from '../../../components/ui/PhaseTracker.astro';
import EventHighlight from '../../../components/report/EventHighlight.astro';
import AwardFeature from '../../../components/report/AwardFeature.astro';
import TestimonialCard from '../../../components/content/TestimonialCard.astro';
import DocumentCard from '../../../components/content/DocumentCard.astro';
import MediaLightbox from '../../../components/ui/MediaLightbox.astro';
import Button from '../../../components/ui/Button.astro';
import { getCollection } from 'astro:content';

// Get testimonials for the featured voices
const allTestimonials = await getCollection('testimonials');
const featuredTestimonials = allTestimonials.filter(t =>
  ['reeves-dc', 'hofberger-robert', 'diaz-joe'].includes(t.id)
);

// Get projects for the project spotlight sections
const allProjects = await getCollection('projects');
const chimneyParkProject = allProjects.find(p => p.id === 'chimney-park');
const rcpProject = allProjects.find(p => p.id === 'rcp-reconnecting-communities');
const rcpPhases = rcpProject?.data.reportPhases ?? [];

// Get planning documents for the document section
const allDocuments = await getCollection('documents');
const planningDocuments = allDocuments.filter(d =>
  ['plan-urban-core-cra', 'plan-westside-cra', 'plan-warrington-cra', 'plan-lrtp-2045', 'plan-florida-greenways'].includes(d.id)
);

// Knox White event gallery images for lightbox
const knoxWhiteGallery = [
  { src: '/images/events/mayor-knox-white-keynote.jpg', title: 'Mayor Knox White Speaking', description: 'Mayor Knox White shares lessons from Greenville\'s Swamp Rabbit Trail' },
  { src: '/images/events/knox-white-event-audience.jpg', title: 'Community Gathering', description: 'Community members gather to learn about trail-led economic development' },
  { src: '/images/maps/gena-buchanan-alignment-map.jpg', title: 'Corridor Discussion', description: 'Gena Buchanan discusses the corridor with event attendees' },
  { src: '/images/events/bluffline-event-map-discussion.jpg', title: 'Exploring the Vision', description: 'Exploring the vision for Pensacola\'s connected waterfront' },
];
---

<BaseLayout title="2025 Annual Report | Bluffline">
  <!-- Hero Section -->
  <ReportHero
    year="2025"
    title="From Project to Platform"
    subtitle="Annual Report"
    thesis="2025 was the year the Bluffline shifted from a 'project' to a 'platform.' Not in concrete—in plans, partnerships, policy, and public narrative."
  >
    <img slot="visual" src="/images/aerial/escambia-bay-bluffs-aerial-2024.jpg" alt="Aerial view of the Pensacola bluffs" />
  </ReportHero>

  <!-- Opening Statement -->
  <section class="section bg-warm-white" id="introduction">
    <div class="section-inner">
      <div class="opening-statement">
        <p class="opening-lead">This isn't just a trail project anymore.</p>
        <p>In 2025, the Bluffline became part of how the region plans itself. From city planning frameworks to state transportation priorities, from securing federal commitments to launching a new civic tradition—this year marked a fundamental shift in what the Bluffline means for Pensacola's future.</p>
        <p>This report tells the story of that transformation.</p>
      </div>
    </div>
  </section>

  <!-- Section A: From Project to Policy -->
  <section class="section bg-cream" id="planning-integration">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">Planning Integration</span>
        <h2>From Project to Policy</h2>
        <p>The Bluffline is now embedded in official planning frameworks at every level of government—from City Hall to the State Capitol.</p>
      </div>

      <div class="documents-grid">
        {planningDocuments.map(doc => (
          <DocumentCard
            title={doc.data.title}
            href={doc.data.file || doc.data.link || '#'}
            external={!!doc.data.link}
            agency={doc.data.agency}
            level={doc.data.level}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Thesis Quote Break -->
  <section class="section bg-navy">
    <div class="section-inner">
      <BigQuote
        quote="The Bluffline is crossing from visionary project into official city, regional, and state planning frameworks."
        variant="dark"
      />
    </div>
  </section>

  <!-- Section B: Extending the Corridor -->
  <section class="section bg-warm-white" id="corridor-expansion">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">Vision Expansion</span>
        <h2>Extending the Corridor, Unifying the Vision</h2>
        <p>In 2025, we expanded our planning scope to encompass the full historic bluff system—from UWF to Naval Air Station Pensacola.</p>
      </div>

      <div class="corridor-expansion">
        <div class="expansion-content">
          <h3>A Bigger Vision</h3>
          <p>What began as a focus on the Scenic Highway corridor has grown into something more ambitious: a multimodal waterfront reconnection spine stretching across the full length of Pensacola's historic bluffs.</p>

          <div class="expansion-directions">
            <div class="direction-item">
              <span class="direction-arrow northeast">↗</span>
              <div class="direction-content">
                <span class="direction-label">Northeast Extension</span>
                <span class="direction-target">University of West Florida</span>
              </div>
            </div>
            <div class="direction-item">
              <span class="direction-arrow southwest">↙</span>
              <div class="direction-content">
                <span class="direction-label">Southwest Extension</span>
                <span class="direction-target">Downtown → Naval Air Station Pensacola</span>
              </div>
            </div>
          </div>

          <p class="expansion-reframe">This reframes the corridor from a limited Scenic Highway segment to the <strong>full historic bluff system</strong>—positioning it as Pensacola's primary infrastructure for waterfront access and neighborhood connectivity.</p>
        </div>

        <div class="expansion-map">
          <img src="/images/maps/fdot-scenic-bluffs-highway-extension-map.jpg" alt="Map showing the expanded Bluffline corridor from UWF to Naval Air Station Pensacola" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section C: One Organization, One Vision -->
  <section class="section bg-mist" id="unified-organization">
    <div class="section-inner">
      <div class="section-header centered">
        <span class="section-label">Organizational Maturation</span>
        <h2>One Organization, One Waterfront Vision</h2>
      </div>

      <div class="merger-narrative">
        <div class="merger-timeline">
          <div class="merger-year">
            <span class="year-label">2024</span>
            <span class="year-event">Merger with Scenic Highway Foundation</span>
          </div>
          <div class="merger-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
          <div class="merger-year">
            <span class="year-label">2025</span>
            <span class="year-event">First year of strategic synthesis</span>
          </div>
        </div>

        <div class="legacy-cards">
          <div class="legacy-card">
            <h4>Scenic Highway Foundation Legacy</h4>
            <ul>
              <li>60+ years of scenic preservation</li>
              <li>Historic corridor advocacy</li>
              <li>Community stewardship tradition</li>
            </ul>
          </div>
          <div class="legacy-connector">
            <span>+</span>
          </div>
          <div class="legacy-card">
            <h4>Bluffline Vision</h4>
            <ul>
              <li>Multimodal infrastructure focus</li>
              <li>Federal funding capacity</li>
              <li>Regional planning integration</li>
            </ul>
          </div>
        </div>

        <div class="unified-mission">
          <h3>One Platform Linking:</h3>
          <div class="mission-pillars">
            <div class="pillar">
              <span class="pillar-icon">🌿</span>
              <span class="pillar-label">Scenic Preservation</span>
            </div>
            <div class="pillar">
              <span class="pillar-icon">🚴</span>
              <span class="pillar-label">Mobility</span>
            </div>
            <div class="pillar">
              <span class="pillar-icon">🌊</span>
              <span class="pillar-label">Waterfront Access</span>
            </div>
            <div class="pillar">
              <span class="pillar-icon">🏛️</span>
              <span class="pillar-label">Historic Bluffs</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section D: Partnerships -->
  <section class="section bg-warm-white" id="partnerships">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">Strategic Partnerships</span>
        <h2>Partnerships That Move Projects</h2>
        <p>In 2025, our relationships with key institutions shifted from advocacy to co-development and delivery.</p>
      </div>

      <div class="partner-grid">
        <PartnerCard
          name="City of Pensacola"
          role="Municipal Partner"
          outcome="Joint grant applications, Chimney Park partnership, CRA plan integration"
        />
        <PartnerCard
          name="Escambia County"
          role="County Partner"
          outcome="Multiple joint grant applications, Warrington CRA coordination, regional trail connectivity"
        />
        <PartnerCard
          name="University of West Florida"
          role="Institutional Partner"
          outcome="Corridor extension planning, campus connectivity studies, new administration engagement"
        />
      </div>

      <div class="partnership-shift">
        <div class="shift-before">
          <span class="shift-label">Before</span>
          <span class="shift-mode">Advocacy</span>
        </div>
        <div class="shift-arrow">→</div>
        <div class="shift-after">
          <span class="shift-label">Now</span>
          <span class="shift-mode">Co-Development & Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Voices of Support -->
  <section class="section bg-mist" id="voices">
    <div class="section-inner">
      <div class="section-header centered">
        <span class="section-label">Community Support</span>
        <h2>Voices of Support</h2>
        <p>Regional leaders are speaking out about the Bluffline's potential to transform our community.</p>
      </div>

      <div class="testimonial-grid">
        {featuredTestimonials.map(testimonial => (
          <TestimonialCard
            quote={testimonial.data.quote}
            author={testimonial.data.author}
            title={testimonial.data.title}
            organization={testimonial.data.organization}
            organizationLink={testimonial.data.organizationLink}
            pdfFile={testimonial.data.pdfFile}
          />
        ))}
      </div>

      <div class="testimonials-cta">
        <a href="/friends" class="testimonials-link">
          See all voices of support
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Section E: Chimney Park Spotlight -->
  <section class="section bg-cream" id="chimney-park">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">Project Spotlight</span>
        <h2>From Vision to Dirt (Almost)</h2>
        <p>Chimney Park represents our first tangible, visible project—proof that the Bluffline is moving from plans to places.</p>
      </div>

      <ProjectSpotlight
        project={chimneyParkProject!.data}
        subtitle="First Bluffline Project"
        href="/progress/projects/chimney-park"
      />
    </div>
  </section>

  <!-- Section F: Federal Funding -->
  <section class="section bg-navy" id="federal-funding">
    <div class="section-inner">
      <div class="federal-narrative">
        <div class="section-header light">
          <span class="section-label">Federal Commitment</span>
          <h2>Holding the Federal Line</h2>
        </div>

        <div class="federal-story">
          <p class="federal-lead">At the end of 2024, we received a $1.2 million USDOT Reconnecting Communities award. In 2025, we faced a critical challenge: ensuring that award survived a federal administration transition.</p>

          <div class="federal-timeline">
            <PhaseTracker variant="dark" phases={rcpPhases} />
          </div>

          <div class="obligation-explainer">
            <h4>Why Obligation Matters</h4>
            <p>An award is a promise. An <strong>obligation</strong> is a commitment. When federal funds are obligated, they transform from a discretionary award that can be rescinded into enforceable, real funding that must be spent. Securing obligation through the transition protected years of work and community investment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section G: Building Culture -->
  <section class="section bg-warm-white" id="culture-building">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">Civic Culture</span>
        <h2>Building the Narrative, Not Just the Network</h2>
        <p>2025 was also the year Bluffline began building its own civic culture and traditions—not just its project pipeline.</p>
      </div>

      <!-- Knox White Event -->
      <div class="culture-event">
        <EventHighlight
          title="Greenways as Economic Catalysts"
          date="2025"
          description="We hosted Mayor Knox White of Greenville, South Carolina for a public conversation about how greenways drive economic development. Mayor White shared lessons from Greenville's Swamp Rabbit Trail—a nationally recognized example of trail-led urban revitalization—and how those lessons apply to Pensacola's opportunity."
          imageSrc="/images/events/mayor-knox-white-keynote.jpg"
          imageAlt="Mayor Knox White speaking at the Bluffline event about greenways as economic catalysts"
          sponsor="Voyage Real Estate"
          gallery={knoxWhiteGallery}
        >
          <BigQuote
            quote="The trail didn't just connect neighborhoods—it changed how developers, businesses, and residents thought about what our city could become."
            attribution="Mayor Knox White"
            attributionTitle="Greenville, South Carolina"
          />
        </EventHighlight>
      </div>

      <!-- Bluffline Defender Award -->
      <div class="award-section">
        <div class="award-intro">
          <h3>A New Tradition Begins</h3>
          <p>In 2025, we established the Bluffline Defender Award—an annual recognition honoring individuals who have made exceptional contributions to the vision of a connected Pensacola waterfront.</p>
        </div>

        <AwardFeature
          awardName="The Bluffline Defender Award"
          recipient="Gena Buchanan"
          recipientTitle="Longtime Director, Scenic Highway Foundation"
          description="The inaugural Bluffline Defender Award was presented to Gena Buchanan, whose decades of leadership at the Scenic Highway Foundation laid the groundwork for everything the Bluffline has become. Her tireless advocacy preserved the corridor's scenic character while building the community relationships that made our merger—and our current momentum—possible."
          awardDescription="An engraved walking stick bearing the words 'Bluffline Defender'—symbolizing the long journey of advocacy and the path still ahead."
          imageSrc="/images/events/gena-buchanan-award-ceremony.jpg"
          imageAlt="Gena Buchanan receiving the Bluffline Defender Award"
        >
          <p>This award signals continuity between the Scenic Highway Foundation's legacy and the Bluffline's future. It establishes a tradition of honoring those who walk the long road of civic change.</p>
        </AwardFeature>
      </div>
    </div>
  </section>

  <!-- Section H: Impact Metrics -->
  <section class="section bg-mist" id="impact">
    <div class="section-inner">
      <div class="section-header centered">
        <span class="section-label">2025 Impact</span>
        <h2>What Moved This Year</h2>
        <p>Impact, not accounting. Here's what changed because of this year's work.</p>
      </div>

      <div class="impact-grid">
        <StatCard
          stat="4"
          label="Planning Frameworks"
          description="City, county, regional, and state plans now include the Bluffline"
        />
        <StatCard
          stat="1"
          label="State Presentation"
          description="Invited to present to Florida Greenways & Trails Council"
        />
        <StatCard
          stat="20+"
          label="Miles of Corridor"
          description="Expanded vision from Scenic Highway to full bluff system"
        />
        <StatCard
          stat="$1.2M"
          label="Federal Funding Secured"
          description="Reconnecting Communities award successfully obligated"
        />
        <StatCard
          stat="1"
          label="Project in Delivery"
          description="Chimney Park moving from planning to construction"
        />
        <StatCard
          stat="3"
          label="Major Partnerships"
          description="City, County, and UWF now in co-development mode"
        />
        <StatCard
          stat="1st"
          label="Bluffline Defender Award"
          description="New annual tradition honoring corridor champions"
        />
        <StatCard
          stat="1"
          label="National Speaker Hosted"
          description="Mayor Knox White on greenways as catalysts"
        />
      </div>

      <div class="financials-footer">
        <p>For complete financial information, including our Form 990 and audited statements, visit our <a href="/about#documents">documents page</a>.</p>
      </div>
    </div>
  </section>

  <!-- Closing Section -->
  <section class="section closing-section" id="looking-ahead">
    <div class="closing-background">
      <img src="/images/events/corridor-team-walk-tracks.jpg" alt="" aria-hidden="true" />
      <div class="closing-gradient"></div>
    </div>
    <div class="section-inner">
      <div class="closing-content">
        <h2>Looking Ahead</h2>
        <p class="closing-lead">2025 proved that the Bluffline is no longer just a proposal. It's becoming infrastructure—for mobility, for access, and for how this region thinks about its future.</p>
        <p>In the years ahead, we'll move from planning to construction. From vision to visible change. From a project to a permanent part of Pensacola's landscape.</p>
        <p class="closing-thesis">The platform is built. Now we build on it.</p>
        <div class="closing-cta">
          <Button href="/support">Join the Movement</Button>
          <Button href="/progress" variant="outline">See Our Progress</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox for galleries -->
  <MediaLightbox />
</BaseLayout>

<style>
  /* Opening Statement */
  .opening-statement {
    max-width: 800px;
  }

  .opening-lead {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .opening-statement p {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.85;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* Milestone Grid */
  .milestone-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .milestone-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .milestone-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Planning Visual */
  .planning-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 3rem;
    background: white;
    border-radius: 20px;
    border: 1px solid rgba(45, 48, 71, 0.08);
  }

  .planning-ladder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .ladder-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ladder-level {
    padding: 0.75rem 2rem;
    background: var(--mist);
    border-radius: 8px;
    font-weight: 600;
    color: var(--navy);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ladder-connector {
    width: 2px;
    height: 24px;
    background: var(--spring);
  }

  .ladder-base {
    padding: 1rem 3rem;
    background: var(--forest);
    border-radius: 12px;
    margin-top: 0.5rem;
  }

  .ladder-base span {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    color: white;
    font-weight: 500;
  }

  .planning-caption {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.7;
    text-align: center;
    max-width: 500px;
    margin: 0;
  }

  /* Planning Documents */
  .planning-documents {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(45, 48, 71, 0.1);
  }

  .planning-documents h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .documents-intro {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .documents-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .documents-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .documents-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Corridor Expansion */
  .corridor-expansion {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .corridor-expansion {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .expansion-content h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .expansion-content p {
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .expansion-directions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem 0;
  }

  .direction-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--mist);
    border-radius: 12px;
  }

  .direction-arrow {
    font-size: 1.5rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--spring);
    border-radius: 50%;
    color: var(--forest);
    flex-shrink: 0;
  }

  .direction-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .direction-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    font-weight: 600;
  }

  .direction-target {
    font-size: 1rem;
    color: var(--navy);
    font-weight: 500;
  }

  .expansion-reframe {
    padding: 1.5rem;
    background: rgba(153, 204, 99, 0.1);
    border-left: 3px solid var(--spring);
    border-radius: 0 12px 12px 0;
  }

  .expansion-reframe strong {
    color: var(--forest);
  }

  .expansion-map {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(45, 48, 71, 0.1);
  }

  .expansion-map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Merger/Unified Organization */
  .section-header.centered {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .merger-narrative {
    max-width: 1000px;
    margin: 0 auto;
  }

  .merger-timeline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .merger-year {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 2rem;
    background: white;
    border-radius: 16px;
    border: 1px solid rgba(45, 48, 71, 0.08);
  }

  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    color: var(--forest);
  }

  .year-event {
    font-size: 0.9rem;
    color: var(--navy);
    text-align: center;
  }

  .merger-arrow svg {
    width: 32px;
    height: 32px;
    color: var(--spring);
  }

  .legacy-cards {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
