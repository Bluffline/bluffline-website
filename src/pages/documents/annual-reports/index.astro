---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CallToAction from '../../../components/ui/CallToAction.astro';
import DocumentCard from '../../../components/content/DocumentCard.astro';
import EmptyStateCard from '../../../components/content/EmptyStateCard.astro';
import { getCollection } from 'astro:content';

const allDocuments = await getCollection('documents');
const annualReports = allDocuments
  .filter(doc => doc.data.documentType === 'report')
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Annual Reports"
  description="Yearly organizational updates from Bluffline, Inc. documenting our progress, financials, and impact."
>
  <PageHero
    label="Documents"
    title="Annual Reports"
    description="Each year, we publish a comprehensive report documenting our progress, financials, and impact. Transparency is one of our core values."
  />

  <section class="reports-section">
    <div class="section-inner">
      {annualReports.length > 0 ? (
        <div class="reports-grid">
          {annualReports.map(report => (
            <DocumentCard
              title={report.data.title}
              description={report.data.description || ''}
              href={report.data.file || report.data.link || '#'}
              external={true}
              year={report.data.year}
              showDownload={!!(report.data.file || report.data.link)}
            />
          ))}
        </div>
      ) : (
        <EmptyStateCard
          title="Annual Reports Coming Soon"
          description="We're preparing our annual reports for publication. Check back soon for yearly organizational updates and financial transparency."
          variant="default"
        />
      )}
    </div>
  </section>

  <CallToAction
    title="Questions about our finances?"
    description="We're committed to transparency. If you have questions about our financials or operations, we're happy to discuss."
    primaryLabel="Get in Touch"
    primaryHref="/support"
    variant="mist"
  />
</BaseLayout>

<style>
  .reports-section { background: var(--cream); padding: 5rem 0; }
  @media (min-width: 768px) { .reports-section { padding: 7rem 0; } }

  .reports-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .reports-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  @media (min-width: 1200px) {
    .reports-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
