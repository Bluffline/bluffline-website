---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';

import scenicHighwayData from '../../data/scenic-highway.json';
import planningCorridorData from '../../data/planning-corridor.json';

const page = await getEntry('pages', 'corridor');
const cd = page.data;


const resources = await getCollection('resources');

// Convert resources with coordinates to GeoJSON format
const resourcesWithCoordinates = resources.filter(r => r.data.coordinates);
const resourcesGeoJSON = {
  type: 'FeatureCollection',
  features: resourcesWithCoordinates.map(resource => ({
    type: 'Feature',
    properties: {
      name: resource.data.name,
      description: resource.data.description,
      qualities: resource.data.qualities,
    },
    geometry: {
      type: 'Point',
      coordinates: [resource.data.coordinates!.lng, resource.data.coordinates!.lat],
    },
  })),
};

const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';
---

<BaseLayout
  title="The Corridor"
  description="A scenic corridor tracing Pensacola's historic bay bluffs—connecting neighborhoods, natural areas, and cultural landmarks from NAS Pensacola to UWF."
>
  <PageHero
    label={cd.heroLabel}
    title={cd.heroTitle}
    description={cd.heroDescription}
  />

  <section class="map-section">
    <div class="map-wrapper" id="map-wrapper">
      <div id="corridor-map"></div>
      <button class="fullscreen-btn" id="fullscreen-btn" aria-label="Toggle fullscreen map">
        <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
        <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 14 10 14 10 20"></polyline>
          <polyline points="20 10 14 10 14 4"></polyline>
          <line x1="14" y1="10" x2="21" y2="3"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      </button>
      <div class="map-legend">
        <div class="legend-item">
          <div class="legend-polygon"></div>
          <span>Bluffline Planning Corridor</span>
        </div>
        <div class="legend-item">
          <div class="legend-line"></div>
          <span>Bluffline Scenic Highway</span>
        </div>
        <div class="legend-item">
          <div class="legend-point"></div>
          <span>Intrinsic Resource</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section overview-section">
    <div class="section-inner">
      <div class="overview-grid">
        <div class="overview-content">
          <h2>{cd.overviewHeading}</h2>
          <p>{cd.overviewBody1}</p>
          <p>{cd.overviewBody2}</p>
          <p>{cd.overviewBody3}</p>
        </div>
        <div class="overview-sidebar">
          <h3>{cd.sidebarTitle}</h3>
          <div class="corridor-stats">
            <div class="stat-item"><span class="stat-label">Total Length</span><span class="stat-value">{cd.statTotalLength}</span></div>
            <div class="stat-item"><span class="stat-label">Existing Scenic Highway</span><span class="stat-value">{cd.statExistingHighway}</span></div>
            <div class="stat-item"><span class="stat-label">Northeast Extension</span><span class="stat-value">{cd.statNortheastExtension}</span></div>
            <div class="stat-item"><span class="stat-label">Southwest Extension</span><span class="stat-value">{cd.statSouthwestExtension}</span></div>
            <div class="stat-item"><span class="stat-label">Intrinsic Resources</span><span class="stat-value">{cd.statIntrinsicResources}</span></div>
            <div class="stat-item"><span class="stat-label">Designation</span><span class="stat-value">{cd.statDesignation}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section greenway-section">
    <div class="section-inner">
      <div class="greenway-content">
        <h2>{cd.greenwayHeading}</h2>
        <p>{cd.greenwayBody1}</p>
        <p>{cd.greenwayBody2}</p>
        <p>{cd.greenwayBody3}</p>
      </div>
    </div>
  </section>

  <section class="section resources-section" id="resources">
    <div class="section-inner">
      <div class="section-header">
        <h2>{cd.resourcesHeading}</h2>
        <p>{cd.resourcesDescription}</p>
      </div>
      <div class="filter-controls">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="Cultural">Cultural</button>
        <button class="filter-btn" data-filter="Historical">Historical</button>
        <button class="filter-btn" data-filter="Archaeological">Archaeological</button>
        <button class="filter-btn" data-filter="Recreational">Recreational</button>
        <button class="filter-btn" data-filter="Natural">Natural</button>
        <button class="filter-btn" data-filter="Scenic">Scenic</button>
      </div>
      <div class="resources-grid" id="resources-grid">
        {resources.map((resource, index) => (
          <div
            class="resource-card"
            data-qualities={resource.data.qualities.join(',')}
            data-index={index}
          >
            <h3>{resource.data.name}</h3>
            <p>{resource.data.description}</p>
            <div class="resource-qualities">
              {resource.data.qualities.map(q => <span class="quality-tag">{q}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="show-more-container">
        <button class="show-more-btn" id="show-more-btn">
          <span class="show-more-text">Show All Resources</span>
          <span class="show-less-text" style="display: none;">Show Less</span>
        </button>
      </div>
    </div>
  </section>

  <CallToAction
    title={cd.ctaTitle}
    description={cd.ctaDescription}
    primaryLabel="View Progress"
    primaryHref="/progress"
    variant="mist"
  />
</BaseLayout>

<style>
  .map-section { background: var(--mist); padding: 0; }
  .map-wrapper {
    position: relative;
    height: 70vh;
    min-height: 450px;
    background: var(--mist);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .map-wrapper {
      height: 70vh;
      min-height: 500px;
      max-height: 700px;
    }
  }
  #corridor-map {
    width: 100%;
    height: 100%;
  }

  /* Fullscreen button */
  .fullscreen-btn {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    width: 40px;
    height: 40px;
    background: white;
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fullscreen-btn:hover {
    background: var(--mist);
    transform: scale(1.05);
  }
  .fullscreen-btn .icon-collapse {
    display: none;
  }

  /* Map legend overlay */
  .map-legend {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 10;
    display: flex;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    padding: 0.625rem 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
  @media (min-width: 768px) {
    .map-legend {
      left: auto;
      right: 12px;
      bottom: 12px;
      max-width: fit-content;
      padding: 0.75rem 1.25rem;
    }
  }
  .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--navy); white-space: nowrap; }
  .legend-polygon {
    width: 18px;
    height: 12px;
    background: rgba(65, 82, 31, 0.2);
    border: 2px solid var(--forest);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-line {
    width: 20px;
    height: 3px;
    background: var(--forest);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-point {
    width: 10px;
    height: 10px;
    background: var(--spring);
    border-radius: 50%;
    border: 2px solid var(--forest);
    flex-shrink: 0;
  }

  /* Fullscreen mode */
  .map-wrapper.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    min-height: auto;
    z-index: 9999;
    margin: 0;
  }
  .map-wrapper.fullscreen .fullscreen-btn {
    top: 20px;
    left: 20px;
  }
  .map-wrapper.fullscreen .fullscreen-btn .icon-expand {
    display: none;
  }
  .map-wrapper.fullscreen .fullscreen-btn .icon-collapse {
    display: block;
  }
  .map-wrapper.fullscreen .map-legend {
    bottom: 20px;
    left: 20px;
    right: 20px;
  }
  @media (min-width: 768px) {
    .map-wrapper.fullscreen .map-legend {
      left: auto;
      right: 20px;
    }
  }

  /* Mapbox popup styles */
  :global(.mapboxgl-popup-content) {
    padding: 1rem;
    border-radius: 8px;
    max-width: 280px;
  }
  :global(.mapboxgl-popup-content h3) {
    font-size: 1rem;
    color: var(--navy);
    margin: 0 0 0.5rem 0;
  }
  :global(.mapboxgl-popup-content p) {
    font-size: 0.875rem;
    color: var(--navy);
    opacity: 0.8;
    margin: 0 0 0.5rem 0;
  }
  :global(.mapboxgl-popup-content .qualities) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  :global(.mapboxgl-popup-content .quality) {
    font-size: 0.7rem;
    padding: 0.125rem 0.5rem;
    background: var(--mist);
    color: var(--forest);
    border-radius: 100px;
  }

  .overview-section { background: var(--warm-white); }
  .overview-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .overview-grid { grid-template-columns: 1.5fr 1fr; gap: 4rem; }
  }
  .overview-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--navy); margin-bottom: 1.5rem; }
  .overview-content p { font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }
  .overview-sidebar {
    background: var(--mist);
    border-radius: 16px;
    padding: 2rem;
  }
  .overview-sidebar h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 1.5rem; }
  .corridor-stats { display: flex; flex-direction: column; gap: 1rem; }
  .stat-item { display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(45, 48, 71, 0.1); }
  .stat-item:last-child { border-bottom: none; padding-bottom: 0; }
  .stat-label { font-size: 0.9rem; color: var(--navy); opacity: 0.7; }
  .stat-value { font-weight: 600; color: var(--forest); }

  .greenway-section { background: var(--navy); color: white; }
  .greenway-content { max-width: 800px; }
  .greenway-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-bottom: 1.5rem; }
  .greenway-content p { font-size: 1.1rem; margin-bottom: 1.25rem; opacity: 0.85; }

  .resources-section { background: var(--cream); }
  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }
  .filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--forest);
    background: transparent;
    color: var(--forest);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    background: rgba(65, 82, 31, 0.1);
  }
  .filter-btn.active {
    background: var(--forest);
    color: white;
  }
  .resources-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .resources-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .resources-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .resource-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(45, 48, 71, 0.06);
    transition: opacity 0.2s ease;
  }
  .resource-card.hidden {
    display: none;
  }
  .resource-card h3 { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.5rem; }
  .resource-card p { font-size: 0.9rem; color: var(--navy); opacity: 0.75; margin-bottom: 1rem; }
  .resource-qualities { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .quality-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--mist);
    color: var(--forest);
    border-radius: 100px;
    font-weight: 500;
  }
  .show-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .show-more-btn {
    padding: 0.75rem 2rem;
    background: var(--forest);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .show-more-btn:hover {
    background: #2d3a15;
  }
  .show-more-btn.hidden {
    display: none;
  }
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, scenicHighwayData, planningCorridorData, resourcesGeoJSON }}>
  // Load Mapbox GL JS
  const script = document.createElement('script');
  script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  script.onload = initMap;
  document.head.appendChild(script);

  function initMap() {
    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'corridor-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.46],
      zoom: 10,
    });

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');

    map.on('load', () => {
      // Add Planning Corridor (polygon) - rendered first (bottom layer)
      map.addSource('planning-corridor', {
        type: 'geojson',
        data: planningCorridorData,
      });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: {
          'fill-color': '#41521F',
          'fill-opacity': 0.15,
        },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 2,
        },
      });

      // Add Scenic Highway (polyline)
      map.addSource('scenic-highway', {
        type: 'geojson',
        data: scenicHighwayData,
      });
      map.addLayer({
        id: 'scenic-highway-line',
        type: 'line',
        source: 'scenic-highway',
        paint: {
          'line-color': '#41521F',
          'line-width': 4,
        },
      });

      // Add Intrinsic Resources (markers)
      map.addSource('resources', {
        type: 'geojson',
        data: resourcesGeoJSON,
      });
      map.addLayer({
        id: 'resources-points',
        type: 'circle',
        source: 'resources',
        paint: {
          'circle-radius': 8,
          'circle-color': '#99CC63',
          'circle-stroke-color': '#41521F',
          'circle-stroke-width': 2,
        },
      });

      // Popup on click for resources
      map.on('click', 'resources-points', (e) => {
        const feature = e.features[0];
        const { name, description, qualities } = feature.properties;
        const qualitiesArr = JSON.parse(qualities);

        const qualitiesHtml = qualitiesArr
          .map(q => `<span class="quality">${q}</span>`)
          .join('');

        new mapboxgl.Popup()
          .setLngLat(feature.geometry.coordinates)
          .setHTML(`
            <h3>${name}</h3>
            <p>${description}</p>
            <div class="qualities">${qualitiesHtml}</div>
          `)
          .addTo(map);
      });

      // Change cursor on hover
      map.on('mouseenter', 'resources-points', () => {
        map.getCanvas().style.cursor = 'pointer';
      });
      map.on('mouseleave', 'resources-points', () => {
        map.getCanvas().style.cursor = '';
      });

      // Fit map to show the entire corridor
      const bounds = new mapboxgl.LngLatBounds();

      // Add corridor polygon bounds
      planningCorridorData.features[0].geometry.coordinates[0].forEach(coord => {
        bounds.extend(coord);
      });

      map.fitBounds(bounds, { padding: 50 });

      // Fullscreen toggle functionality
      const mapWrapper = document.getElementById('map-wrapper');
      const fullscreenBtn = document.getElementById('fullscreen-btn');

      function toggleFullscreen() {
        mapWrapper.classList.toggle('fullscreen');
        document.body.style.overflow = mapWrapper.classList.contains('fullscreen') ? 'hidden' : '';

        // Resize the map after the CSS transition
        setTimeout(() => {
          map.resize();
          // Re-fit bounds when entering fullscreen for better view
          if (mapWrapper.classList.contains('fullscreen')) {
            map.fitBounds(bounds, { padding: 60 });
          } else {
            map.fitBounds(bounds, { padding: 50 });
          }
        }, 100);
      }

      fullscreenBtn.addEventListener('click', toggleFullscreen);

      // Close fullscreen on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mapWrapper.classList.contains('fullscreen')) {
          toggleFullscreen();
        }
      });
    });
  }
</script>

<script is:inline>
  // Resource filtering and show more/less functionality
  (function() {
    const INITIAL_COUNT = 6;
    let showAll = false;
    let currentFilter = 'all';

    const cards = document.querySelectorAll('.resource-card');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const showMoreBtn = document.getElementById('show-more-btn');
    const showMoreText = showMoreBtn ? showMoreBtn.querySelector('.show-more-text') : null;
    const showLessText = showMoreBtn ? showMoreBtn.querySelector('.show-less-text') : null;

    function updateVisibility() {
      let visibleCount = 0;
      let totalMatching = 0;

      cards.forEach(function(card) {
        const qualities = card.getAttribute('data-qualities');
        const qualitiesArr = qualities ? qualities.split(',') : [];
        const matchesFilter = currentFilter === 'all' || qualitiesArr.includes(currentFilter);

        if (matchesFilter) {
          totalMatching++;
          if (showAll || visibleCount < INITIAL_COUNT) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        } else {
          card.classList.add('hidden');
        }
      });

      // Update show more button
      if (showMoreBtn && showMoreText && showLessText) {
        if (totalMatching <= INITIAL_COUNT) {
          showMoreBtn.classList.add('hidden');
        } else {
          showMoreBtn.classList.remove('hidden');
          if (showAll) {
            showMoreText.style.display = 'none';
            showLessText.style.display = 'inline';
          } else {
            showMoreText.textContent = 'Show All ' + totalMatching + ' Resources';
            showMoreText.style.display = 'inline';
            showLessText.style.display = 'none';
          }
        }
      }
    }

    // Filter button click handlers
    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        showAll = false; // Reset to show initial count when changing filters
        updateVisibility();
      });
    });

    // Show more/less button handler
    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', function() {
        showAll = !showAll;
        updateVisibility();
      });
    }

    // Initial visibility
    updateVisibility();
  })();
</script>
