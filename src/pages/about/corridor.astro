---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';

import scenicHighwayData from '../../data/scenic-highway.json';
import planningCorridorData from '../../data/planning-corridor.json';

const resources = await getCollection('resources');

// Convert resources with coordinates to GeoJSON format
const resourcesWithCoordinates = resources.filter(r => r.data.coordinates);
const resourcesGeoJSON = {
  type: 'FeatureCollection',
  features: resourcesWithCoordinates.map(resource => ({
    type: 'Feature',
    properties: {
      name: resource.data.name,
      description: resource.data.description,
      qualities: resource.data.qualities,
    },
    geometry: {
      type: 'Point',
      coordinates: [resource.data.coordinates!.lng, resource.data.coordinates!.lat],
    },
  })),
};

const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';
---

<BaseLayout 
  title="The Corridor" 
  description="A 22-mile scenic corridor tracing Pensacola's historic bay bluffs—connecting neighborhoods, natural areas, and cultural landmarks."
>
  <PageHero
    label="The Corridor"
    title="From the University of West Florida to Naval Air Station Pensacola"
    description="A 22-mile scenic corridor tracing Pensacola's historic bay bluffs—connecting neighborhoods, natural areas, and cultural landmarks through a unified multimodal vision."
  />

  <section class="map-section">
    <div class="map-container">
      <div class="map-wrapper">
        <div id="corridor-map"></div>
      </div>
      <div class="map-legend">
        <div class="legend-item">
          <div class="legend-polygon"></div>
          <span>Bluffline Planning Corridor</span>
        </div>
        <div class="legend-item">
          <div class="legend-line"></div>
          <span>Bluffline Scenic Highway</span>
        </div>
        <div class="legend-item">
          <div class="legend-point"></div>
          <span>Intrinsic Resource</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section overview-section">
    <div class="section-inner">
      <div class="overview-grid">
        <div class="overview-content">
          <h2>A unified vision for Pensacola's waterfront</h2>
          <p>The Bluffline corridor follows a distinctive geological formation that has shaped the region's geography and cultural identity for centuries. While today's bluffs rise prominently along north Escambia Bay, historical mapping shows that this bluff system once continued westward through downtown Pensacola to Naval Air Station Pensacola.</p>
          <p>In 2024, the Bluffline merged with the Scenic Highway Foundation, becoming the managing organization for the Pensacola Scenic Bluffs Highway. This partnership united two complementary visions: the scenic highway's focus on preservation and interpretation with the Bluffline's mission to create safe, connected multimodal infrastructure.</p>
          <p>The corridor we envision today extends the existing scenic highway in both directions—northeast to the University of West Florida and southwest through downtown Pensacola to NAS Pensacola—restoring interpretive continuity to the full historic bluff system.</p>
        </div>
        <div class="overview-sidebar">
          <h3>Corridor at a Glance</h3>
          <div class="corridor-stats">
            <div class="stat-item"><span class="stat-label">Total Length</span><span class="stat-value">~22 miles</span></div>
            <div class="stat-item"><span class="stat-label">Existing Scenic Highway</span><span class="stat-value">~11 miles</span></div>
            <div class="stat-item"><span class="stat-label">Northeast Extension</span><span class="stat-value">~3.35 miles</span></div>
            <div class="stat-item"><span class="stat-label">Southwest Extension</span><span class="stat-value">~7.75 miles</span></div>
            <div class="stat-item"><span class="stat-label">Intrinsic Resources</span><span class="stat-value">27+ sites</span></div>
            <div class="stat-item"><span class="stat-label">Designation</span><span class="stat-value">FL Scenic Highway</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section greenway-section">
    <div class="section-inner">
      <div class="greenway-content">
        <h2>The greenway within the corridor</h2>
        <p>Within this scenic highway corridor, the Bluffline is advancing a multimodal greenway—a network of trails, protected bike lanes, and water transit connections that will provide safe, car-free access to the waterfront and the resources along it.</p>
        <p>The greenway vision utilizes abandoned rail corridors, utility rights-of-way, and existing public land to create continuous connections. Where the scenic highway provides the framework for preservation and interpretation, the greenway provides the infrastructure for access and mobility.</p>
        <p>This is transportation infrastructure that also serves as access to nature—a corridor that connects people to their environment, to economic opportunity, and to each other.</p>
      </div>
    </div>
  </section>

  <section class="section resources-section" id="resources">
    <div class="section-inner">
      <div class="section-header">
        <h2>Intrinsic resources</h2>
        <p>The corridor connects {resources.length} cultural, historical, archaeological, recreational, natural, and scenic resources across its 22-mile length.</p>
      </div>
      <div class="filter-controls">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="Cultural">Cultural</button>
        <button class="filter-btn" data-filter="Historical">Historical</button>
        <button class="filter-btn" data-filter="Archaeological">Archaeological</button>
        <button class="filter-btn" data-filter="Recreational">Recreational</button>
        <button class="filter-btn" data-filter="Natural">Natural</button>
        <button class="filter-btn" data-filter="Scenic">Scenic</button>
      </div>
      <div class="resources-grid" id="resources-grid">
        {resources.map((resource, index) => (
          <div
            class="resource-card"
            data-qualities={resource.data.qualities.join(',')}
            data-index={index}
          >
            <h3>{resource.data.name}</h3>
            <p>{resource.data.description}</p>
            <div class="resource-qualities">
              {resource.data.qualities.map(q => <span class="quality-tag">{q}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="show-more-container">
        <button class="show-more-btn" id="show-more-btn">
          <span class="show-more-text">Show All Resources</span>
          <span class="show-less-text" style="display: none;">Show Less</span>
        </button>
      </div>
    </div>
  </section>

  <CallToAction
    title="See our progress"
    description="From federal grants to community engagement—track how the Bluffline is moving from vision to reality."
    primaryLabel="View Progress"
    primaryHref="/progress"
    variant="mist"
  />
</BaseLayout>

<style>
  .map-section { background: var(--cream); padding: 0; }
  .map-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  @media (min-width: 768px) {
    .map-container { padding: 5rem 3rem; }
  }
  .map-wrapper {
    aspect-ratio: 16/9;
    background: var(--mist);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  #corridor-map {
    width: 100%;
    height: 100%;
  }
  .map-legend {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--navy); }
  .legend-polygon {
    width: 20px;
    height: 14px;
    background: rgba(65, 82, 31, 0.2);
    border: 2px solid var(--forest);
    border-radius: 2px;
  }
  .legend-line {
    width: 24px;
    height: 3px;
    background: var(--forest);
    border-radius: 2px;
  }
  .legend-point {
    width: 12px;
    height: 12px;
    background: var(--spring);
    border-radius: 50%;
    border: 2px solid var(--forest);
  }

  /* Mapbox popup styles */
  :global(.mapboxgl-popup-content) {
    padding: 1rem;
    border-radius: 8px;
    max-width: 280px;
  }
  :global(.mapboxgl-popup-content h3) {
    font-size: 1rem;
    color: var(--navy);
    margin: 0 0 0.5rem 0;
  }
  :global(.mapboxgl-popup-content p) {
    font-size: 0.875rem;
    color: var(--navy);
    opacity: 0.8;
    margin: 0 0 0.5rem 0;
  }
  :global(.mapboxgl-popup-content .qualities) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  :global(.mapboxgl-popup-content .quality) {
    font-size: 0.7rem;
    padding: 0.125rem 0.5rem;
    background: var(--mist);
    color: var(--forest);
    border-radius: 100px;
  }

  .overview-section { background: var(--warm-white); }
  .overview-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .overview-grid { grid-template-columns: 1.5fr 1fr; gap: 4rem; }
  }
  .overview-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--navy); margin-bottom: 1.5rem; }
  .overview-content p { font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }
  .overview-sidebar {
    background: var(--mist);
    border-radius: 16px;
    padding: 2rem;
  }
  .overview-sidebar h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 1.5rem; }
  .corridor-stats { display: flex; flex-direction: column; gap: 1rem; }
  .stat-item { display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(45, 48, 71, 0.1); }
  .stat-item:last-child { border-bottom: none; padding-bottom: 0; }
  .stat-label { font-size: 0.9rem; color: var(--navy); opacity: 0.7; }
  .stat-value { font-weight: 600; color: var(--forest); }

  .greenway-section { background: var(--navy); color: white; }
  .greenway-content { max-width: 800px; }
  .greenway-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-bottom: 1.5rem; }
  .greenway-content p { font-size: 1.1rem; margin-bottom: 1.25rem; opacity: 0.85; }

  .resources-section { background: var(--cream); }
  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }
  .filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--forest);
    background: transparent;
    color: var(--forest);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    background: rgba(65, 82, 31, 0.1);
  }
  .filter-btn.active {
    background: var(--forest);
    color: white;
  }
  .resources-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .resources-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .resources-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .resource-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(45, 48, 71, 0.06);
    transition: opacity 0.2s ease;
  }
  .resource-card.hidden {
    display: none;
  }
  .resource-card h3 { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.5rem; }
  .resource-card p { font-size: 0.9rem; color: var(--navy); opacity: 0.75; margin-bottom: 1rem; }
  .resource-qualities { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .quality-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--mist);
    color: var(--forest);
    border-radius: 100px;
    font-weight: 500;
  }
  .show-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .show-more-btn {
    padding: 0.75rem 2rem;
    background: var(--forest);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .show-more-btn:hover {
    background: #2d3a15;
  }
  .show-more-btn.hidden {
    display: none;
  }
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, scenicHighwayData, planningCorridorData, resourcesGeoJSON }}>
  // Load Mapbox GL JS
  const script = document.createElement('script');
  script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  script.onload = initMap;
  document.head.appendChild(script);

  function initMap() {
    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'corridor-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.46],
      zoom: 10,
    });

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');

    map.on('load', () => {
      // Add Planning Corridor (polygon) - rendered first (bottom layer)
      map.addSource('planning-corridor', {
        type: 'geojson',
        data: planningCorridorData,
      });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: {
          'fill-color': '#41521F',
          'fill-opacity': 0.15,
        },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 2,
        },
      });

      // Add Scenic Highway (polyline)
      map.addSource('scenic-highway', {
        type: 'geojson',
        data: scenicHighwayData,
      });
      map.addLayer({
        id: 'scenic-highway-line',
        type: 'line',
        source: 'scenic-highway',
        paint: {
          'line-color': '#41521F',
          'line-width': 4,
        },
      });

      // Add Intrinsic Resources (markers)
      map.addSource('resources', {
        type: 'geojson',
        data: resourcesGeoJSON,
      });
      map.addLayer({
        id: 'resources-points',
        type: 'circle',
        source: 'resources',
        paint: {
          'circle-radius': 8,
          'circle-color': '#99CC63',
          'circle-stroke-color': '#41521F',
          'circle-stroke-width': 2,
        },
      });

      // Popup on click for resources
      map.on('click', 'resources-points', (e) => {
        const feature = e.features[0];
        const { name, description, qualities } = feature.properties;
        const qualitiesArr = JSON.parse(qualities);

        const qualitiesHtml = qualitiesArr
          .map(q => `<span class="quality">${q}</span>`)
          .join('');

        new mapboxgl.Popup()
          .setLngLat(feature.geometry.coordinates)
          .setHTML(`
            <h3>${name}</h3>
            <p>${description}</p>
            <div class="qualities">${qualitiesHtml}</div>
          `)
          .addTo(map);
      });

      // Change cursor on hover
      map.on('mouseenter', 'resources-points', () => {
        map.getCanvas().style.cursor = 'pointer';
      });
      map.on('mouseleave', 'resources-points', () => {
        map.getCanvas().style.cursor = '';
      });

      // Fit map to show the entire corridor
      const bounds = new mapboxgl.LngLatBounds();

      // Add corridor polygon bounds
      planningCorridorData.features[0].geometry.coordinates[0].forEach(coord => {
        bounds.extend(coord);
      });

      map.fitBounds(bounds, { padding: 50 });
    });
  }
</script>

<script is:inline>
  // Resource filtering and show more/less functionality
  (function() {
    const INITIAL_COUNT = 6;
    let showAll = false;
    let currentFilter = 'all';

    const cards = document.querySelectorAll('.resource-card');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const showMoreBtn = document.getElementById('show-more-btn');
    const showMoreText = showMoreBtn ? showMoreBtn.querySelector('.show-more-text') : null;
    const showLessText = showMoreBtn ? showMoreBtn.querySelector('.show-less-text') : null;

    function updateVisibility() {
      let visibleCount = 0;
      let totalMatching = 0;

      cards.forEach(function(card) {
        const qualities = card.getAttribute('data-qualities');
        const qualitiesArr = qualities ? qualities.split(',') : [];
        const matchesFilter = currentFilter === 'all' || qualitiesArr.includes(currentFilter);

        if (matchesFilter) {
          totalMatching++;
          if (showAll || visibleCount < INITIAL_COUNT) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        } else {
          card.classList.add('hidden');
        }
      });

      // Update show more button
      if (showMoreBtn && showMoreText && showLessText) {
        if (totalMatching <= INITIAL_COUNT) {
          showMoreBtn.classList.add('hidden');
        } else {
          showMoreBtn.classList.remove('hidden');
          if (showAll) {
            showMoreText.style.display = 'none';
            showLessText.style.display = 'inline';
          } else {
            showMoreText.textContent = 'Show All ' + totalMatching + ' Resources';
            showMoreText.style.display = 'inline';
            showLessText.style.display = 'none';
          }
        }
      }
    }

    // Filter button click handlers
    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        showAll = false; // Reset to show initial count when changing filters
        updateVisibility();
      });
    });

    // Show more/less button handler
    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', function() {
        showAll = !showAll;
        updateVisibility();
      });
    }

    // Initial visibility
    updateVisibility();
  })();
</script>
