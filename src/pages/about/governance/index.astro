---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import BoardMemberCard from '../../../components/content/BoardMemberCard.astro';
import DocumentCard from '../../../components/content/DocumentCard.astro';
import CallToAction from '../../../components/ui/CallToAction.astro';

const page = await getEntry('pages', 'governance');
const d = page.data;

const boardMembers = await getCollection('board-members');
// Sort alphabetically by last name, ignoring credential suffixes (e.g. ", PE, PMP", ", MD")
const lastName = (name: string) => {
  const parts = name.split(',')[0].trim().split(/\s+/);
  return parts[parts.length - 1];
};
const sortedBoardMembers = boardMembers.sort((a, b) =>
  lastName(a.data.name).localeCompare(lastName(b.data.name))
);
const activeMembers = sortedBoardMembers.filter(m => m.data.role !== 'emeritus' && !m.data.archived);
const emeritusMembers = sortedBoardMembers.filter(m => m.data.role === 'emeritus' && !m.data.archived);

const committees = [
  {
    name: 'Corridor Management Committee',
    description: 'Serves as the Corridor Management Entity for the Pensacola Scenic Bluffs Scenic Highway under the Florida Scenic Highways Program.',
    href: '/about/governance/corridor-management',
  },
];

const documents = [
  {
    title: 'IRS Determination Letter',
    description: '501(c)(3) status',
    href: '/documents/bluffline-irs-determination-letter.pdf',
    external: true,
  },
  {
    title: 'Annual Reports',
    description: 'Yearly organizational updates',
    href: '/documents/annual-reports',
    external: false,
  },
  {
    title: 'GuideStar Profile',
    description: 'Verified nonprofit',
    href: 'https://www.guidestar.org/profile/shared/c5cc3f03-5a18-4f14-89f3-4b194e00c2de',
    external: true,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  },
];
---

<BaseLayout
  title="Governance"
  description="Board, committees, and organizational transparency for Bluffline, Inc."
>
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    heroImage="/images/aerial/escambia-bay-bluffs-aerial-2024.jpg"
    heroImageAlt="Aerial view of the Pensacola Bay bluffs and waterfront corridor"
    keywords={["board", "governance", "transparency"]}
  />

  <section class="section leadership-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>{d.leadershipHeading}</h2>
        <p>{d.leadershipDescription}</p>
      </div>
      <div class="leadership-grid">
        {activeMembers.map((member) => (
          <BoardMemberCard
            name={member.data.name}
            title={member.data.title}
            role={member.data.role}
            bio={member.data.bio}
            photo={member.data.photo}
          />
        ))}
      </div>

      {emeritusMembers.length > 0 && (
        <div class="emeritus-section">
          <div class="emeritus-header">
            <h3>{d.emeritusHeading}</h3>
            <p>{d.emeritusDescription}</p>
          </div>
          <div class="emeritus-grid">
            {emeritusMembers.map((member) => (
              <BoardMemberCard
                name={member.data.name}
                title={member.data.title}
                role={member.data.role}
                bio={member.data.bio}
                photo={member.data.photo}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section committees-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>{d.committeesHeading}</h2>
        <p>{d.committeesDescription}</p>
      </div>
      <div class="committees-list">
        {committees.map(committee => (
          <a href={committee.href} class="committee-card">
            <div class="committee-card-content">
              <h3>{committee.name}</h3>
              <p>{committee.description}</p>
            </div>
            <svg class="committee-card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section documents-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>{d.documentsHeading}</h2>
        <p>{d.documentsDescription}</p>
      </div>
      <div class="documents-grid">
        {documents.map(doc => (
          <DocumentCard
            title={doc.title}
            description={doc.description}
            href={doc.href}
            external={doc.external}
            icon={doc.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="View the Corridor"
    primaryHref="/about/corridor"
  />
</BaseLayout>

<style>
  /* Leadership Section */
  .leadership-section { background: var(--cream); }
  .leadership-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .leadership-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .leadership-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  /* Emeritus Section */
  .emeritus-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(45, 48, 71, 0.1);
  }
  .emeritus-header { margin-bottom: 2rem; }
  .emeritus-header h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .emeritus-header p { font-size: 1rem; color: var(--navy); opacity: 0.7; }
  .emeritus-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .emeritus-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .emeritus-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Committees Section */
  .committees-section { background: var(--warm-white); }
  .committees-list { display: flex; flex-direction: column; gap: 1rem; max-width: 800px; }
  .committee-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: white;
    border: 1px solid rgba(45, 48, 71, 0.1);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .committee-card:hover {
    box-shadow: 0 4px 20px rgba(45, 48, 71, 0.1);
    border-color: rgba(45, 48, 71, 0.2);
  }
  .committee-card-content { flex: 1; }
  .committee-card-content h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }
  .committee-card-content p { font-size: 0.95rem; color: var(--navy); opacity: 0.7; margin: 0; }
  .committee-card-arrow { width: 20px; height: 20px; color: var(--forest); flex-shrink: 0; }

  /* Documents Section */
  .documents-section { background: var(--mist); }
  .documents-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .documents-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  }
</style>
