---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import IconCard from '../../components/content/IconCard.astro';
import { getEntry } from 'astro:content';

import planningCorridorData from '../../data/planning-corridor.json';
import crashIncidentsData from '../../data/crash-incidents.json';

const page = await getEntry('pages', 'impact');
const d = page.data;


const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';

// SVG icons for pillar cards (not editable content, kept in template)
const pillarIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>`,
];

// SVG icons for quality of life cards (not editable content, kept in template)
const qualityIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`,
];
---

<BaseLayout
  title="Impact"
  description={d.heroDescription}
>
  <!-- TODO: Swap hero photo when final assets are provided -->
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    heroImage="/images/events/corridor-team-walk-tracks.jpg"
    heroImageAlt="Community members walking the Bluffline corridor along the bay"
    keywords={["community"]}
  />

  <!-- Safety & Access Section -->
  <section class="section safety-section" id="safety">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">{d.safetyLabel}</span>
        <h2>{d.safetyHeading}</h2>
        <p>{d.safetyBody}</p>
      </div>

      <div class="stats-row">
        {d.safetyStats.map((stat: any) => (
          <IconCard
            statHighlight={stat.value}
            description={stat.description}
            sourceUrl={stat.sourceUrl}
            sourceLabel={stat.sourceLabel}
            variant="stat"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Safety Map Section -->
  <section class="map-section">
    <div class="map-wrapper" id="safety-map-wrapper">
      <div id="safety-map"></div>
      <div class="map-controls">
        <button class="map-control-btn" id="fullscreen-btn" aria-label="Toggle fullscreen map">
          <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>
        <button class="map-control-btn view-toggle" id="view-toggle-btn" aria-label="Toggle map view">
          <svg class="icon-points" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <circle cx="19" cy="5" r="2"></circle>
            <circle cx="5" cy="19" r="2"></circle>
            <circle cx="5" cy="5" r="2"></circle>
            <circle cx="19" cy="19" r="2"></circle>
          </svg>
          <svg class="icon-heatmap" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" opacity="0.3"></circle>
            <circle cx="12" cy="12" r="6" opacity="0.5"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          <span class="toggle-label">Show Points</span>
        </button>
      </div>
      <div class="map-legend" id="map-legend">
        <div class="legend-content">
          <div class="legend-item">
            <div class="legend-polygon"></div>
            <span>Bluffline Corridor</span>
          </div>
          <div class="legend-heatmap">
            <div class="legend-item legend-heatmap-item">
              <div class="legend-heatmap-block">
                <div class="legend-heatmap-gradient"></div>
                <div class="legend-heatmap-labels">
                  <span>Low</span>
                  <span>High</span>
                </div>
              </div>
              <span>Crash Density</span>
            </div>
          </div>
          <div class="legend-points" style="display: none;">
            <div class="legend-item">
              <div class="legend-fatal"></div>
              <span>Fatality</span>
            </div>
            <div class="legend-item">
              <div class="legend-serious"></div>
              <span>Serious Injury</span>
            </div>
            <div class="legend-item">
              <div class="legend-injury"></div>
              <span>Injury</span>
            </div>
            <div class="legend-divider"></div>
            <div class="legend-item">
              <div class="legend-shape-circle"></div>
              <span>Pedestrian</span>
            </div>
            <div class="legend-item">
              <div class="legend-shape-square"></div>
              <span>Cyclist</span>
            </div>
          </div>
        </div>
        <button class="legend-toggle" aria-label="Toggle map legend" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </button>
      </div>
    </div>
    <div class="map-context">
      <p class="map-caption">{d.mapCaption}</p>
      <p class="map-source">Data: <a href={d.mapSourceUrl} target="_blank" rel="noopener">{d.mapSourceText}</a>, <span>{d.mapSourceAgency}</span></p>
    </div>
  </section>

  <!-- Safety Context Section -->
  <section class="section context-section">
    <div class="section-inner">
      <div class="context-grid">
        <div class="context-content">
          <h3>{d.contextProblemHeading}</h3>
          <p>{d.contextProblemBody1}</p>
          <p>{d.contextProblemBody2}</p>
          <p>{d.contextProblemBody3}</p>
        </div>
        <div class="context-content">
          <h3>{d.contextSolutionHeading}</h3>
          <p>{d.contextSolutionBody1}</p>
          <p>{d.contextSolutionBody2}</p>
          <p>{d.contextSolutionBody3}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Economic Development Section -->
  <section class="section economic-section" id="economic">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label">{d.economicLabel}</span>
        <h2>{d.economicHeading}</h2>
        <p>{d.economicBody}</p>
      </div>

      <div class="research-highlight">
        {d.researchHighlights.map((stat: any) => (
          <IconCard
            statHighlight={stat.value}
            description={stat.description}
            sourceUrl={stat.sourceUrl}
            sourceLabel={stat.sourceLabel}
            variant="stat-highlight"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Economic Pillars Section -->
  <section class="section pillars-section">
    <div class="section-inner">
      <div class="pillars-grid">
        {d.pillarCards.map((card: any, i: number) => (
          <IconCard
            icon={pillarIcons[i]}
            title={card.title}
            description={card.description}
            stats={card.stats}
            detail={card.detail}
            variant="pillar"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Research Evidence Section -->
  <section class="section evidence-section">
    <div class="section-inner">
      <div class="evidence-header">
        <h2>{d.evidenceHeading}</h2>
        <p>{d.evidenceBody}</p>
      </div>
      <div class="evidence-grid">
        {d.evidenceCards.map((card: any) => (
          <IconCard
            title={card.title}
            location={card.location}
            stats={card.stats}
            sourceUrl={card.sourceUrl}
            sourceLabel={card.sourceLabel}
            variant="evidence"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Quality of Life Section -->
  <section class="section quality-section" id="quality">
    <div class="section-inner">
      <div class="section-header light">
        <span class="section-label light">{d.qualityLabel}</span>
        <h2>{d.qualityHeading}</h2>
        <p>{d.qualityBody}</p>
      </div>

      <div class="quality-grid">
        {d.qualityCards.map((card: any, i: number) => (
          <IconCard
            icon={qualityIcons[i]}
            title={card.title}
            description={card.description}
            sourceUrl={card.sourceUrl}
            sourceLabel={card.sourceLabel}
            variant="dark"
          />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="Get Involved"
    primaryHref="/support"
    secondaryLabel="See Our Progress"
    secondaryHref="/progress"
    variant="forest"
  />
</BaseLayout>

<style>
  /* Section styling */
  .section {
    padding: 5rem 0;
  }
  @media (min-width: 768px) {
    .section { padding: 6rem 0; }
  }
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3rem;
  }
  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .section-header p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.8;
  }
  .section-header.light h2,
  .section-header.light p {
    color: white;
  }
  .section-header.light p {
    opacity: 0.85;
  }
  .section-label {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--forest);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .section-label.light {
    color: var(--spring);
  }

  /* Safety Section */
  .safety-section {
    background: var(--cream);
  }
  .stats-row {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .stats-row { grid-template-columns: repeat(4, 1fr); }
  }

  /* Map Section */
  .map-section { background: var(--mist); padding: 0; }
  .map-wrapper {
    position: relative;
    height: 60vh;
    min-height: 400px;
    background: var(--mist);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .map-wrapper {
      height: 65vh;
      min-height: 450px;
      max-height: 600px;
    }
  }
  #safety-map {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  :global(.map-gesture-overlay) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 48, 71, 0.45);
    color: white;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 5;
    border-radius: inherit;
  }
  :global(.map-gesture-overlay.visible) {
    opacity: 1;
  }

  .map-controls {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    gap: 8px;
  }
  .map-control-btn {
    width: 40px;
    height: 40px;
    background: white;
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .map-control-btn:hover {
    background: var(--mist);
    transform: scale(1.05);
  }
  .map-control-btn .icon-collapse,
  .map-control-btn .icon-heatmap {
    display: none;
  }
  .map-control-btn.view-toggle {
    width: auto;
    padding: 0 12px;
    gap: 6px;
  }
  .map-control-btn.view-toggle .toggle-label {
    font-size: 0.75rem;
    font-weight: 500;
  }
  @media (max-width: 480px) {
    .map-control-btn.view-toggle .toggle-label {
      display: none;
    }
    .map-control-btn.view-toggle {
      width: 40px;
      padding: 0;
    }
  }

  /* Legend container — column layout, bottom-right, same pattern as CorridorMap */
  .map-legend {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  /* Info toggle button — visible only on mobile */
  .legend-toggle {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .legend-toggle:hover { background: var(--mist); transform: scale(1.05); }

  /* Legend content panel — hidden on mobile until toggled */
  .legend-content {
    display: none;
    flex-direction: column;
    gap: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 0.625rem 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    flex-wrap: wrap;
  }
  .map-legend.legend-open .legend-content { display: flex; }

  /* Desktop: always show full legend, hide the toggle button */
  @media (min-width: 768px) {
    .map-legend {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      max-width: fit-content;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }
    .legend-toggle { display: none; }
    .legend-content {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      background: none;
      backdrop-filter: none;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
    }
  }

  .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--navy); white-space: nowrap; }
  .legend-polygon {
    width: 16px;
    height: 10px;
    background: rgba(65, 82, 31, 0.15);
    border: 1.5px dashed var(--forest);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-fatal {
    width: 14px;
    height: 14px;
    background: #dc2626;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-serious {
    width: 12px;
    height: 12px;
    background: #f97316;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-injury {
    width: 10px;
    height: 10px;
    background: #eab308;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-divider {
    width: 1px;
    height: 16px;
    background: var(--navy);
    opacity: 0.2;
    margin: 0 0.25rem;
  }
  .legend-shape-circle {
    width: 10px;
    height: 10px;
    background: #888;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .legend-shape-square {
    width: 10px;
    height: 10px;
    background: #888;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .legend-heatmap,
  .legend-points {
    display: contents;
  }
  .legend-heatmap-item {
    flex-direction: row;
    align-items: center;
  }
  .legend-heatmap-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .legend-heatmap-gradient {
    width: 60px;
    height: 10px;
    background: linear-gradient(to right,
      rgba(0, 255, 0, 0.4),
      rgba(255, 255, 0, 0.6),
      rgba(255, 165, 0, 0.8),
      rgba(255, 0, 0, 1)
    );
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-heatmap-labels {
    display: flex;
    justify-content: space-between;
    width: 60px;
    font-size: 0.6rem;
    color: var(--navy);
    opacity: 0.6;
    line-height: 1;
  }

  .map-wrapper.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    min-height: auto;
    z-index: 9999;
    margin: 0;
  }
  .map-wrapper.fullscreen .map-controls {
    top: 20px;
    left: 20px;
  }
  .map-wrapper.fullscreen #fullscreen-btn .icon-expand {
    display: none;
  }
  .map-wrapper.fullscreen #fullscreen-btn .icon-collapse {
    display: block;
  }
  .map-wrapper.fullscreen .map-legend {
    bottom: 20px;
    right: 20px;
  }

  .map-context {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .map-context { padding: 2rem 3rem; }
  }
  .map-caption {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.8;
    max-width: 700px;
    margin: 0 auto 0.5rem;
  }
  .map-source {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.6;
  }

  /* Mapbox popup styles */
  :global(.mapboxgl-popup-content) {
    padding: 0.875rem 1rem;
    border-radius: 8px;
    max-width: 260px;
  }
  :global(.mapboxgl-popup-content .popup-type) {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  :global(.mapboxgl-popup-content .popup-type.fatal) {
    background: #fef2f2;
    color: #dc2626;
  }
  :global(.mapboxgl-popup-content .popup-type.serious) {
    background: #fff7ed;
