---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import IconCard from '../../components/content/IconCard.astro';
import { getEntry } from 'astro:content';

import planningCorridorData from '../../data/planning-corridor.json';
import crashIncidentsData from '../../data/crash-incidents.json';

const page = await getEntry('pages', 'impact');
const d = page.data;
const sbId = 'src/content/pages/impact.json';

const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';

// Split rich text bodies into paragraphs
const contextProblemParagraphs: string[] = (d.contextProblemBody || '').split('\n\n').filter(Boolean);
const contextSolutionParagraphs: string[] = (d.contextSolutionBody || '').split('\n\n').filter(Boolean);
---

<BaseLayout
  title="Impact"
  description={d.heroDescription}
>
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    sbObjectId={sbId}
    labelFieldPath="heroLabel"
    titleFieldPath="heroTitle"
    descriptionFieldPath="heroDescription"
  />

  <!-- Safety & Access Section -->
  <section class="section safety-section" id="safety" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label" data-sb-field-path="safetyLabel">{d.safetyLabel}</span>
        <h2 data-sb-field-path="safetyHeading">{d.safetyHeading}</h2>
        <p data-sb-field-path="safetyBody">{d.safetyBody}</p>
      </div>

      <div class="stats-row" data-sb-field-path="safetyStats">
        {d.safetyStats?.map((stat: any, i: number) => (
          <div data-sb-field-path={`.${i}`}>
            <IconCard
              statHighlight={stat.value}
              description={stat.description}
              sourceUrl={stat.sourceUrl}
              sourceLabel={stat.sourceLabel}
              variant="stat"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Safety Map Section -->
  <section class="map-section" data-sb-object-id={sbId}>
    <div class="map-wrapper" id="safety-map-wrapper">
      <div id="safety-map"></div>
      <div class="map-controls">
        <button class="map-control-btn" id="fullscreen-btn" aria-label="Toggle fullscreen map">
          <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>
        <button class="map-control-btn view-toggle" id="view-toggle-btn" aria-label="Toggle map view">
          <svg class="icon-points" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <circle cx="19" cy="5" r="2"></circle>
            <circle cx="5" cy="19" r="2"></circle>
            <circle cx="5" cy="5" r="2"></circle>
            <circle cx="19" cy="19" r="2"></circle>
          </svg>
          <svg class="icon-heatmap" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" opacity="0.3"></circle>
            <circle cx="12" cy="12" r="6" opacity="0.5"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          <span class="toggle-label">Show Points</span>
        </button>
      </div>
      <div class="map-legend" id="map-legend">
        <div class="legend-item">
          <div class="legend-polygon"></div>
          <span>Bluffline Corridor</span>
        </div>
        <div class="legend-heatmap">
          <div class="legend-item legend-heatmap-item">
            <div class="legend-heatmap-block">
              <div class="legend-heatmap-gradient"></div>
              <div class="legend-heatmap-labels">
                <span>Low</span>
                <span>High</span>
              </div>
            </div>
            <span>Crash Density</span>
          </div>
        </div>
        <div class="legend-points" style="display: none;">
          <div class="legend-item">
            <div class="legend-fatal"></div>
            <span>Fatality</span>
          </div>
          <div class="legend-item">
            <div class="legend-serious"></div>
            <span>Serious Injury</span>
          </div>
          <div class="legend-item">
            <div class="legend-injury"></div>
            <span>Injury</span>
          </div>
          <div class="legend-divider"></div>
          <div class="legend-item">
            <div class="legend-shape-circle"></div>
            <span>Pedestrian</span>
          </div>
          <div class="legend-item">
            <div class="legend-shape-square"></div>
            <span>Cyclist</span>
          </div>
        </div>
      </div>
    </div>
    <div class="map-context">
      <p class="map-caption" data-sb-field-path="mapCaption">{d.mapCaption}</p>
      <p class="map-source">Data: <a href={d.mapSourceUrl} target="_blank" rel="noopener" data-sb-field-path="mapSourceText">{d.mapSourceText}</a>, <span data-sb-field-path="mapSourceAgency">{d.mapSourceAgency}</span></p>
    </div>
  </section>

  <!-- Safety Context Section -->
  <section class="section context-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="context-grid">
        <div class="context-content">
          <h3 data-sb-field-path="contextProblemHeading">{d.contextProblemHeading}</h3>
          <div data-sb-field-path="contextProblemBody">
            {contextProblemParagraphs.map((p: string) => <p>{p}</p>)}
          </div>
        </div>
        <div class="context-content">
          <h3 data-sb-field-path="contextSolutionHeading">{d.contextSolutionHeading}</h3>
          <div data-sb-field-path="contextSolutionBody">
            {contextSolutionParagraphs.map((p: string) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Economic Development Section -->
  <section class="section economic-section" id="economic" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <span class="section-label" data-sb-field-path="economicLabel">{d.economicLabel}</span>
        <h2 data-sb-field-path="economicHeading">{d.economicHeading}</h2>
        <p data-sb-field-path="economicBody">{d.economicBody}</p>
      </div>

      <div class="research-highlight" data-sb-field-path="researchHighlights">
        {d.researchHighlights?.map((stat: any, i: number) => (
          <div data-sb-field-path={`.${i}`}>
            <IconCard
              statHighlight={stat.value}
              description={stat.description}
              sourceUrl={stat.sourceUrl}
              sourceLabel={stat.sourceLabel}
              variant="stat-highlight"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Economic Pillars Section -->
  <section class="section pillars-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="pillars-grid" data-sb-field-path="pillarCards">
        {d.pillarCards?.map((card: any, i: number) => (
          <div data-sb-field-path={`.${i}`}>
            <IconCard
              icon={card.icon}
              title={card.title}
              description={card.description}
              stats={card.stats}
              detail={card.detail}
              variant="pillar"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Evidence Section -->
  <section class="section evidence-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="evidence-header">
        <h2 data-sb-field-path="evidenceHeading">{d.evidenceHeading}</h2>
        <p data-sb-field-path="evidenceBody">{d.evidenceBody}</p>
      </div>
      <div class="evidence-grid" data-sb-field-path="evidenceCards">
        {d.evidenceCards?.map((card: any, i: number) => (
          <div data-sb-field-path={`.${i}`}>
            <IconCard
              title={card.title}
              location={card.location}
              stats={card.stats}
              sourceUrl={card.sourceUrl}
              sourceLabel={card.sourceLabel}
              variant="evidence"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality of Life Section -->
  <section class="section quality-section" id="quality" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header light">
        <span class="section-label light" data-sb-field-path="qualityLabel">{d.qualityLabel}</span>
        <h2 data-sb-field-path="qualityHeading">{d.qualityHeading}</h2>
        <p data-sb-field-path="qualityBody">{d.qualityBody}</p>
      </div>

      <div class="quality-grid" data-sb-field-path="qualityCards">
        {d.qualityCards?.map((card: any, i: number) => (
          <div data-sb-field-path={`.${i}`}>
            <IconCard
              icon={card.icon}
              title={card.title}
              description={card.description}
              sourceUrl={card.sourceUrl}
              sourceLabel={card.sourceLabel}
              variant="dark"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="Get Involved"
    primaryHref="/support"
    secondaryLabel="See Our Progress"
    secondaryHref="/progress"
    variant="forest"
    sbObjectId={sbId}
    titleFieldPath="ctaTitle"
    descriptionFieldPath="ctaDescription"
  />
</BaseLayout>

<style>
  /* Section styling */
  .section {
    padding: 5rem 0;
  }
  @media (min-width: 768px) {
    .section { padding: 6rem 0; }
  }
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3rem;
  }
  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .section-header p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.8;
  }
  .section-header.light h2,
  .section-header.light p {
    color: white;
  }
  .section-header.light p {
    opacity: 0.85;
  }
  .section-label {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--forest);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .section-label.light {
    color: var(--spring);
  }

  /* Safety Section */
  .safety-section {
    background: var(--warm-white);
  }
  .stats-row {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .stats-row { grid-template-columns: repeat(4, 1fr); }
  }

  /* Map Section */
  .map-section { background: var(--mist); padding: 0; }
  .map-wrapper {
    position: relative;
    height: 60vh;
    min-height: 400px;
    background: var(--mist);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .map-wrapper {
      height: 65vh;
      min-height: 450px;
      max-height: 600px;
    }
  }
  #safety-map {
    width: 100%;
    height: 100%;
  }

  .map-controls {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    gap: 8px;
  }
  .map-control-btn {
    width: 40px;
    height: 40px;
    background: white;
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .map-control-btn:hover {
    background: var(--mist);
    transform: scale(1.05);
  }
  .map-control-btn .icon-collapse,
  .map-control-btn .icon-heatmap {
    display: none;
  }
  .map-control-btn.view-toggle {
    width: auto;
    padding: 0 12px;
    gap: 6px;
  }
  .map-control-btn.view-toggle .toggle-label {
    font-size: 0.75rem;
    font-weight: 500;
  }
  @media (max-width: 480px) {
    .map-control-btn.view-toggle .toggle-label {
      display: none;
    }
    .map-control-btn.view-toggle {
      width: 40px;
      padding: 0;
    }
  }

  .map-legend {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 10;
    display: flex;
    gap: 0.5rem 1rem;
    justify-content: center;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 0.625rem 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
  @media (min-width: 768px) {
    .map-legend {
      left: auto;
      right: 12px;
      bottom: 12px;
      max-width: fit-content;
      padding: 0.75rem 1.25rem;
    }
  }
  .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--navy); white-space: nowrap; }
  .legend-polygon {
    width: 16px;
    height: 10px;
    background: rgba(65, 82, 31, 0.2);
    border: 2px solid var(--forest);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-fatal {
    width: 14px;
    height: 14px;
    background: #dc2626;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-serious {
    width: 12px;
    height: 12px;
    background: #f97316;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-injury {
    width: 10px;
    height: 10px;
    background: #eab308;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .legend-divider {
    width: 1px;
    height: 16px;
    background: var(--navy);
    opacity: 0.2;
    margin: 0 0.25rem;
  }
  .legend-shape-circle {
    width: 10px;
    height: 10px;
    background: #888;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .legend-shape-square {
    width: 10px;
    height: 10px;
    background: #888;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .legend-heatmap,
  .legend-points {
    display: contents;
  }
  .legend-heatmap-item {
    flex-direction: row;
    align-items: center;
  }
  .legend-heatmap-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .legend-heatmap-gradient {
    width: 60px;
    height: 10px;
    background: linear-gradient(to right,
      rgba(0, 255, 0, 0.4),
      rgba(255, 255, 0, 0.6),
      rgba(255, 165, 0, 0.8),
      rgba(255, 0, 0, 1)
    );
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-heatmap-labels {
    display: flex;
    justify-content: space-between;
    width: 60px;
    font-size: 0.6rem;
    color: var(--navy);
    opacity: 0.6;
    line-height: 1;
  }

  .map-wrapper.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    min-height: auto;
    z-index: 9999;
    margin: 0;
  }
  .map-wrapper.fullscreen .map-controls {
    top: 20px;
    left: 20px;
  }
  .map-wrapper.fullscreen #fullscreen-btn .icon-expand {
    display: none;
  }
  .map-wrapper.fullscreen #fullscreen-btn .icon-collapse {
    display: block;
  }
  .map-wrapper.fullscreen .map-legend {
    bottom: 20px;
    left: 20px;
    right: 20px;
  }
  @media (min-width: 768px) {
    .map-wrapper.fullscreen .map-legend {
      left: auto;
      right: 20px;
    }
  }

  .map-context {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .map-context { padding: 2rem 3rem; }
  }
  .map-caption {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.8;
    max-width: 700px;
    margin: 0 auto 0.5rem;
  }
  .map-source {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.6;
  }

  /* Mapbox popup styles */
  :global(.mapboxgl-popup-content) {
    padding: 0.875rem 1rem;
    border-radius: 8px;
    max-width: 260px;
  }
  :global(.mapboxgl-popup-content .popup-type) {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  :global(.mapboxgl-popup-content .popup-type.fatal) {
    background: #fef2f2;
    color: #dc2626;
  }
  :global(.mapboxgl-popup-content .popup-type.serious) {
    background: #fff7ed;
    color: #c2410c;
  }
  :global(.mapboxgl-popup-content .popup-type.injury),
  :global(.mapboxgl-popup-content .popup-type.minor) {
    background: #fefce8;
    color: #a16207;
  }
  :global(.mapboxgl-popup-content .popup-details) {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.8;
    margin: 0.5rem 0 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  :global(.mapboxgl-popup-content .popup-details span) {
    display: block;
    margin-bottom: 0.15rem;
  }
  :global(.mapboxgl-popup-content .popup-location) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--navy);
    margin: 0 0 0.25rem 0;
  }
  :global(.mapboxgl-popup-content .popup-year) {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.7;
    margin: 0;
  }

  /* Context Section */
  .context-section {
    background: var(--cream);
  }
  .context-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .context-grid { grid-template-columns: repeat(2, 1fr); gap: 4rem; }
  }
  .context-content h3 {
    font-size: 1.35rem;
    color: var(--navy);
    margin-bottom: 1.25rem;
  }
  .context-content p {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.85;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  /* Economic Section */
  .economic-section {
    background: var(--warm-white);
  }
  .research-highlight {
    display: grid;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .research-highlight { grid-template-columns: repeat(3, 1fr); }
  }

  /* Pillars Section */
  .pillars-section {
    background: var(--cream);
  }
  .pillars-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* Evidence Section */
  .evidence-section {
    background: var(--warm-white);
  }
  .evidence-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .evidence-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--navy);
    margin-bottom: 0.75rem;
  }
  .evidence-header p {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.75;
  }
  .evidence-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .evidence-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .evidence-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* Quality of Life Section */
  .quality-section {
    background: var(--navy);
  }
  .quality-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .quality-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .quality-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, planningCorridorData, crashIncidentsData }}>
  // Load Mapbox GL JS
  const script = document.createElement('script');
  script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  script.onload = initMap;
  document.head.appendChild(script);

  function initMap() {
    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'safety-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.43],
      zoom: 10.5,
    });

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');

    map.on('load', () => {
      // Add Planning Corridor (polygon) as context
      map.addSource('planning-corridor', {
        type: 'geojson',
        data: planningCorridorData,
      });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: {
          'fill-color': '#41521F',
          'fill-opacity': 0.1,
        },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 2,
          'line-opacity': 0.6,
        },
      });

      // Add crash incidents
      map.addSource('crash-incidents', {
        type: 'geojson',
        data: crashIncidentsData,
      });

      // Create square icons for cyclist markers
      function createSquareIcon(color, size) {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = size;
        canvas.height = size;

        // White border
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, size, size);

        // Colored fill (with border padding)
        const padding = 3;
        ctx.fillStyle = color;
        ctx.fillRect(padding, padding, size - padding * 2, size - padding * 2);

        return { width: size, height: size, data: ctx.getImageData(0, 0, size, size).data };
      }

      // Add square icons for each severity level
      map.addImage('square-fatal', createSquareIcon('#dc2626', 20));
      map.addImage('square-serious', createSquareIcon('#f97316', 16));
      map.addImage('square-injury', createSquareIcon('#eab308', 12));

      // === HEATMAP LAYER (default view) ===
      map.addLayer({
        id: 'crashes-heatmap',
        type: 'heatmap',
        source: 'crash-incidents',
        paint: {
          // Increase weight based on severity
          'heatmap-weight': [
            'case',
            ['==', ['get', 'severity'], 'fatal'], 3,
            ['==', ['get', 'severity'], 'serious'], 2,
            1
          ],
          // Increase intensity as zoom level increases
          'heatmap-intensity': [
            'interpolate', ['linear'], ['zoom'],
            9, 0.5,
            13, 1.5
          ],
          // Color gradient from green (low) to red (high)
          'heatmap-color': [
            'interpolate', ['linear'], ['heatmap-density'],
            0, 'rgba(0, 0, 0, 0)',
            0.1, 'rgba(0, 255, 0, 0.4)',
            0.3, 'rgba(255, 255, 0, 0.6)',
            0.5, 'rgba(255, 165, 0, 0.8)',
            0.7, 'rgba(255, 69, 0, 0.9)',
            1, 'rgba(255, 0, 0, 1)'
          ],
          // Radius increases with zoom
          'heatmap-radius': [
            'interpolate', ['linear'], ['zoom'],
            9, 20,
            11, 30,
            13, 40
          ],
          'heatmap-opacity': 0.8,
        },
      });

      // === POINT LAYERS (hidden by default) ===
      // Injury/minor pedestrian crashes (smallest, bottom layer)
      map.addLayer({
        id: 'crashes-ped-injury',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'pedestrian'], ['in', ['get', 'severity'], ['literal', ['injury', 'minor']]]],
        layout: { 'visibility': 'none' },
        paint: {
          'circle-radius': 6,
          'circle-color': '#eab308',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 1.5,
          'circle-opacity': 0.85,
        },
      });

      // Injury/minor cyclist crashes (smallest) - squares
      map.addLayer({
        id: 'crashes-bike-injury',
        type: 'symbol',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'cyclist'], ['in', ['get', 'severity'], ['literal', ['injury', 'minor']]]],
        layout: {
          'visibility': 'none',
          'icon-image': 'square-injury',
          'icon-allow-overlap': true,
        },
      });

      // Serious pedestrian crashes (circles)
      map.addLayer({
        id: 'crashes-ped-serious',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'pedestrian'], ['==', ['get', 'severity'], 'serious']],
        layout: { 'visibility': 'none' },
        paint: {
          'circle-radius': 8,
          'circle-color': '#f97316',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.9,
        },
      });

      // Serious cyclist crashes - squares
      map.addLayer({
        id: 'crashes-bike-serious',
        type: 'symbol',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'cyclist'], ['==', ['get', 'severity'], 'serious']],
        layout: {
          'visibility': 'none',
          'icon-image': 'square-serious',
          'icon-allow-overlap': true,
        },
      });

      // Fatal pedestrian crashes (circles, largest)
      map.addLayer({
        id: 'crashes-ped-fatal',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'pedestrian'], ['==', ['get', 'severity'], 'fatal']],
        layout: { 'visibility': 'none' },
        paint: {
          'circle-radius': 10,
          'circle-color': '#dc2626',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.95,
        },
      });

      // Fatal cyclist crashes (largest) - squares
      map.addLayer({
        id: 'crashes-bike-fatal',
        type: 'symbol',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'cyclist'], ['==', ['get', 'severity'], 'fatal']],
        layout: {
          'visibility': 'none',
          'icon-image': 'square-fatal',
          'icon-allow-overlap': true,
        },
      });

      // Point layers array for toggling
      const pointLayers = [
        'crashes-ped-fatal', 'crashes-ped-serious', 'crashes-ped-injury',
        'crashes-bike-fatal', 'crashes-bike-serious', 'crashes-bike-injury'
      ];

      // View toggle state and controls
      let isHeatmapView = true;
      const viewToggleBtn = document.getElementById('view-toggle-btn');
      const legendHeatmap = document.querySelector('.legend-heatmap');
      const legendPoints = document.querySelector('.legend-points');

      function toggleMapView() {
        isHeatmapView = !isHeatmapView;

        if (isHeatmapView) {
          // Show heatmap, hide points
          map.setLayoutProperty('crashes-heatmap', 'visibility', 'visible');
          pointLayers.forEach(layer => {
            map.setLayoutProperty(layer, 'visibility', 'none');
          });
          viewToggleBtn.querySelector('.toggle-label').textContent = 'Show Points';
          viewToggleBtn.querySelector('.icon-points').style.display = 'block';
          viewToggleBtn.querySelector('.icon-heatmap').style.display = 'none';
          legendHeatmap.style.display = 'contents';
          legendPoints.style.display = 'none';
        } else {
          // Show points, hide heatmap
          map.setLayoutProperty('crashes-heatmap', 'visibility', 'none');
          pointLayers.forEach(layer => {
            map.setLayoutProperty(layer, 'visibility', 'visible');
          });
          viewToggleBtn.querySelector('.toggle-label').textContent = 'Show Heatmap';
          viewToggleBtn.querySelector('.icon-points').style.display = 'none';
          viewToggleBtn.querySelector('.icon-heatmap').style.display = 'block';
          legendHeatmap.style.display = 'none';
          legendPoints.style.display = 'contents';
        }
      }

      viewToggleBtn.addEventListener('click', toggleMapView);

      // Popup on click for point layers
      const crashLayers = [
        'crashes-ped-fatal', 'crashes-ped-serious', 'crashes-ped-injury',
        'crashes-bike-fatal', 'crashes-bike-serious', 'crashes-bike-injury'
      ];

      crashLayers.forEach(layer => {
        map.on('click', layer, (e) => {
          const feature = e.features[0];
          const props = feature.properties;
          const typeLabel = props.type === 'pedestrian' ? 'Pedestrian' : 'Cyclist';

          // Format severity label
          let severityLabel;
          switch(props.severity) {
            case 'fatal': severityLabel = 'Fatality'; break;
            case 'serious': severityLabel = 'Serious Injury'; break;
            default: severityLabel = 'Injury'; break;
          }

          // Format date
          const dateStr = props.crash_datetime || props.year;

          // Build details section
          let details = '';
          if (props.fatalities > 0) {
            details += `<span>Fatalities: ${props.fatalities}</span>`;
          }
          if (props.serious_injuries > 0) {
            details += `<span>Serious injuries: ${props.serious_injuries}</span>`;
          }
          if (props.injuries > 0 && props.injuries !== props.serious_injuries) {
            details += `<span>Total injured: ${props.injuries}</span>`;
          }

          new mapboxgl.Popup()
            .setLngLat(feature.geometry.coordinates)
            .setHTML(`
              <span class="popup-type ${props.severity}">${typeLabel} ${severityLabel}</span>
              <p class="popup-location">${props.location || 'Location unavailable'}</p>
              <p class="popup-year">${dateStr}</p>
              ${details ? `<div class="popup-details">${details}</div>` : ''}
            `)
            .addTo(map);
        });

        map.on('mouseenter', layer, () => {
          map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', layer, () => {
          map.getCanvas().style.cursor = '';
        });
      });

      // Fit map to show the corridor
      const bounds = new mapboxgl.LngLatBounds();
      planningCorridorData.features[0].geometry.coordinates[0].forEach(coord => {
        bounds.extend(coord);
      });
      map.fitBounds(bounds, { padding: 40 });

      // Fullscreen toggle
      const mapWrapper = document.getElementById('safety-map-wrapper');
      const fullscreenBtn = document.getElementById('fullscreen-btn');

      function toggleFullscreen() {
        mapWrapper.classList.toggle('fullscreen');
        document.body.style.overflow = mapWrapper.classList.contains('fullscreen') ? 'hidden' : '';

        setTimeout(() => {
          map.resize();
          if (mapWrapper.classList.contains('fullscreen')) {
            map.fitBounds(bounds, { padding: 60 });
          } else {
            map.fitBounds(bounds, { padding: 40 });
          }
        }, 100);
      }

      fullscreenBtn.addEventListener('click', toggleFullscreen);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mapWrapper.classList.contains('fullscreen')) {
          toggleFullscreen();
        }
      });
    });
  }
</script>
