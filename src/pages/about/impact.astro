<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, planningCorridorData, crashIncidentsData }}>
  // Load Mapbox GL JS
  const script = document.createElement('script');
  script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  script.onload = initMap;
  document.head.appendChild(script);

  function initMap() {
    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'safety-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.43],
      zoom: 10.5,
    });

    map.addControl(new mapboxgl.NavigationControl(), 'top-right');

    map.on('load', () => {
      // Add Planning Corridor (polygon) as context
      map.addSource('planning-corridor', {
        type: 'geojson',
        data: planningCorridorData,
      });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: {
          'fill-color': '#41521F',
          'fill-opacity': 0.1,
        },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 2,
          'line-opacity': 0.6,
        },
      });

      // Add crash incidents
      map.addSource('crash-incidents', {
        type: 'geojson',
        data: crashIncidentsData,
      });

      // Fatal pedestrian crashes (circles)
      map.addLayer({
        id: 'crashes-ped-fatal',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'pedestrian'], ['==', ['get', 'severity'], 'fatal']],
        paint: {
          'circle-radius': 10,
          'circle-color': '#dc2626',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.9,
        },
      });

      // Serious pedestrian crashes (circles)
      map.addLayer({
        id: 'crashes-ped-serious',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'pedestrian'], ['==', ['get', 'severity'], 'serious']],
        paint: {
          'circle-radius': 8,
          'circle-color': '#f97316',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.9,
        },
      });

      // Fatal cyclist crashes (squares via symbol)
      map.addLayer({
        id: 'crashes-bike-fatal',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'cyclist'], ['==', ['get', 'severity'], 'fatal']],
        paint: {
          'circle-radius': 10,
          'circle-color': '#dc2626',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.9,
        },
      });

      // Serious cyclist crashes
      map.addLayer({
        id: 'crashes-bike-serious',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['all', ['==', ['get', 'type'], 'cyclist'], ['==', ['get', 'severity'], 'serious']],
        paint: {
          'circle-radius': 8,
          'circle-color': '#f97316',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
          'circle-opacity': 0.9,
        },
      });

      // Add small icon indicators for cyclist vs pedestrian
      // Pedestrians get a small inner dot
      map.addLayer({
        id: 'crashes-ped-indicator',
        type: 'circle',
        source: 'crash-incidents',
        filter: ['==', ['get', 'type'], 'pedestrian'],
        paint: {
          'circle-radius': 3,
          'circle-color': '#ffffff',
        },
      });

      // Popup on click for all crash layers
      const crashLayers = ['crashes-ped-fatal', 'crashes-ped-serious', 'crashes-bike-fatal', 'crashes-bike-serious'];

      crashLayers.forEach(layer => {
        map.on('click', layer, (e) => {
          const feature = e.features[0];
          const { type, severity, year, location } = feature.properties;
          const typeLabel = type === 'pedestrian' ? 'Pedestrian' : 'Cyclist';
          const severityLabel = severity === 'fatal' ? 'Fatality' : 'Serious Injury';

          new mapboxgl.Popup()
            .setLngLat(feature.geometry.coordinates)
            .setHTML(`
              <span class="popup-type ${severity}">${typeLabel} ${severityLabel}</span>
              <p class="popup-location">${location}</p>
              <p class="popup-year">${year}</p>
            `)
            .addTo(map);
        });

        map.on('mouseenter', layer, () => {
          map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', layer, () => {
          map.getCanvas().style.cursor = '';
        });
      });

      // Fit map to show the corridor
      const bounds = new mapboxgl.LngLatBounds();
      planningCorridorData.features[0].geometry.coordinates[0].forEach(coord => {
        bounds.extend(coord);
      });
      map.fitBounds(bounds, { padding: 40 });

      // Fullscreen toggle
      const mapWrapper = document.getElementById('safety-map-wrapper');
      const fullscreenBtn = document.getElementById('fullscreen-btn');

      function toggleFullscreen() {
        mapWrapper.classList.toggle('fullscreen');
        document.body.style.overflow = mapWrapper.classList.contains('fullscreen') ? 'hidden' : '';

        setTimeout(() => {
          map.resize();
          if (mapWrapper.classList.contains('fullscreen')) {
            map.fitBounds(bounds, { padding: 60 });
          } else {
            map.fitBounds(bounds, { padding: 40 });
          }
        }, 100);
      }

      fullscreenBtn.addEventListener('click', toggleFullscreen);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mapWrapper.classList.contains('fullscreen')) {
          toggleFullscreen();
        }
      });
    });
  }
</script>
