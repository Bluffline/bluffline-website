  /* Evidence Section */
  .evidence-section {
    background: var(--mist);
  }
  .evidence-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .evidence-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--navy);
    margin-bottom: 0.75rem;
