  @media (min-width: 900px) {
    .context-grid { grid-template-columns: repeat(2, 1fr); gap: 4rem; }
  }
  .context-content h3 {
    font-size: 1.35rem;
    color: var(--navy);
    margin-bottom: 1.25rem;
  }
  .context-content p {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.85;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  /* Economic Section */
  .economic-section {
    background: var(--mist);
  }
  .research-highlight {
    display: grid;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .research-highlight { grid-template-columns: repeat(3, 1fr); }
