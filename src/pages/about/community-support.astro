---
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'community-support');
const pd = page.data;
const sbId = 'src/content/pages/community-support.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import TestimonialCard from '../../components/content/TestimonialCard.astro';
import CallToAction from '../../components/ui/CallToAction.astro';

const testimonials = await getCollection('testimonials');

// Sort by order if provided, otherwise by date
const sortedTestimonials = testimonials.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  if (a.data.date && b.data.date) {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  }
  return 0;
});
---

<BaseLayout
  title="Our Friends"
  description="Civic leaders, elected officials, and community partners share why they support the Bluffline vision for Pensacola's waterfront."
>
  <PageHero
    label={pd.heroLabel}
    title={pd.heroTitle}
    description={pd.heroDescription}
    sbObjectId={sbId}
    labelFieldPath="heroLabel"
    titleFieldPath="heroTitle"
    descriptionFieldPath="heroDescription"
  />

  <section class="section testimonials-section">
    <div class="section-inner">
      <div class="section-header" data-sb-object-id={sbId}>
        <h2 data-sb-field-path="testimonialsHeading">{pd.testimonialsHeading}</h2>
        <p data-sb-field-path="testimonialsDescription">{pd.testimonialsDescription}</p>
      </div>
      {sortedTestimonials.length > 0 ? (
        <div class="testimonials-grid">
          {sortedTestimonials.map((testimonial) => (
            <TestimonialCard
              quote={testimonial.data.quote}
              author={testimonial.data.author}
              title={testimonial.data.title}
              organization={testimonial.data.organization}
              pdfFile={testimonial.data.pdfFile}
              sbObjectId={`src/content/testimonials/${testimonial.id}.json`}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Letters of support coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <CallToAction
    title={pd.ctaTitle}
    description={pd.ctaDescription}
    primaryLabel={pd.ctaPrimaryLabel}
    primaryHref={pd.ctaPrimaryHref}
    variant="forest"
    sbObjectId={sbId}
    titleFieldPath="ctaTitle"
    descriptionFieldPath="ctaDescription"
  />
</BaseLayout>

<style>
  .testimonials-section {
    background: var(--cream);
  }

  .testimonials-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
    color: var(--navy);
    opacity: 0.7;
  }
</style>
