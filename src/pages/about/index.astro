---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import BoardMemberCard from '../../components/content/BoardMemberCard.astro';
import IconCard from '../../components/content/IconCard.astro';
import DocumentCard from '../../components/content/DocumentCard.astro';
import TimelineItem from '../../components/content/TimelineItem.astro';
import MediaLightbox from '../../components/ui/MediaLightbox.astro';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const d = page.data;
const sbId = 'src/content/pages/about.json';

const boardMembers = await getCollection('board-members');
const timelineEntries = await getCollection('timeline');
const sortedTimeline = timelineEntries.sort((a, b) => a.data.order - b.data.order);
const sortedBoardMembers = boardMembers.sort((a, b) => a.data.order - b.data.order);
const activeMembers = sortedBoardMembers.filter(m => m.data.role !== 'emeritus');
const emeritusMembers = sortedBoardMembers.filter(m => m.data.role === 'emeritus');

const purposeBodyParagraphs = (d.purposeBody || '').split('\n\n').filter(Boolean);
const mergerBodyParagraphs = (d.mergerBody || '').split('\n\n').filter(Boolean);
---

<BaseLayout 
  title="About" 
  description="The story of the Bluffline — six decades of advocacy, a historic merger, and a bold vision for Pensacola's multimodal future."
>
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    sbObjectId={sbId}
    labelFieldPath="heroLabel"
    titleFieldPath="heroTitle"
    descriptionFieldPath="heroDescription"
  />

  <section class="section purpose-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="purpose-content">
        <p class="purpose-statement" data-sb-field-path="purposeStatement">{d.purposeStatement}</p>
        {purposeBodyParagraphs.map((paragraph: string, i: number) => (
          <p data-sb-field-path={i === 0 ? 'purposeBody' : undefined}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section history-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <h2 data-sb-field-path="historyHeading">{d.historyHeading}</h2>
        <p data-sb-field-path="historyDescription">{d.historyDescription}</p>
      </div>
      <div class="timeline">
        {sortedTimeline.map((entry) => (
          <TimelineItem
            date={entry.data.date}
            title={entry.data.title}
            description={entry.data.description}
            images={entry.data.images}
            entryId={entry.id}
            sbObjectId={`src/content/timeline/${entry.id}.json`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section merger-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="merger-grid">
        <div class="merger-content">
          <h2 data-sb-field-path="mergerHeading">{d.mergerHeading}</h2>
          {mergerBodyParagraphs.map((paragraph: string, i: number) => (
            <p data-sb-field-path={i === 0 ? 'mergerBody' : undefined}>{paragraph}</p>
          ))}
        </div>
        <div class="merger-highlight">
          <h3 data-sb-field-path="mergerHighlightTitle">{d.mergerHighlightTitle}</h3>
          <div class="merger-stat">
            <div class="merger-stat-value" data-sb-field-path="mergerStat1Value">{d.mergerStat1Value}</div>
            <div class="merger-stat-label" data-sb-field-path="mergerStat1Label">{d.mergerStat1Label}</div>
          </div>
          <div class="merger-stat">
            <div class="merger-stat-value" data-sb-field-path="mergerStat2Value">{d.mergerStat2Value}</div>
            <div class="merger-stat-label" data-sb-field-path="mergerStat2Label">{d.mergerStat2Label}</div>
          </div>
          <div class="merger-stat">
            <div class="merger-stat-value" data-sb-field-path="mergerStat3Value">{d.mergerStat3Value}</div>
            <div class="merger-stat-label" data-sb-field-path="mergerStat3Label">{d.mergerStat3Label}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section values-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <h2 data-sb-field-path="valuesHeading">{d.valuesHeading}</h2>
        <p data-sb-field-path="valuesDescription">{d.valuesDescription}</p>
      </div>
      <div class="values-grid" data-sb-field-path="values">
        {d.values?.map((value: any, i: number) => (
          <IconCard
            icon={value.icon}
            title={value.title}
            description={value.description}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section leadership-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <h2 data-sb-field-path="leadershipHeading">{d.leadershipHeading}</h2>
        <p data-sb-field-path="leadershipDescription">{d.leadershipDescription}</p>
      </div>
      <div class="leadership-grid">
        {activeMembers.map((member) => (
          <BoardMemberCard
            name={member.data.name}
            title={member.data.title}
            role={member.data.role}
            bio={member.data.bio}
            photo={member.data.photo}
            sbObjectId={`src/content/board-members/${member.id}.json`}
          />
        ))}
      </div>

      {emeritusMembers.length > 0 && (
        <div class="emeritus-section">
          <div class="emeritus-header">
            <h3 data-sb-field-path="emeritusHeading">{d.emeritusHeading}</h3>
            <p data-sb-field-path="emeritusDescription">{d.emeritusDescription}</p>
          </div>
          <div class="emeritus-grid">
            {emeritusMembers.map((member) => (
              <BoardMemberCard
                name={member.data.name}
                title={member.data.title}
                role={member.data.role}
                bio={member.data.bio}
                photo={member.data.photo}
                sbObjectId={`src/content/board-members/${member.id}.json`}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section documents-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="section-header">
        <h2 data-sb-field-path="documentsHeading">{d.documentsHeading}</h2>
        <p data-sb-field-path="documentsDescription">{d.documentsDescription}</p>
      </div>
      <div class="documents-grid" data-sb-field-path="documents">
        {d.documents?.map((doc: any, i: number) => (
          <DocumentCard
            title={doc.title}
            description={doc.description}
            href={doc.href}
            external={doc.external}
            icon={doc.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="View the Corridor"
    primaryHref="/about/corridor"
    sbObjectId={sbId}
    titleFieldPath="ctaTitle"
    descriptionFieldPath="ctaDescription"
  />

  <MediaLightbox />
</BaseLayout>

<style>
  .purpose-section { background: var(--cream); }
  .purpose-content { max-width: 800px; }
  .purpose-statement {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
    line-height: 1.4;
  }
  .purpose-content p { font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }

  .history-section { background: var(--warm-white); }
  .timeline {
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--spring);
  }
  @media (min-width: 900px) {
    .timeline {
      max-width: 900px;
    }
  }
  @media (min-width: 1200px) {
    .timeline {
      max-width: 1000px;
    }
  }

  .merger-section { background: var(--mist); }
  .merger-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .merger-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; }
  }
  .merger-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--navy); margin-bottom: 1.5rem; }
  .merger-content p { font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }
  .merger-highlight {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(45, 48, 71, 0.06);
  }
  .merger-highlight h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 1.5rem; }
  .merger-stat { margin-bottom: 1.5rem; }
  .merger-stat:last-child { margin-bottom: 0; }
  .merger-stat-value {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--forest);
  }
  .merger-stat-label { font-size: 0.9rem; color: var(--navy); opacity: 0.7; }

  /* Values Section */
  .values-section { background: var(--warm-white); }
  .values-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .values-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Leadership Section */
  .leadership-section { background: var(--mist); }
  .leadership-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .leadership-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .leadership-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  /* Emeritus Section */
  .emeritus-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(45, 48, 71, 0.1);
  }
  .emeritus-header {
    margin-bottom: 2rem;
  }
  .emeritus-header h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .emeritus-header p {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.7;
  }
  .emeritus-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .emeritus-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .emeritus-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Documents Section */
  .documents-section { background: var(--cream); }
  .documents-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .documents-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  }
</style>
