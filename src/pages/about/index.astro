---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import IconCard from '../../components/content/IconCard.astro';
import TestimonialCard from '../../components/content/TestimonialCard.astro';
import TimelineItem from '../../components/content/TimelineItem.astro';
import AwardRecipientCard from '../../components/content/AwardRecipientCard.astro';
import MediaLightbox from '../../components/ui/MediaLightbox.astro';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const d = page.data;


const allTestimonials = await getCollection('testimonials');
const topTestimonials = allTestimonials
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const timelineEntries = await getCollection('timeline');
const sortedTimeline = timelineEntries.sort((a, b) => a.data.order - b.data.order);

const RECENT_RECIPIENTS_COUNT = 3;
const allDefenderRecipients = await getCollection('defender-award-recipients', ({ data }) => !data.draft);
const sortedDefenderRecipients = allDefenderRecipients.sort((a, b) => b.data.year - a.data.year);
const recentDefenderRecipients = sortedDefenderRecipients.slice(0, RECENT_RECIPIENTS_COUNT);
const hasMoreDefenderRecipients = sortedDefenderRecipients.length > RECENT_RECIPIENTS_COUNT;

const values = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Interdependence',
    description: 'Our community thrives when all our neighbors are happy, healthy, and whole.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Respect',
    description: 'Every life is sacred. Every perspective is unique and valuable.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Self-Determination',
    description: 'Every neighborhood deserves a say in decisions that affect them.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
    title: 'Transparency',
    description: 'Sunlight is the best disinfectant and the surest path to accountability.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Sustainability',
    description: 'We build for future generations and consider those who come after us.',
  },
];

---

<BaseLayout 
  title="About" 
  description="The story of the Bluffline — six decades of advocacy, a historic merger, and a bold vision for Pensacola's multimodal future."
>
  <!-- TODO: Swap hero photo when final assets are provided -->
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    heroImage="/images/aerial/escambia-bay-bluffs-aerial-2024.jpg"
    heroImageAlt="Aerial view of the Pensacola Bay bluffs and waterfront corridor"
    keywords={["advocacy", "vision"]}
  />

  <section class="section purpose-section">
    <div class="section-inner">
      <div class="purpose-content">
        <p class="section-label">{d.purposeLabel}</p>
        <p class="purpose-statement">{d.purposeStatement}</p>
        <p>{d.purposeBody1}</p>
      </div>
      <div class="identity-grid">
        <div class="identity-block">
          <p class="section-label">{d.missionLabel}</p>
          <p class="identity-statement">{d.missionStatement}</p>
        </div>
        <div class="identity-block">
          <p class="section-label">{d.visionLabel}</p>
          <p class="identity-statement">{d.visionStatement}</p>
          <p class="identity-body">{d.visionBody}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section values-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>{d.valuesHeading}</h2>
        <p>{d.valuesDescription}</p>
      </div>
      <div class="values-grid">
        {values.map(value => (
          <IconCard
            icon={value.icon}
            title={value.title}
            description={value.description}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section history-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>{d.historyHeading}</h2>
        <p>{d.historyDescription}</p>
      </div>
      <div class="timeline">
        {sortedTimeline.map((entry) => (
          <TimelineItem
            date={entry.data.date}
            title={entry.data.title}
            description={entry.data.description}
            images={entry.data.images}
            entryId={entry.id}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section merger-section">
    <div class="section-inner">
      <div class="merger-grid">
        <div class="merger-content">
          <h2>{d.mergerHeading}</h2>
          <p>{d.mergerBody1}</p>
          <p>{d.mergerBody2}</p>
          <p>{d.mergerBody3}</p>
        </div>
        <div class="merger-highlight">
          <h3>{d.mergerHighlightTitle}</h3>
          <div class="merger-stat">
            <div class="merger-stat-value">{d.mergerStat1Value}</div>
            <div class="merger-stat-label">{d.mergerStat1Label}</div>
          </div>
          <div class="merger-stat">
            <div class="merger-stat-value">{d.mergerStat2Value}</div>
            <div class="merger-stat-label">{d.mergerStat2Label}</div>
          </div>
          <div class="merger-stat">
            <div class="merger-stat-value">{d.mergerStat3Value}</div>
            <div class="merger-stat-label">{d.mergerStat3Label}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section governance-section">
    <div class="section-inner">
      <div class="governance-content">
        <h2>{d.governanceHeading}</h2>
        <p>{d.governanceDescription}</p>
        <a href="/about/governance" class="governance-link">{d.governanceLinkLabel}</a>
      </div>
    </div>
  </section>

  {topTestimonials.length > 0 && (
    <section class="section friends-section">
      <div class="section-inner">
        <div class="section-header">
          <h2>Our Friends</h2>
          <p>Civic leaders, elected officials, and community partners who support the Bluffline vision.</p>
        </div>
        <div class="friends-grid">
          {topTestimonials.map((t) => (
            <TestimonialCard
              quote={t.data.quote}
              author={t.data.author}
              title={t.data.title}
              organization={t.data.organization}
              organizationLink={t.data.organizationLink}
              pdfFile={t.data.pdfFile}
            />
          ))}
        </div>
        <div class="friends-more">
          <a href="/about/community-support" class="friends-link">See all supporters →</a>
        </div>
      </div>
    </section>
  )}

  {recentDefenderRecipients.length > 0 && (
    <section class="section defender-award-section">
      <div class="section-inner">
        <div class="section-header">
          <h2>The Bluffline Defender Award</h2>
          <p>An annual tradition honoring individuals who have made exceptional contributions to the vision of a connected Pensacola waterfront.</p>
        </div>
        <div class="defender-award-grid">
          {recentDefenderRecipients.map((recipient) => (
            <AwardRecipientCard
              name={recipient.data.name}
              title={recipient.data.title}
              year={recipient.data.year}
              photo={recipient.data.photo}
              href={`/about/defender-award/${recipient.slug}`}
            />
          ))}
        </div>
        {hasMoreDefenderRecipients && (
          <div class="defender-award-more">
            <a href="/about/defender-award" class="defender-award-link">See all Defender Award recipients →</a>
          </div>
        )}
      </div>
    </section>
  )}

  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="View the Corridor"
    primaryHref="/about/corridor"
  />

  <MediaLightbox />
</BaseLayout>

<style>
  .purpose-section { background: var(--warm-white); }
  .purpose-content { max-width: 800px; }
  .purpose-content .purpose-statement {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
    line-height: 1.4;
    opacity: 1;
  }
  .purpose-content p { font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }
  .purpose-content .section-label { font-size: 0.85rem; opacity: 1; margin-bottom: 1rem; }

  .identity-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 900px) {
    .identity-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  .identity-block {
    background: var(--card-bg);
    border: var(--card-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: var(--card-shadow);
  }
  .identity-block .section-label { margin-bottom: 0.75rem; }
  .identity-statement {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--navy);
    line-height: 1.45;
  }
  .identity-body {
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.85;
    margin-top: 1rem;
  }

  .history-section { background: var(--warm-white); }
  .timeline {
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--spring);
  }
  @media (min-width: 900px) {
    .timeline {
      max-width: 900px;
    }
  }
  @media (min-width: 1200px) {
    .timeline {
      max-width: 1000px;
    }
  }

  .merger-section { background: var(--cream); }
  .merger-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .merger-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; }
  }
  .merger-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--navy); margin-bottom: 1.5rem; }
  .merger-content p { font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }
  .merger-highlight {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(45, 48, 71, 0.06);
  }
  .merger-highlight h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 1.5rem; }
  .merger-stat { margin-bottom: 1.5rem; }
  .merger-stat:last-child { margin-bottom: 0; }
  .merger-stat-value {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--forest);
  }
  .merger-stat-label { font-size: 0.9rem; color: var(--navy); opacity: 0.7; }

  /* Values Section */
  .values-section { background: var(--mist); }
  .values-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .values-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Governance Section */
  .governance-section { background: var(--warm-white); }
  .governance-content { max-width: 720px; }
  .governance-content h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--navy); margin-bottom: 1rem; }
  .governance-content p { font-size: 1.05rem; color: var(--navy); opacity: 0.85; margin-bottom: 1.5rem; }
  .governance-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 2px solid var(--spring);
    padding-bottom: 2px;
  }
  .governance-link:hover { color: var(--navy); border-color: var(--navy); }

  /* Defender Award Section */
  .defender-award-section { background: var(--cream); }
  .defender-award-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .defender-award-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .defender-award-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  @media (min-width: 1280px) {
    .defender-award-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .defender-award-more {
    margin-top: 2.5rem;
    text-align: center;
  }
  .defender-award-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 2px solid var(--spring);
    padding-bottom: 2px;
  }
  .defender-award-link:hover { color: var(--navy); border-color: var(--navy); }

  /* Friends Section */
  .friends-section { background: var(--mist); }
  .friends-grid {
    column-count: 1;
    column-gap: 2rem;
  }
  @media (min-width: 768px) {
    .friends-grid { column-count: 2; }
  }
  @media (min-width: 1200px) {
    .friends-grid { column-count: 3; }
  }
  .friends-more {
    margin-top: 2.5rem;
    text-align: center;
  }
  .friends-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 2px solid var(--spring);
    padding-bottom: 2px;
  }
  .friends-link:hover { color: var(--navy); border-color: var(--navy); }


</style>
