---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CallToAction from '../../../components/ui/CallToAction.astro';

export async function getStaticPaths() {
  const recipients = await getCollection('defender-award-recipients', ({ data }) => !data.draft);
  return recipients.map(recipient => ({
    params: { slug: recipient.slug },
    props: { recipient },
  }));
}

const { recipient } = Astro.props;
const { Content } = await recipient.render();
const { name, title, year, photo, summary, awardObjectDescription } = recipient.data;
---

<BaseLayout title={`${name} | Bluffline Defender Award`} description={summary}>
  <article class:list={[{ 'no-featured-image': !photo }]}>
    {photo && (
      <div class="article-featured-image">
        <img src={photo} alt={name} />
      </div>
    )}

    <header class="article-header">
      <div class="article-header-inner">
        <a href="/about/defender-award" class="article-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          All Recipients
        </a>
        <p class="article-meta">
          <span class="article-meta-award">Bluffline Defender Award</span>
          <span class="article-meta-sep" aria-hidden="true">·</span>
          <span>{year} Recipient</span>
        </p>
        <h1>{name}</h1>
        <p class="article-subtitle">{title}</p>
      </div>
    </header>

    <div class="article-body">
      <div class="article-content">
        <Content />

        {awardObjectDescription && (
          <div class="award-object-box">
            <span class="object-label">The Award</span>
            <p>{awardObjectDescription}</p>
          </div>
        )}
      </div>
    </div>
  </article>

  <CallToAction
    title="Join the movement"
    description="Community participation directly shapes outcomes. Get involved with the Bluffline."
    primaryLabel="Get Involved"
    primaryHref="/support"
  />
</BaseLayout>

<style>
  .article-featured-image {
    width: 100%;
    height: 45vh;
    min-height: 320px;
    max-height: 560px;
    margin-top: calc(73px + var(--banner-height, 0px));
    overflow: hidden;
  }

  .article-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .article-header {
    background: var(--cream);
    padding: 3rem 1.5rem;
  }

  .no-featured-image .article-header {
    padding-top: calc(3rem + 73px + var(--banner-height, 0px));
  }

  @media (min-width: 768px) {
    .article-header {
      padding: 4rem 3rem;
    }

    .no-featured-image .article-header {
      padding-top: calc(4rem + 73px + var(--banner-height, 0px));
    }
  }

  .article-header-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forest);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: gap 0.2s ease;
  }

  .article-back:hover {
    gap: 0.75rem;
  }

  .article-back svg {
    width: 18px;
    height: 18px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: rgba(45, 48, 71, 0.6);
    margin-bottom: 0.75rem;
  }

  .article-meta-award {
    color: var(--forest);
  }

  .article-meta-sep {
    opacity: 0.5;
  }

  .article-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .article-subtitle {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.6;
  }

  .article-body {
    padding: 3rem 1.5rem;
  }

  @media (min-width: 768px) {
    .article-body {
      padding: 4rem 3rem;
    }
  }

  .article-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.85;
  }

  .award-object-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: rgba(153, 204, 99, 0.12);
    border-radius: 12px;
    border-left: 3px solid var(--spring);
  }

  .award-object-box .object-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .award-object-box p {
    font-size: 0.95rem;
    color: var(--navy);
    margin: 0;
    line-height: 1.6;
  }
</style>
