---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import AwardRecipientCard from '../../../components/content/AwardRecipientCard.astro';
import CallToAction from '../../../components/ui/CallToAction.astro';

const allRecipients = await getCollection('defender-award-recipients', ({ data }) => !data.draft);
const recipients = allRecipients.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Bluffline Defender Award"
  description="Honoring individuals who have made exceptional contributions to the vision of a connected Pensacola waterfront."
>
  <PageHero
    label="Recognition"
    title="The Bluffline Defender Award"
    description="Established in 2025, the Defender Award is an annual tradition honoring individuals who have made exceptional contributions to the vision of a connected Pensacola waterfront."
    heroImage="/images/aerial/escambia-bay-bluffs-aerial-2024.jpg"
    heroImageAlt="Aerial view of the Pensacola Bay bluffs and waterfront corridor"
    keywords={["Defender", "Award"]}
  />

  <section class="section recipients-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>Past Recipients</h2>
        <p>Each year, we recognize a friend or partner whose work has moved the Bluffline vision forward.</p>
      </div>
      <div class="recipients-grid">
        {recipients.map((recipient) => (
          <AwardRecipientCard
            name={recipient.data.name}
            title={recipient.data.title}
            year={recipient.data.year}
            photo={recipient.data.photo}
            href={`/about/defender-award/${recipient.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title="Join the movement"
    description="Community participation directly shapes outcomes. Get involved with the Bluffline."
    primaryLabel="Get Involved"
    primaryHref="/support"
  />
</BaseLayout>

<style>
  .recipients-section { background: var(--cream); }
  .recipients-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .recipients-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .recipients-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  @media (min-width: 1280px) {
    .recipients-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
