---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import { getCollection } from 'astro:content';

const allDocuments = await getCollection('documents');
const plans = allDocuments
  .filter(doc => doc.data.documentType === 'plan')
  .sort((a, b) => {
    // Sort by level priority: state, regional, county, city
    const levelOrder = { federal: 0, state: 1, regional: 2, county: 3, city: 4 };
    const levelDiff = (levelOrder[a.data.level || 'city'] || 4) - (levelOrder[b.data.level || 'city'] || 4);
    if (levelDiff !== 0) return levelDiff;
    // Then by year descending
    return b.data.year - a.data.year;
  });

// Separate the scenic highway plan for the highlight box
const scenicHighwayPlan = plans.find(p => p.data.title.includes('Scenic Highway'));
const regularPlans = plans.filter(p => !p.data.title.includes('Scenic Highway'));
---

<BaseLayout 
  title="Planning" 
  description="See how the Bluffline aligns with adopted plans from local, regional, and state agencies."
>
  <PageHero
    label="Progress"
    title="Grounded in adopted plans"
    description="The Bluffline isn't a new idea—it builds on decades of planning and policy that have consistently identified this corridor as a regional priority."
  />

  <section class="planning-intro">
    <div class="section-inner">
      <div class="intro-content">
        <p>Every segment of the Bluffline corridor appears in at least one adopted plan from a local, regional, or state agency. This isn't coincidence—it reflects a consistent regional vision for multimodal connectivity that has emerged through multiple public planning processes over the past two decades.</p>
        <p>The plans below represent the policy foundation that the Bluffline builds upon. They demonstrate that this corridor has been identified as a priority by the City of Pensacola, Escambia County, the Florida-Alabama Transportation Planning Organization, and the State of Florida.</p>
      </div>
    </div>
  </section>

  <section class="plans-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>Adopted Plans</h2>
      </div>
      <div class="plans-grid">
        {regularPlans.map(plan => (
          <div class="plan-card">
            <div class="plan-level">{plan.data.agency}</div>
            <h3>{plan.data.title}</h3>
            <p>{plan.data.description}</p>
            {(plan.data.file || plan.data.link) ? (
              <a href={plan.data.file || plan.data.link} class="plan-link" target="_blank" rel="noopener">
                View Plan
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            ) : (
              <span class="plan-link disabled">
                View Plan
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            )}
          </div>
        ))}

        {scenicHighwayPlan && (
          <div class="highlight-box">
            <div>
              <h3>{scenicHighwayPlan.data.title}</h3>
              <p>{scenicHighwayPlan.data.description}</p>
            </div>
            {(scenicHighwayPlan.data.file || scenicHighwayPlan.data.link) ? (
              <a href={scenicHighwayPlan.data.file || scenicHighwayPlan.data.link} class="btn" target="_blank" rel="noopener">View Plan</a>
            ) : (
              <span class="btn disabled">View Plan</span>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <CallToAction
    title="Questions about planning?"
    description="We're happy to discuss how the Bluffline fits into the broader planning landscape and answer questions about specific plans or policies."
    primaryLabel="Get in Touch"
    primaryHref="/support"
    variant="mist"
  />
</BaseLayout>

<style>
  .planning-intro { background: var(--cream); padding: 5rem 0; }
  @media (min-width: 768px) { .planning-intro { padding: 7rem 0; } }
  .intro-content { max-width: 800px; }
  .intro-content p { font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }

  .plans-section { background: var(--warm-white); padding: 5rem 0; }
  @media (min-width: 768px) { .plans-section { padding: 7rem 0; } }
  .plans-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .plans-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  @media (min-width: 1200px) {
    .plans-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .plan-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid rgba(45, 48, 71, 0.06);
    display: flex;
    flex-direction: column;
  }
  .plan-level {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .plan-card h3 { font-size: 1.15rem; color: var(--navy); margin-bottom: 0.75rem; }
  .plan-card p { font-size: 0.9rem; color: var(--navy); opacity: 0.75; flex: 1; }
  .plan-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forest);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    margin-top: 1rem;
    transition: gap 0.2s ease;
  }
  .plan-link:hover:not(.disabled) { gap: 0.75rem; }
  .plan-link svg { width: 16px; height: 16px; }
  .plan-link.disabled {
    opacity: 0.4;
    cursor: default;
  }
  .btn.disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .highlight-box {
    grid-column: 1 / -1;
    background: var(--mist);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .highlight-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 2.5rem;
    }
  }
  .highlight-box h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 0.5rem; }
  .highlight-box p { color: var(--navy); opacity: 0.75; margin: 0; }
</style>
