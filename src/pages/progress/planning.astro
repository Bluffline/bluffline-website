---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import IconCard from '../../components/content/IconCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { renderParagraphs } from '../../utils/render-paragraphs';

const page = await getEntry('pages', 'planning');
const pd = page.data;
const sbId = 'src/content/pages/planning.json';

const allDocuments = await getCollection('documents');
const plans = allDocuments
  .filter(doc => doc.data.documentType === 'plan')
  .sort((a, b) => {
    // Sort by level priority: state, regional, county, city
    const levelOrder = { federal: 0, state: 1, regional: 2, county: 3, city: 4 };
    const levelDiff = (levelOrder[a.data.level || 'city'] || 4) - (levelOrder[b.data.level || 'city'] || 4);
    if (levelDiff !== 0) return levelDiff;
    // Then by year descending
    return b.data.year - a.data.year;
  });

// Separate the scenic highway plan for the highlight box
const scenicHighwayPlan = plans.find(p => p.data.title.includes('Scenic Highway'));
const regularPlans = plans.filter(p => !p.data.title.includes('Scenic Highway'));
---

<BaseLayout 
  title="Planning" 
  description="See how the Bluffline aligns with adopted plans from local, regional, and state agencies."
>
  <PageHero
    label={pd.heroLabel}
    title={pd.heroTitle}
    description={pd.heroDescription}
    sbObjectId={sbId}
    labelFieldPath="heroLabel"
    titleFieldPath="heroTitle"
    descriptionFieldPath="heroDescription"
  />

  <section class="planning-intro" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="intro-content">
        <div class="intro-content" data-sb-field-path="introBody" set:html={renderParagraphs(pd.introBody)} />
      </div>
    </div>
  </section>

  <section class="plans-section">
    <div class="section-inner">
      <div class="section-header" data-sb-object-id={sbId}>
        <h2 data-sb-field-path="plansHeading">{pd.plansHeading}</h2>
      </div>
      <div class="plans-grid">
        {regularPlans.map(plan => (
          <IconCard
            agency={plan.data.agency}
            title={plan.data.title}
            description={plan.data.description ?? ''}
            href={plan.data.file || plan.data.link}
            external={true}
          />
        ))}

        {scenicHighwayPlan && (
          <div class="highlight-box">
            <div>
              <h3>{scenicHighwayPlan.data.title}</h3>
              <p>{scenicHighwayPlan.data.description}</p>
            </div>
            {(scenicHighwayPlan.data.file || scenicHighwayPlan.data.link) ? (
              <a href={scenicHighwayPlan.data.file || scenicHighwayPlan.data.link} class="btn" target="_blank" rel="noopener">View Plan</a>
            ) : (
              <span class="btn disabled">View Plan</span>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <CallToAction
    title={pd.ctaTitle}
    description={pd.ctaDescription}
    primaryLabel={pd.ctaPrimaryLabel}
    primaryHref={pd.ctaPrimaryHref}
    variant="mist"
    sbObjectId={sbId}
    titleFieldPath="ctaTitle"
    descriptionFieldPath="ctaDescription"
  />
</BaseLayout>

<style>
  .planning-intro { background: var(--cream); padding: 5rem 0; }
  @media (min-width: 768px) { .planning-intro { padding: 7rem 0; } }
  .intro-content { max-width: 800px; }
  .intro-content p { font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy); opacity: 0.85; }

  .plans-section { background: var(--warm-white); padding: 5rem 0; }
  @media (min-width: 768px) { .plans-section { padding: 7rem 0; } }
  .plans-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .plans-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  @media (min-width: 1200px) {
    .plans-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .btn.disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .highlight-box {
    grid-column: 1 / -1;
    background: var(--mist);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .highlight-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 2.5rem;
    }
  }
  .highlight-box h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 0.5rem; }
  .highlight-box p { color: var(--navy); opacity: 0.75; margin: 0; }
</style>
