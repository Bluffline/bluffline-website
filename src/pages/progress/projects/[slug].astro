---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CorridorMap from '../../../components/ui/CorridorMap.astro';
import MilestoneList from '../../../components/content/MilestoneList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(p => !p.data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;

const statusLabels: Record<string, string> = {
  active: 'Active',
  pending: 'Pending Obligation',
  pursuing: 'Pursuing',
  complete: 'Complete',
};

const projectSegments = d.segments?.features?.length > 0
  ? [{ id: d.shortTitle, color: d.color || '#99CC63', segments: d.segments }]
  : [];

const completedCount = d.milestones.filter(m => m.status === 'complete').length;
const totalCount = d.milestones.length;
const progressPct = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;
---

<BaseLayout
  title={d.shortTitle}
  description={d.description}
>
  <!-- Hero (reuses the site-wide PageHero with featured image) -->
  <PageHero
    label={statusLabels[d.status]}
    title={d.title}
    heroImage={d.featuredImage}
    heroImageAlt={d.featuredImageAlt}
  >
    <div class="hero-meta">
      <span class="meta-item"><strong>Funder:</strong> {d.funder}</span>
      <span class="meta-item"><strong>Program:</strong> {d.program}</span>
      {d.amount && <span class="meta-item"><strong>Award:</strong> {d.amount}</span>}
      {d.awardDate && <span class="meta-item"><strong>Announced:</strong> {d.awardDate}</span>}
    </div>
    <a href="/progress" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      All Projects
    </a>
  </PageHero>

  <!-- Body: description + timeline | sticky map -->
  <section class="project-body">
    <div class="project-body-inner">

      <!-- Left: description + milestones -->
      <div class="main-column">
        <p class="project-description">{d.description}</p>

        {d.status === 'pursuing' ? (
          <div class="pursuing-notice">
            <p>We've submitted an application for this funding. If awarded, this project would advance planning work along the Bluffline corridor.</p>
          </div>
        ) : (
          <div class="milestones-section">
            <div class="milestones-header">
              <h2>Project Milestones</h2>
              <div class="progress-summary">
                <div class="progress-bar-track">
                  <div class="progress-bar-fill" style={`width: ${progressPct}%`}></div>
                </div>
                <span class="progress-text">{completedCount} of {totalCount} complete</span>
              </div>
            </div>
            <MilestoneList milestones={d.milestones} projectColor={d.color} />
          </div>
        )}
      </div>

      <!-- Right: sticky project map -->
      {projectSegments.length > 0 && (
        <div class="map-column">
          <CorridorMap
            allProjectSegments={projectSegments}
            interactive={true}
          />
        </div>
      )}

    </div>
  </section>
</BaseLayout>

<style>
  /* Hero slot content */
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin-bottom: 1.25rem;
  }
  .meta-item {
    font-size: 0.9rem;
    color: var(--navy);
    opacity: 0.75;
  }
  .meta-item strong {
    font-weight: 600;
    opacity: 1;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--forest);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .back-link:hover { opacity: 1; }

  /* ─── Body ─────────────────────────────────────────────── */
  .project-body {
    background: var(--warm-white);
  }

  .project-body-inner {
    display: grid;
    gap: 0;
  }
  @media (min-width: 1024px) {
    .project-body-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ─── Main column ──────────────────────────────────────── */
  .main-column {
    padding: 3rem 1.5rem;
  }
  @media (min-width: 768px) {
    .main-column { padding: 4rem 3rem; }
  }
  @media (min-width: 1024px) {
    .main-column { padding: 4rem 3.5rem 5rem 4rem; }
  }

  .project-description {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.8;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .milestones-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .milestones-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--navy);
    margin: 0;
  }

  .progress-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .progress-bar-track {
    width: 80px;
    height: 4px;
    background: var(--mist);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--spring);
    border-radius: 2px;
  }
  .progress-text {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.5;
    white-space: nowrap;
  }

  .pursuing-notice {
    background: var(--mist);
    border-radius: 12px;
    padding: 2rem;
  }
  .pursuing-notice p {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Sticky map column ────────────────────────────────── */
  .map-column {
    position: relative;
    min-height: 360px;
  }
  @media (min-width: 1024px) {
    .map-column {
      position: sticky;
      top: 0;
      height: 100vh;
      align-self: start;
    }
    .map-column :global(.corridor-map-wrapper) {
      height: 100%;
      max-height: none;
      min-height: 0;
    }
  }
</style>
