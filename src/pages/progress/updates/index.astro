---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CallToAction from '../../../components/ui/CallToAction.astro';
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates'))
  .filter(u => !u.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = updates;

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout
  title="Updates"
  description="News, announcements, and project updates from the Bluffline — Pensacola's 20-mile multimodal corridor."
>
  <!-- Featured Latest Post -->
  {featured && (
    <section class="featured-section">
      <div class="featured-inner" data-sb-object-id={`src/content/updates/${featured.slug}.md`}>
        {featured.data.featuredImage && (
          <div class="featured-image">
            <img src={featured.data.featuredImage} alt={featured.data.featuredImageAlt || ''} data-sb-field-path="featuredImage" />
          </div>
        )}
        <div class="featured-overlay">
          <div class="featured-content">
            <span class="featured-label">Latest Update</span>
            <time class="featured-date" data-sb-field-path="pubDate">{formatDate(featured.data.pubDate)}</time>
            <h1 data-sb-field-path="title">{featured.data.title}</h1>
            <p data-sb-field-path="description">{featured.data.description}</p>
            <a href={`/progress/updates/${featured.slug}`} class="featured-link">
              Read the full story
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Remaining Updates -->
  {rest.length > 0 && (
    <section class="updates-section">
      <div class="updates-inner">
        <div class="updates-timeline">
          {rest.map(update => (
            <a href={`/progress/updates/${update.slug}`} class="timeline-item" data-sb-object-id={`src/content/updates/${update.slug}.md`}>
              <div class="timeline-marker">
                <div class="timeline-dot"></div>
              </div>
              <div class="timeline-content">
                <time data-sb-field-path="pubDate">{formatDate(update.data.pubDate)}</time>
                <h3 data-sb-field-path="title">{update.data.title}</h3>
                <p data-sb-field-path="description">{update.data.description}</p>
                <span class="timeline-link">
                  Read more
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
              {update.data.featuredImage && (
                <div class="timeline-image">
                  <img src={update.data.featuredImage} alt={update.data.featuredImageAlt || ''} loading="lazy" />
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CallToAction
    title="Don't miss an update"
    description="Subscribe to get the latest Bluffline news delivered to your inbox."
    primaryLabel="Subscribe"
    kitFormId="3f946cf4ba"
    variant="mist"
  />
</BaseLayout>

<style>
  /* Featured Section */
  .featured-section {
    padding-top: calc(57px + var(--banner-height, 0px));
  }
  .featured-inner {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
  }
  .featured-image {
    position: absolute;
    inset: 0;
  }
  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .featured-overlay {
    position: relative;
    z-index: 1;
    width: 100%;
    background: linear-gradient(to top, rgba(45, 48, 71, 0.95) 0%, rgba(45, 48, 71, 0.6) 60%, transparent 100%);
    padding: 6rem 1.5rem 3rem;
  }
  @media (min-width: 768px) {
    .featured-overlay {
      padding: 8rem 3rem 4rem;
    }
  }
  .featured-content {
    max-width: 700px;
  }
  .featured-label {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--spring);
    font-weight: 600;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 100px;
  }
  .featured-date {
    display: block;
    color: white;
    opacity: 0.6;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  .featured-content h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .featured-content > p {
    font-size: 1.1rem;
    color: white;
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--spring);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: gap 0.2s ease;
  }
  .featured-link:hover {
    gap: 0.75rem;
  }
  .featured-link svg {
    width: 18px;
    height: 18px;
  }

  /* Updates Timeline Section */
  .updates-section {
    padding: 4rem 0 5rem;
    background: var(--warm-white);
  }
  .updates-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 768px) {
    .updates-inner {
      padding: 0 3rem;
    }
  }
  .updates-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(45, 48, 71, 0.08);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }
  .timeline-item:first-child {
    padding-top: 0;
  }
  @media (min-width: 768px) {
    .timeline-item {
      grid-template-columns: 24px 1fr 200px;
      gap: 2rem;
    }
  }
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.35rem;
  }
  .timeline-dot {
    width: 10px;
    height: 10px;
    background: var(--spring);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .timeline-content time {
    display: block;
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.5;
    margin-bottom: 0.5rem;
  }
  .timeline-content h3 {
    font-size: 1.25rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  .timeline-content p {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.7;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .timeline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--forest);
  }
  .timeline-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  .timeline-item:hover .timeline-link svg {
    transform: translateX(4px);
  }
  .timeline-item:hover .timeline-content h3 {
    color: var(--forest);
  }
  .timeline-image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    display: none;
  }
  @media (min-width: 768px) {
    .timeline-image {
      display: block;
    }
  }
  .timeline-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .timeline-item:hover .timeline-image img {
    transform: scale(1.05);
  }
</style>
