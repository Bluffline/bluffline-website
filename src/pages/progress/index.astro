---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PhaseTracker from '../../components/ui/PhaseTracker.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import UpdateCard from '../../components/content/UpdateCard.astro';
import CorridorMap from '../../components/ui/CorridorMap.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'progress');
const d = page.data;

const updates = (await getCollection('updates'))
  .filter(u => !u.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = (await getCollection('projects'))
  .filter(p => !p.data.draft);

// Sort: active first, then pending, then pursuing, then complete
const statusOrder = { active: 0, pending: 1, pursuing: 2, complete: 3 };
const projects = allProjects.sort(
  (a, b) => (statusOrder[a.data.status] ?? 99) - (statusOrder[b.data.status] ?? 99)
);

// Collect all project segment data for the map
const allProjectSegments = projects
  .filter(p => p.data.segments?.features?.length > 0)
  .map(p => ({
    id: p.data.shortTitle,
    color: p.data.color || '#99CC63',
    segments: p.data.segments,
  }));

// Program stages for the arc diagram
const programStages = [
  { label: 'Set up the program', status: 'complete' as const },
  { label: 'Engage the community', status: 'current' as const },
  { label: 'Agree on a vision', status: 'current' as const },
  { label: 'Study the options', status: 'current' as const },
  { label: 'Align funding & governance', status: 'upcoming' as const },
  { label: 'Environmental review', status: 'upcoming' as const },
  { label: 'Final design & permitting', status: 'upcoming' as const },
  { label: 'Build', status: 'upcoming' as const },
  { label: 'Monitor & maintain', status: 'upcoming' as const },
];

---

<BaseLayout
  title="Progress"
  description="Track the Bluffline's progress — a 20-mile regional transportation program advancing through coordinated planning and public investment."
>
  <!-- Section 1: Hero -->
  <PageHero
    label={d.heroLabel}
    title={d.heroTitle}
    description={d.heroDescription}
    keywords={["disciplined"]}
    heroImage="/images/sites/chimney-park-railroad-tracks.jpg"
    heroImageAlt="Railroad tracks along the Bluffline corridor at Chimney Park"
  />

  <!-- Section 2: The Program Arc -->
  <section class="program-arc-section">
    <div class="program-arc-inner">
      <div class="program-arc-header">
        <p class="section-label">The Process</p>
        <h2>How the Bluffline advances</h2>
        <p>The Bluffline will be built through a structured, stage-gated process. Each phase produces specific deliverables and a clear decision point before the next begins &mdash; ensuring that every dollar is spent on the right work at the right time, and that communities shape decisions before engineering locks them in.</p>
      </div>

      <div class="stage-diagram-container">
        <PhaseTracker
          phases={programStages}
          variant="dark"
        />
      </div>

      <div class="arc-details">
        <div class="arc-detail-card">
          <h3>Community before concrete</h3>
          <p>There is no predetermined alignment for the Bluffline. The corridor shown on the map is a planning area &mdash; the geography being studied. Where the trail actually goes will be the product of sustained community engagement, feasibility analysis, and design work at each section. That's the whole point of stages 1 through 3: communities define the vision before engineers draw the lines.</p>
        </div>
        <div class="arc-detail-card">
          <h3>Funded in phases, not all at once</h3>
          <p>Different parts of the corridor will move through these stages at different paces, depending on funding. We are actively pursuing federal, state, and local funding to advance the next phases &mdash; and we will move where funding allows. What won't change is the process: every segment goes through the same rigorous planning before a shovel goes in the ground.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Planning Bridge -->
  <section class="planning-bridge-section">
    <div class="planning-bridge-inner">
      <div class="planning-bridge-content">
        <p class="section-label">The Foundation</p>
        <h2>Grounded in adopted plans</h2>
        <p>Every segment of the Bluffline corridor appears in at least one adopted plan from a local, regional, or state agency. This isn't coincidence — it reflects a consistent regional vision that has emerged through multiple public planning processes over the past two decades, backed by the City of Pensacola, Escambia County, the Florida-Alabama Transportation Planning Organization, and the State of Florida.</p>
        <a href="/progress/planning" class="btn btn-outline">See the plans &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Section 4: Program Map + Project Cards -->
  <section class="map-projects-section">
    <div class="map-projects-inner">
      <div class="map-column">
        <CorridorMap
          allProjectSegments={allProjectSegments}
          interactive={true}
        />
      </div>
      <div class="cards-column">
        <div class="cards-heading">
          <p class="section-label">Current Funding</p>
          <h2>Active Projects</h2>
          <p>Each funded project advances a section of the planning corridor shown at left. The specific alignment will be determined through the master planning process. Hover a project to see its geography.</p>
        </div>
        <div class="project-list" id="project-list">
          {projects.map((project) => (
            <ProjectCard
              project={project.data}
              href={`/progress/projects/${project.id}`}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Updates Feed -->
  <section class="updates-feed">
    <div class="updates-feed-inner">
      <div class="updates-header">
        <div>
          <p class="section-label">From the Field</p>
          <h2>{d.updatesHeading}</h2>
        </div>
        <a href="/progress/updates" class="btn btn-outline">View All Updates</a>
      </div>
      <div class="updates-grid">
        {updates.map(update => (
          <UpdateCard
            title={update.data.title}
            date={update.data.pubDate}
            excerpt={update.data.description}
            slug={update.slug}
            featuredImage={update.data.featuredImage}
            featuredImageAlt={update.data.featuredImageAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 6: Call to Action -->
  <CallToAction
    title={d.ctaTitle}
    description={d.ctaDescription}
    primaryLabel="Subscribe"
    kitFormId="3f946cf4ba"
    variant="mist"
  />
</BaseLayout>

<style>
  /* ============================================
     Section 3: Planning Bridge
     ============================================ */
  .planning-bridge-section {
    padding: 5rem 0;
    background: var(--warm-white);
  }
  @media (min-width: 768px) {
    .planning-bridge-section { padding: 7rem 0; }
  }

  .planning-bridge-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 768px) {
    .planning-bridge-inner { padding: 0 3rem; }
  }

  .planning-bridge-content {
    max-width: 680px;
  }
  .planning-bridge-content h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .planning-bridge-content p {
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.8;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  /* ============================================
     Section 4: Map + Project Cards
     ============================================ */
  .map-projects-section {
    padding: 0;
    background: var(--cream);
  }

  .map-projects-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 1024px) {
    .map-projects-inner {
      max-width: none;
      margin: 0;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      align-items: start;
    }
  }

  .map-column {
    position: relative;
    min-height: 300px;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .map-column {
      position: sticky;
      top: 0;
      height: 100vh;
      align-self: start;
    }
    .map-column :global(.corridor-map-wrapper) {
      height: 100%;
      max-height: none;
      min-height: 0;
    }
  }

  .cards-column {
    padding: 2rem 1.5rem;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .cards-column { padding: 2.5rem 2.5rem; }
  }
  @media (min-width: 1024px) {
    .cards-column {
      padding: 2.5rem 2.5rem;
    }
  }

  .cards-heading {
    margin-bottom: 1.5rem;
  }
  .cards-heading h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .cards-heading p {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.6;
  }

  /* Project list */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project-list :global(.project-card) {
    width: 100%;
  }

  :global(.project-card.dimmed-card) {
    opacity: 0.45;
    transition: opacity 0.25s ease;
  }

  /* ============================================
     Section 4: Program Arc
     ============================================ */
  .program-arc-section {
    padding: 5rem 0;
    background: var(--navy);
  }
  @media (min-width: 768px) {
    .program-arc-section { padding: 7rem 0; }
  }
  .program-arc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 768px) {
    .program-arc-inner { padding: 0 3rem; }
  }

  .program-arc-header {
    max-width: 750px;
    margin-bottom: 2rem;
  }
  .program-arc-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: white;
    margin-bottom: 1.25rem;
  }
  .program-arc-header .section-label {
    color: var(--spring);
  }
  .program-arc-header > p:not(.section-label) {
    font-size: 1.05rem;
    color: white;
    opacity: 0.8;
    line-height: 1.65;
  }

  .stage-diagram-container {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .stage-diagram-container {
      padding: 2rem 2.5rem;
    }
  }

  .arc-details {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .arc-details {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
  .arc-detail-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem 2rem;
  }
  .arc-detail-card h3 {
    font-size: 1.1rem;
    color: white;
    margin-bottom: 0.75rem;
  }
  .arc-detail-card p {
    font-size: 0.925rem;
    color: white;
    opacity: 0.75;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     Section 5: Updates Feed
     ============================================ */
  .updates-feed { padding: 5rem 0; background: var(--mist); }
  .updates-feed-inner { max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; }
  @media (min-width: 768px) { .updates-feed-inner { padding: 0 3rem; } }
  .updates-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .updates-header h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
  .updates-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .updates-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .updates-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<script is:inline>
  // Project card ↔ Map interaction
  (function() {
    var cards = document.querySelectorAll('.project-card');
    var leaveTimer = null;

    function resetState() {
      clearTimeout(leaveTimer);
      leaveTimer = null;
      cards.forEach(function(c) { c.classList.remove('dimmed-card'); });
      if (window.blufflineMap) {
        try {
          window.blufflineMap.resetHighlights();
          window.blufflineMap.resetView();
        } catch (e) {}
      }
    }

    cards.forEach(function(card) {
      var projectTitle = card.dataset.projectTitle || '';
      var color = card.dataset.projectColor || '';

      card.addEventListener('mouseenter', function() {
        clearTimeout(leaveTimer);
        leaveTimer = null;
        if (window.blufflineMap) {
          window.blufflineMap.highlightProject(projectTitle, color);
          window.blufflineMap.fitToProject(projectTitle);
        }
        cards.forEach(function(c) {
          if (c !== card) c.classList.add('dimmed-card');
          else c.classList.remove('dimmed-card');
        });
      });

      card.addEventListener('mouseleave', function() {
        leaveTimer = setTimeout(resetState, 80);
      });
    });

    // Immediately reset when the mouse exits the project list entirely
    var list = document.getElementById('project-list');
    if (list) {
      list.addEventListener('mouseleave', function() {
        resetState();
      });
    }
  })();
</script>
