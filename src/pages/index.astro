---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'home');
const d = page.data;
const sbId = 'src/content/pages/home.json';

// Split rich text body on double newlines for paragraph rendering
const aboutParagraphs: string[] = (d.aboutBody || '').split('\n\n').filter(Boolean);
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero" data-sb-object-id={sbId}>
    <div class="hero-content">
      <div class="hero-text">
        <h1 data-sb-field-path="heroTitle">{d.heroTitle}</h1>
        <p data-sb-field-path="heroSubtitle">{d.heroSubtitle}</p>
        <div class="hero-buttons">
          <Button href={d.heroPrimaryCtaLink || '/support'} data-sb-field-path="heroPrimaryCta">{d.heroPrimaryCta || 'Get Involved'}</Button>
          <Button href={d.heroSecondaryCtaLink || '/about'} variant="outline" data-sb-field-path="heroSecondaryCta">{d.heroSecondaryCta || 'Learn More'}</Button>
        </div>
      </div>
      <div class="hero-image">
        <img src={d.heroImage} alt={d.heroImageAlt} data-sb-field-path="heroImage" />
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section about-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="about-grid">
        <div class="about-content">
          <h2 data-sb-field-path="aboutHeading">{d.aboutHeading}</h2>
          <div data-sb-field-path="aboutBody">
            {aboutParagraphs.map((p: string) => <p>{p}</p>)}
          </div>
          <a href={d.aboutLinkHref || '/about'} class="text-link" data-sb-field-path="aboutLinkText">{d.aboutLinkText || 'Learn more about our history and mission →'}</a>
        </div>
        <div class="about-image">
          <img src={d.aboutImage} alt={d.aboutImageAlt} data-sb-field-path="aboutImage" />
        </div>
      </div>
    </div>
  </section>

  <!-- Challenge -->
  <section class="section challenge-section" data-sb-object-id={sbId}>
    <div class="challenge-grid">
      <div class="challenge-image">
        <img src={d.challengeImage} alt={d.challengeImageAlt} data-sb-field-path="challengeImage" />
      </div>
      <div class="challenge-content">
        <div class="section-label" data-sb-field-path="challengeLabel">{d.challengeLabel || 'The Challenge'}</div>
        <h2 data-sb-field-path="challengeHeading">{d.challengeHeading}</h2>
        <p data-sb-field-path="challengeBody">{d.challengeBody}</p>
        <div class="challenge-stats" data-sb-field-path="challengeStats">
          {d.challengeStats?.map((stat: any, i: number) => (
            <div class="challenge-stat" data-sb-field-path={`.${i}`}>
              <span class="stat-value" data-sb-field-path=".value">{stat.value}</span>
              <span class="stat-description" data-sb-field-path=".description">{stat.description}</span>
            </div>
          ))}
        </div>
        <a href={d.challengeLinkHref || '/about/impact'} class="text-link challenge-link" data-sb-field-path="challengeLinkText">{d.challengeLinkText || 'Explore our full impact case →'}</a>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="section solution-section" data-sb-object-id={sbId}>
    <div class="section-inner">
      <div class="solution-header">
        <div class="section-label" data-sb-field-path="solutionLabel">{d.solutionLabel || 'The Solution'}</div>
        <h2 data-sb-field-path="solutionHeading">{d.solutionHeading}</h2>
        <p data-sb-field-path="solutionBody">{d.solutionBody}</p>
      </div>
      <div class="solution-grid">
        <div class="solution-map">
          <img src={d.solutionMapImage} alt={d.solutionMapImageAlt} data-sb-field-path="solutionMapImage" />
        </div>
        <div class="solution-components" data-sb-field-path="solutionComponents">
          {d.solutionComponents?.map((comp: any, i: number) => (
            <div class="component" data-sb-field-path={`.${i}`}>
              <div class="component-icon" data-sb-field-path=".icon">
                <Fragment set:html={comp.icon} />
              </div>
              <div class="component-text">
                <h3 data-sb-field-path=".title">{comp.title}</h3>
                <p data-sb-field-path=".description">{comp.description}</p>
              </div>
            </div>
          ))}
          <a href={d.solutionLinkHref || '/progress'} class="text-link" data-sb-field-path="solutionLinkText">{d.solutionLinkText || 'See our progress and milestones →'}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section cta-section" data-sb-object-id={sbId}>
    <div class="section-inner cta-inner">
      <h2 data-sb-field-path="ctaHeading">{d.ctaHeading}</h2>
      <p data-sb-field-path="ctaBody">{d.ctaBody}</p>
      <Button href={d.ctaPrimaryHref || '/support'} data-sb-field-path="ctaPrimaryLabel">{d.ctaPrimaryLabel || 'Get Involved'}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--mist) 0%, var(--water) 50%, var(--cream) 100%);
    padding-top: calc(73px + var(--banner-height, 0px));
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 50% at 20% 80%, rgba(153, 204, 99, 0.15), transparent),
                radial-gradient(ellipse 60% 40% at 80% 20%, rgba(201, 251, 255, 0.4), transparent);
    pointer-events: none;
  }
  .hero-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 768px) {
    .hero-content { padding: 6rem 3rem; }
  }
  @media (min-width: 1024px) {
    .hero-content { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }
  .hero-text h1 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .hero-text p {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.8;
    margin-bottom: 2rem;
    max-width: 540px;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-image {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 40px 80px -20px rgba(45, 48, 71, 0.2), 0 20px 40px -10px rgba(65, 82, 31, 0.1);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* About Section */
  .about-section {
    background: var(--warm-white);
  }
  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 0.8fr;
      gap: 4rem;
    }
  }
  .about-content {
    max-width: 650px;
  }
  .about-content h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
  }
  .about-content p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.85;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }
  .about-image {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(45, 48, 71, 0.1);
  }
  .about-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .text-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--forest);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .text-link:hover {
    opacity: 0.7;
  }

  /* Challenge Section */
  .challenge-section {
    background: var(--navy);
    color: white;
    padding: 0;
  }
  .challenge-grid {
    display: grid;
    min-height: 600px;
  }
  @media (min-width: 1024px) {
    .challenge-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .challenge-image {
    position: relative;
    min-height: 300px;
  }
  @media (min-width: 1024px) {
    .challenge-image {
      min-height: auto;
    }
  }
  .challenge-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .challenge-content {
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .challenge-content {
      padding: 5rem 3rem;
    }
  }
  @media (min-width: 1024px) {
    .challenge-content {
      padding: 5rem 4rem 5rem 3rem;
      max-width: 700px;
    }
  }
  .challenge-section .section-label {
    color: var(--spring);
  }
  .challenge-content h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 1.25rem;
  }
  .challenge-content > p {
    font-size: 1.1rem;
    opacity: 0.85;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  .challenge-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .challenge-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-value {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--spring);
    line-height: 1;
  }
  .stat-description {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.4;
  }
  .challenge-link {
    color: var(--spring);
  }
  .challenge-link:hover {
    opacity: 0.8;
  }

  /* Solution Section */
  .solution-section {
    background: var(--cream);
  }
  .solution-header {
    max-width: 700px;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .solution-header {
      margin-bottom: 3.5rem;
    }
  }
  .solution-header h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1.25rem;
  }
  .solution-header p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.75;
  }
  .solution-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .solution-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }
  .solution-map {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(45, 48, 71, 0.1);
  }
  .solution-map img {
    width: 100%;
    height: auto;
    display: block;
  }
  .solution-components {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .component {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .component-icon {
    width: 48px;
    height: 48px;
    background: var(--mist);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .component-icon :global(svg) {
    width: 24px;
    height: 24px;
    color: var(--forest);
  }
  .component-text h3 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .component-text p {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.6;
    margin: 0;
  }

  /* Final CTA */
  .cta-section {
    background: var(--forest);
    color: white;
    text-align: center;
  }
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .cta-section h2 {
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    margin-bottom: 1rem;
  }
  .cta-section p {
    font-size: 1.05rem;
    opacity: 0.85;
    margin-bottom: 2rem;
  }
  .cta-section :global(.btn) {
    background: white;
    color: var(--forest);
  }
  .cta-section :global(.btn:hover) {
    background: var(--spring);
  }
</style>
