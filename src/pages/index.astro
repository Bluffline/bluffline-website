---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Reconnecting Pensacolians to <em>nature</em> and <em>neighbors</em></h1>
        <p>20 miles of waterfront parks, protected trails, and transit connections along Pensacola Bay.</p>
        <div class="hero-buttons">
          <Button href="/support">Get Involved</Button>
          <Button href="/about" variant="outline">Learn More</Button>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/bluffs-aerial-2024.jpg" alt="Aerial view of Pensacola Bay bluffs showing the coastline, railroad, and forested neighborhoods" />
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section about-section">
    <div class="section-inner">
      <div class="about-grid">
        <div class="about-content">
          <h2>A 20-mile vision six decades in the making</h2>
          <p>The Bluffline is a continuous corridor stretching from West Pensacola through downtown to the University of West Florida—reconnecting neighborhoods to Pensacola Bay through parks, trails, and transit.</p>
          <p>Bluffline, Inc. is the designated steward of the Pensacola Scenic Bluffs Scenic Highway and the organization leading this effort. We merged with the Pensacola Scenic Highway Foundation in 2024, uniting over 60 years of community advocacy with a mandate to build.</p>
          <p>In 2025, we secured $1.2 million in federal funding to begin master planning.</p>
          <a href="/about" class="text-link">Learn more about our history and mission →</a>
        </div>
        <div class="about-image">
          <img src="/images/Bowden-Scenic-Highway-Article.jpg" alt="Historic newspaper article about the Pensacola Scenic Highway" />
        </div>
      </div>
    </div>
  </section>

  <!-- Challenge -->
  <section class="section challenge-section">
    <div class="challenge-grid">
      <div class="challenge-image">
        <img src="/images/trail-walk-2022.jpg" alt="People walking along a trail toward Pensacola Bay" />
      </div>
      <div class="challenge-content">
        <div class="section-label">The Challenge</div>
        <h2>A waterfront we can see but can't safely reach</h2>
        <p>Pensacola Bay is our region's greatest natural asset. But for too many neighborhoods, the water is visible yet inaccessible—cut off by rail corridors and highways built for industry, not people.</p>
        <ul class="challenge-facts">
          <li><strong>Zero</strong> protected bike lanes connect West Pensacola to the downtown waterfront</li>
          <li><strong>4,400 households</strong> in the corridor lack access to a vehicle</li>
          <li><strong>17.8%</strong> of Ferry Pass residents live within a 10-minute walk of a park</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="section solution-section">
    <div class="section-inner">
      <div class="solution-header">
        <div class="section-label">The Solution</div>
        <h2>One integrated system for reconnection</h2>
        <p>The Bluffline isn't three separate projects—it's a unified vision for restoring access to the waterfront through interconnected infrastructure.</p>
      </div>
      <div class="solution-grid">
        <div class="solution-map">
          <img src="/images/corridor-map-static.png" alt="Map showing the Bluffline corridor from Corry Station through downtown Pensacola to UWF" />
        </div>
        <div class="solution-components">
          <div class="component">
            <div class="component-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c-4.97 0-9-2.686-9-6v-4c0-3.314 4.03-6 9-6s9 2.686 9 6v4c0 3.314-4.03 6-9 6z"/><path d="M12 6v16"/><path d="M8 10l4-4 4 4"/></svg>
            </div>
            <div class="component-text">
              <h3>Waterfront parks & public access</h3>
              <p>New and enhanced parks restoring public access to Pensacola Bay, including Jackson Lakes, Bayou Chico, and the Scenic Bluffs.</p>
            </div>
          </div>
          <div class="component">
            <div class="component-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="18.5" r="3.5"/><circle cx="5.5" cy="5.5" r="3.5"/><path d="M5.5 9v5a7 7 0 0 0 7 7h0"/><path d="M18.5 15V9a7 7 0 0 0-7-7h0"/></svg>
            </div>
            <div class="component-text">
              <h3>Protected trails & active transportation</h3>
              <p>A continuous network of trails and protected bike lanes providing safe, car-free routes for daily transportation and recreation.</p>
            </div>
          </div>
          <div class="component">
            <div class="component-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>
            </div>
            <div class="component-text">
              <h3>Transit connections</h3>
              <p>Integrated bus connections and future water transit linking neighborhoods to employment centers and the downtown waterfront.</p>
            </div>
          </div>
          <a href="/progress" class="text-link">See our progress and milestones →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section cta-section">
    <div class="section-inner cta-inner">
      <h2>Help build a more connected Pensacola</h2>
      <p>We're entering a master planning phase—and community participation will directly shape outcomes.</p>
      <Button href="/support">Get Involved</Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--mist) 0%, var(--water) 50%, var(--cream) 100%);
    padding-top: 73px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 50% at 20% 80%, rgba(153, 204, 99, 0.15), transparent),
                radial-gradient(ellipse 60% 40% at 80% 20%, rgba(201, 251, 255, 0.4), transparent);
    pointer-events: none;
  }
  .hero-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 768px) {
    .hero-content { padding: 6rem 3rem; }
  }
  @media (min-width: 1024px) {
    .hero-content { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }
  .hero-text h1 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .hero-text h1 em {
    font-style: italic;
    color: var(--forest);
  }
  .hero-text p {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.8;
    margin-bottom: 2rem;
    max-width: 540px;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-image {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 40px 80px -20px rgba(45, 48, 71, 0.2), 0 20px 40px -10px rgba(65, 82, 31, 0.1);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* About Section */
  .about-section {
    background: var(--warm-white);
  }
  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 0.8fr;
      gap: 4rem;
    }
  }
  .about-content {
    max-width: 650px;
  }
  .about-content h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1.5rem;
  }
  .about-content p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.85;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }
  .about-image {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(45, 48, 71, 0.1);
  }
  .about-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .text-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--forest);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .text-link:hover {
    opacity: 0.7;
  }

  /* Challenge Section */
  .challenge-section {
    background: var(--navy);
    color: white;
    padding: 0;
  }
  .challenge-grid {
    display: grid;
    min-height: 600px;
  }
  @media (min-width: 1024px) {
    .challenge-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .challenge-image {
    position: relative;
    min-height: 300px;
  }
  @media (min-width: 1024px) {
    .challenge-image {
      min-height: auto;
    }
  }
  .challenge-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .challenge-content {
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .challenge-content {
      padding: 5rem 3rem;
    }
  }
  @media (min-width: 1024px) {
    .challenge-content {
      padding: 5rem 4rem 5rem 3rem;
      max-width: 700px;
    }
  }
  .challenge-section .section-label {
    color: var(--spring);
  }
  .challenge-content h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 1.25rem;
  }
  .challenge-content > p {
    font-size: 1.1rem;
    opacity: 0.85;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  .challenge-facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .challenge-facts li {
    font-size: 1rem;
    opacity: 0.9;
    padding-left: 1.5rem;
    position: relative;
  }
  .challenge-facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    background: var(--spring);
    border-radius: 50%;
  }
  .challenge-facts strong {
    color: var(--spring);
  }

  /* Solution Section */
  .solution-section {
    background: var(--cream);
  }
  .solution-header {
    max-width: 700px;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .solution-header {
      margin-bottom: 3.5rem;
    }
  }
  .solution-header h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--navy);
    margin-bottom: 1.25rem;
  }
  .solution-header p {
    font-size: 1.1rem;
    color: var(--navy);
    opacity: 0.75;
  }
  .solution-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .solution-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }
  .solution-map {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(45, 48, 71, 0.1);
  }
  .solution-map img {
    width: 100%;
    height: auto;
    display: block;
  }
  .solution-components {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .component {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .component-icon {
    width: 48px;
    height: 48px;
    background: var(--mist);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .component-icon svg {
    width: 24px;
    height: 24px;
    color: var(--forest);
  }
  .component-text h3 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .component-text p {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.6;
    margin: 0;
  }

  /* Final CTA */
  .cta-section {
    background: var(--forest);
    color: white;
    text-align: center;
  }
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .cta-section h2 {
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    margin-bottom: 1rem;
  }
  .cta-section p {
    font-size: 1.05rem;
    opacity: 0.85;
    margin-bottom: 2rem;
  }
  .cta-section :global(.btn) {
    background: white;
    color: var(--forest);
  }
  .cta-section :global(.btn:hover) {
    background: var(--spring);
  }
</style>
