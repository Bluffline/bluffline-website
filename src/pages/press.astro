---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import PressCard from '../components/content/PressCard.astro';
import CallToAction from '../components/ui/CallToAction.astro';

// Group press by year
const pressData = [
  { outlet: "Pensacola News Journal", title: "Bluffline awarded $1.2M to study Pensacola-area waterfront access", date: new Date("2025-01-15"), link: "https://www.pnj.com/story/news/local/2025/01/15/bluffline-awarded-1-2m-to-study-pensacola-area-waterfront-access/77599741007/", type: "article" as const },
  { outlet: "WEAR-TV", title: "Bluffline receives $1.2 million for Escambia Bay Waterfront Access Study", date: new Date("2025-01-15"), link: "https://weartv.com/news/local/bluffline-receives-1-2-million-for-escambia-bay-waterfront-access-study", type: "tv" as const },
  { outlet: "Rick's Blog", title: "Bluffline secures $1.2 million DOT grant", date: new Date("2025-01-15"), link: "https://ricksblog.biz/bluffline-secures-1-2-million-dot-grant/", type: "article" as const },
  { outlet: "Pensacola News Journal", title: "Bluffline looks to add 15 miles of trails to Escambia County", date: new Date("2024-07-26"), link: "https://www.pnj.com/story/news/local/escambia-county/2024/07/26/bluffline-project-aims-to-develop-pensacolas-jackson-lakes/74509306007/", type: "article" as const },
  { outlet: "Pensacola News Journal", title: "Pensacola's Bay Bluffs Park boardwalk likely to be demolished", date: new Date("2023-09-18"), link: "https://www.pnj.com/story/news/local/pensacola/2023/09/18/pensacolas-bay-bluffs-park-boardwalk-likely-to-be-demolished/70840691007/", type: "article" as const },
  { outlet: "WKRG-TV", title: "Bands on the Bayou to host final free concert of 2023", date: new Date("2023-09-14"), link: "https://www.wkrg.com/northwest-florida/escambia-county/bands-on-the-bayou-to-host-final-free-concert-of-2023-on-friday/", type: "tv" as const },
  { outlet: "WUWF", title: "Bluffline works to create sustainable connection around Pensacola", date: new Date("2023-05-29"), link: "https://www.wuwf.org/local-news/2023-05-24/the-bluffline-project-works-to-create-a-sustainable-connection-around-pensacola", type: "radio" as const },
  { outlet: "WKRG-TV", title: "Local organization wants 10-mile greenway to connect East and West Pensacola", date: new Date("2023-05-16"), link: "https://www.wkrg.com/northwest-florida/escambia-county/local-organization-wants-10-mile-greenway-to-connect-east-and-west-pensacola/", type: "tv" as const },
];

// Group by year
const pressByYear = pressData.reduce((acc, item) => {
  const year = item.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {} as Record<number, typeof pressData>);

const years = Object.keys(pressByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout 
  title="Press" 
  description="Media coverage and press resources for the Bluffline — Pensacola's 20-mile multimodal corridor."
>
  <PageHero
    label="Press"
    title="In the news"
    description="Media coverage of the Bluffline's progress, from local newspapers to regional television."
  />

  <section class="coverage-section">
    <div class="section-inner">
      {years.map(year => (
        <div class="year-group">
          <h3 class="year-label">{year}</h3>
          <div class="articles-grid">
            {pressByYear[Number(year)].map(item => (
              <PressCard
                outlet={item.outlet}
                title={item.title}
                date={item.date}
                link={item.link}
                type={item.type}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="press-kit-section">
    <div class="section-inner">
      <div class="section-header">
        <h2>Press Resources</h2>
        <p>Everything journalists need to cover the Bluffline.</p>
      </div>
      <div class="press-kit-grid">
        <div class="press-kit-card">
          <h3>Boilerplate</h3>
          <div class="boilerplate">
            <p>Bluffline, Inc. is a 501(c)(3) nonprofit organization advancing a 20-mile multimodal corridor connecting the University of West Florida to Naval Air Station Pensacola. As the Corridor Management Entity for the Pensacola Scenic Bay Bluffs Highway, the Bluffline is building safe, connected infrastructure for walking, cycling, and water transit that will reconnect communities to Pensacola's waterfront.</p>
          </div>
        </div>
        <div class="press-kit-card">
          <h3>Logo Downloads</h3>
          <p>High-resolution logos for print and digital use.</p>
          <div class="logo-downloads">
            <a href="#" class="logo-download">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              PNG (Light)
            </a>
            <a href="#" class="logo-download">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              PNG (Dark)
            </a>
            <a href="#" class="logo-download">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              SVG
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="section-inner">
      <div class="contact-card">
        <h3>Media Contact</h3>
        <p>For press inquiries, interviews, or additional information:</p>
        <div class="contact-info">
          <div class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:press@bluffline.org">press@bluffline.org</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Support the Bluffline"
    description="Help us build the infrastructure that will transform how Pensacola moves, plays, and connects."
    primaryLabel="Get Involved"
    primaryHref="/support"
  />
</BaseLayout>

<style>
  .coverage-section { padding: 4rem 0; background: var(--cream); }
  .year-group { margin-bottom: 3rem; }
  .year-group:last-child { margin-bottom: 0; }
  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--spring);
    display: inline-block;
  }
  .articles-grid { display: grid; gap: 1rem; }

  .press-kit-section { padding: 5rem 0; background: var(--warm-white); }
  .press-kit-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .press-kit-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .press-kit-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid rgba(45, 48, 71, 0.06);
  }
  .press-kit-card h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 1rem; }
  .press-kit-card p { font-size: 0.95rem; color: var(--navy); opacity: 0.75; margin-bottom: 1.5rem; }
  .boilerplate {
    background: var(--mist);
    border-radius: 8px;
    padding: 1.25rem;
    font-size: 0.9rem;
    color: var(--navy);
    line-height: 1.7;
  }
  .boilerplate p { margin-bottom: 0; opacity: 1; }
  .logo-downloads { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .logo-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--mist);
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--forest);
    transition: all 0.2s ease;
  }
  .logo-download:hover { background: var(--forest); color: white; }
  .logo-download svg { width: 16px; height: 16px; }

  .contact-section { padding: 0 0 5rem; background: var(--warm-white); }
  .contact-card {
    max-width: 600px;
    background: white;
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid rgba(45, 48, 71, 0.08);
  }
  .contact-card h3 { font-size: 1.25rem; color: var(--navy); margin-bottom: 0.5rem; }
  .contact-card p { font-size: 0.95rem; color: var(--navy); opacity: 0.75; margin-bottom: 1.5rem; }
  .contact-info { display: flex; flex-direction: column; gap: 0.75rem; }
  .contact-item { display: flex; align-items: center; gap: 0.75rem; font-size: 0.95rem; color: var(--navy); }
  .contact-item svg { width: 20px; height: 20px; color: var(--forest); flex-shrink: 0; }
  .contact-item a { color: var(--forest); text-decoration: none; font-weight: 500; }
  .contact-item a:hover { text-decoration: underline; }
</style>
