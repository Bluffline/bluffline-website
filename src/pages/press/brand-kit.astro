---
import PressLayout from '../../layouts/PressLayout.astro';
import MediaLightbox from '../../components/ui/MediaLightbox.astro';
import Tabs from '../../components/ui/Tabs.astro';
import EmptyStateCard from '../../components/content/EmptyStateCard.astro';
import MediaPhotoCard from '../../components/content/MediaPhotoCard.astro';
import MediaVideoCard from '../../components/content/MediaVideoCard.astro';
import MediaAudioItem from '../../components/content/MediaAudioItem.astro';
import { getCollection, getEntry } from 'astro:content';
import { getMediaAssetsFromDirectory, extractImageMetadata } from '../../utils/media-metadata';
import type { MediaMetadata } from '../../utils/media-metadata';
import path from 'node:path';
import fs from 'node:fs';
import brandColors from '../../data/brand-colors.json';
import mediaKitPhotos from '../../data/media-kit-photos.json';

const page = await getEntry('pages', 'press');
const pd = page.data;

// Fetch press releases
const pressReleases = await getCollection('press-releases', ({ data }) => !data.draft);
const sortedReleases = pressReleases.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Collect media from press releases for asset propagation (8.4)
const pressReleaseMedia = sortedReleases
  .filter(r => r.data.media && r.data.media.length > 0)
  .flatMap(r => (r.data.media || []).map((m: { src: string; alt?: string; caption?: string; credit?: string; type: string }) => ({
    src: m.src,
    title: m.alt || m.caption || 'Press release media',
    type: m.type === 'video' ? 'video' as const : 'image' as const,
    description: m.caption || '',
    credit: m.credit || 'Bluffline, Inc.',
    format: m.src.split('.').pop()?.toUpperCase() || '',
    size: '',
    dimensions: '',
    date: '',
    videoType: m.type === 'video' ? (() => { const ext = m.src.split('.').pop()?.toLowerCase() || ''; return ext === 'webm' ? 'video/webm' : ext === 'mov' ? 'video/quicktime' : 'video/mp4'; })() : undefined,
  })));

// Load media kit assets with embedded metadata extraction
const publicDir = path.join(process.cwd(), 'public');

const logos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'logos'),
  '/media-kit/logos',
  'image'
);

const photos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'photos'),
  '/media-kit/photos',
  'image'
);

const videos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'videos'),
  '/media-kit/videos',
  'video'
);

const audio = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'audio'),
  '/media-kit/audio',
  'audio'
);

// Brand Kit: icon set (Lucide, ISC) from public/media-kit/icons
const iconsDir = path.join(publicDir, 'media-kit', 'icons');
const brandIcons = fs.existsSync(iconsDir)
  ? fs.readdirSync(iconsDir)
      .filter(f => f.endsWith('.svg'))
      .sort()
      .map(file => {
        const raw = fs.readFileSync(path.join(iconsDir, file), 'utf8');
        const svg = raw.replace(/<!--[\s\S]*?-->/g, '').replace(/\s*class="[^"]*"/, '').trim();
        return { name: file.replace(/\.svg$/, ''), src: `/media-kit/icons/${file}`, svg };
      })
  : [];

// Brand Kit: typography (mirrors the Brand Kit PDF and the fonts loaded in BaseLayout)
const typefaces = [
  {
    name: 'Fraunces',
    role: 'Display serif',
    description: 'Every headline and every big number. Set light, set tight, and let it breathe. Sentence case always. Never used for body copy, captions, buttons, or UI labels.',
    family: "'Fraunces', serif",
    fallback: 'Georgia, Times New Roman, serif',
    sample: 'Reconnecting',
    weights: [
      { label: 'Light 300', use: 'Heroes, H1, H2', weight: 300, italic: false },
      { label: 'Regular 400', use: 'H3, pull quotes', weight: 400, italic: false },
      { label: 'Medium 500', use: 'Stat figures, H4', weight: 500, italic: false },
      { label: 'Italic 400', use: 'The keyword flourish', weight: 400, italic: true },
    ],
    downloadUrl: 'https://fonts.google.com/specimen/Fraunces',
  },
  {
    name: 'Source Sans 3',
    role: 'Body sans',
    description: 'Body copy, UI, and every label. Generous line-height, light to semibold, nothing heavier. Uppercase only for small eyebrow labels, letter-spaced 0.15em.',
    family: "'Source Sans 3', sans-serif",
    fallback: 'system-ui, Segoe UI, sans-serif',
    sample: 'Corridor',
    weights: [
      { label: 'Light 300', use: 'Lead paragraphs', weight: 300, italic: false },
      { label: 'Regular 400', use: 'Body copy, captions', weight: 400, italic: false },
      { label: 'Medium 500', use: 'Buttons, nav', weight: 500, italic: false },
      { label: 'Semibold 600', use: 'Eyebrow labels, emphasis', weight: 600, italic: false },
    ],
    downloadUrl: 'https://fonts.google.com/specimen/Source+Sans+3',
  },
];

const typeScale = [
  { name: 'Hero headline', spec: '32–56 px · Fraunces 300 · line-height 1.2' },
  { name: 'Section heading', spec: '28–40 px · Fraunces 300 · line-height 1.2' },
  { name: 'Card heading', spec: '18 px · Fraunces 500 · line-height 1.35' },
  { name: 'Lead paragraph', spec: '18.4 px · Source Sans 300 · line-height 1.7' },
  { name: 'Body copy', spec: '16 px · Source Sans 400 · line-height 1.7' },
  { name: 'Caption / metadata', spec: '14.4 px · Source Sans 400 · line-height 1.5' },
  { name: 'Eyebrow label', spec: '13.6 px · Source Sans 600 · uppercase · +0.15em tracking' },
  { name: 'Display stat', spec: '32 px · Fraunces 500 · line-height 1.0' },
];

const fontEmbedCode = `<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">`;

// Curated captions/credits for photos in the kit (src/data/media-kit-photos.json).
// Entries under /images/ pull photos already used across the site into the kit;
// entries under /media-kit/photos/ override metadata for files in that folder.
type CuratedPhoto = { src: string; title?: string; description?: string; credit?: string; date?: string };
const curatedPhotos = mediaKitPhotos as CuratedPhoto[];
const curatedBySrc = new Map(curatedPhotos.map(p => [p.src, p]));

const applyCurated = (asset: MediaMetadata): MediaMetadata => {
  const c = curatedBySrc.get(asset.src);
  if (!c) return asset;
  return {
    ...asset,
    title: c.title || asset.title,
    description: c.description || asset.description,
    credit: c.credit || asset.credit,
    date: c.date || asset.date,
  };
};

const sitePhotos = await Promise.all(
  curatedPhotos
    .filter(p => !p.src.startsWith('/media-kit/photos/'))
    .filter(p => fs.existsSync(path.join(publicDir, p.src)))
    .map(p => extractImageMetadata(path.join(publicDir, p.src), p.src).then(applyCurated))
);

// Merge media-kit photos, site photos, and press release photos (deduped by src)
const seenPhotoSrcs = new Set<string>();
const allPhotos = [
  ...photos.map(applyCurated),
  ...sitePhotos,
  ...pressReleaseMedia.filter(m => m.type === 'image'),
].filter(m => {
  if (seenPhotoSrcs.has(m.src)) return false;
  seenPhotoSrcs.add(m.src);
  return true;
});
const allVideos = [...videos, ...pressReleaseMedia.filter(m => m.type === 'video')];

// Asset type tabs configuration
const assetTabs = [
  { id: 'logos', label: 'Logos' },
  { id: 'colors', label: 'Colors' },
  { id: 'typography', label: 'Typography' },
  { id: 'icons', label: 'Icons' },
  { id: 'photos', label: 'Photos' },
  { id: 'videos', label: 'Videos' },
  { id: 'audio', label: 'Audio' },
];
---

<PressLayout
  section="brand-kit"
  title="Brand Kit"
  description="Bluffline logos, colors, typography, icons, and photography, with the rules for using them."
  heroTitle={pd.sections.brandKit.title}
  heroDescription={pd.sections.brandKit.description}
>
  <div class="media-kit-intro">
    <p>The Bluffline visual identity, drawn from the live site: logos, colors, type, icons, and photography, with the rules for using them. Use it for anything that carries the Bluffline name. Logos and photos are free for editorial and partner use with attribution to Bluffline, Inc.</p>
    <p class="kit-actions-note">Anything that bends a rule here, or needs assets not shown, ask <a href={`mailto:${pd.mediaContactEmail}`}>{pd.mediaContactEmail}</a> before you publish.</p>
  </div>

  <!-- Boilerplate Section -->
  <div class="media-kit-section">
    <h3 class="media-kit-section-title">About the Bluffline</h3>
    <div class="boilerplate-card">
      <div class="boilerplate">
        <p>{pd.boilerplate}</p>
      </div>
      <div class="boilerplate-actions">
        <button class="copy-boilerplate" data-copy-target=".boilerplate p" aria-label="Copy boilerplate text">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          Copy to clipboard
        </button>
      </div>
    </div>
  </div>

  <!-- Assets Section with Sub-tabs -->
  <div class="media-kit-section">
    <h3 class="media-kit-section-title">Assets</h3>
    <p class="media-kit-section-desc">Logos, colors, type, icons, and media for editorial, partner, and design use.</p>

    <Tabs id="assets" tabs={assetTabs} defaultTab="logos" variant="pills">
      <!-- Logos Panel -->
      <div data-tab-panel="logos" class="active">
        {logos.length > 0 ? (
          <div class="media-grid media-grid-logos">
            {logos.map((asset) => (
              <button
                class="media-item"
                data-lightbox-trigger
                data-media-src={asset.src}
                data-media-type={asset.type}
                data-media-title={asset.title}
                data-media-description={asset.description}
                data-media-format={asset.format}
                data-media-dimensions={asset.dimensions}
                data-media-size={asset.size}
                data-media-credit={asset.credit}
                data-media-date={asset.date}
                data-media-download={asset.src}
                data-media-filename={asset.src.split('/').pop()}
              >
                <div class="media-item-preview logo-preview">
                  <img src={asset.src} alt={asset.title} loading="lazy" />
                </div>
                <div class="media-item-info">
                  <span class="media-item-title">{asset.title}</span>
                  <span class="media-item-meta">{asset.format}{asset.size && ` · ${asset.size}`}</span>
                </div>
                <div class="media-item-actions">
                  <span class="preview-hint">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Preview
                  </span>
                </div>
              </button>
            ))}
          </div>
        ) : (
          <EmptyStateCard
            title="No logos available"
            description="Logo files will be available here when uploaded."
            icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`}
          />
        )}
        <div class="kit-notes">
          <h4 class="kit-notes-title">Using the logo</h4>
          <ul>
            <li>Two arcs trace the bluffs above the bay, spring green rising into forest green, over a navy wordmark. It is the only Bluffline mark. Never redraw it or set the name in another typeface.</li>
            <li>Keep clear space on all four sides equal to the height of the wordmark.</li>
            <li>Minimum size: 120 px wide on screen, 1.5 in wide in print.</li>
            <li>Use the standard lockup on warm white, cream, mist, or a light photo scrim. Use the reverse lockup on navy, forest, or dark photography.</li>
            <li>Never stretch, rotate, recolor, or add shadows, outlines, or gradients to the mark.</li>
          </ul>
        </div>
      </div>

      <!-- Typography Panel -->
      <div data-tab-panel="typography" hidden>
        <div class="color-palette-intro">
          <p>Two open-licensed typefaces from Google Fonts. Fraunces carries every headline; Source Sans 3 carries everything else.</p>
        </div>
        <div class="type-grid">
          {typefaces.map(face => (
            <div class="type-card">
              <div class="type-sample" style={`font-family: ${face.family};`} aria-hidden="true">Aa</div>
              <div class="type-info">
                <span class="type-role">{face.role}</span>
                <span class="type-name">{face.name}</span>
                <p class="type-desc">{face.description}</p>
                <ul class="type-weights">
                  {face.weights.map(w => (
                    <li>
                      <span class="type-weight-sample" style={`font-family: ${face.family}; font-weight: ${w.weight}; font-style: ${w.italic ? 'italic' : 'normal'};`}>{face.sample}</span>
                      <span class="type-weight-meta"><strong>{w.label}</strong> · {w.use}</span>
                    </li>
                  ))}
                </ul>
                <span class="type-fallback"><strong>Fallback:</strong> {face.fallback}</span>
                <a class="kit-download kit-download-small" href={face.downloadUrl} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  Download from Google Fonts
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="type-scale-card">
          <h4 class="kit-notes-title">Type scale</h4>
          <dl class="type-scale">
            {typeScale.map(row => (
              <div class="type-scale-row">
                <dt>{row.name}</dt>
                <dd>{row.spec}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="type-embed-card">
          <div class="type-embed-header">
            <h4 class="kit-notes-title">Web embed</h4>
            <button class="copy-boilerplate" data-copy-target="#font-embed-code" aria-label="Copy font embed code">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              Copy to clipboard
            </button>
          </div>
          <pre class="type-embed"><code id="font-embed-code">{fontEmbedCode}</code></pre>
          <p class="type-embed-note">Both typefaces are licensed under the SIL Open Font License. For print and offline decks, download the font files from Google Fonts and embed them.</p>
        </div>
      </div>

      <!-- Icons Panel -->
      <div data-tab-panel="icons" hidden>
        <div class="color-palette-intro">
          <p>Line-drawn, evenly weighted, quietly functional. Icons label things; they never decorate. The set is <a href="https://lucide.dev" target="_blank" rel="noopener noreferrer">Lucide</a> (ISC license): take new icons from there rather than drawing them.</p>
        </div>
        {brandIcons.length > 0 ? (
          <div class="icon-grid">
            {brandIcons.map(icon => (
              <a class="icon-tile" href={icon.src} download title={`Download ${icon.name}.svg`}>
                <span class="icon-tile-glyph" set:html={icon.svg} />
                <span class="icon-tile-name">{icon.name}</span>
                <span class="icon-tile-hint">SVG</span>
              </a>
            ))}
          </div>
        ) : (
          <EmptyStateCard
            title="No icons available"
            description="Icon files will be available here when uploaded."
            icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/></svg>`}
          />
        )}
        <div class="kit-notes">
          <h4 class="kit-notes-title">Specification</h4>
          <ul>
            <li>24 × 24 viewBox, 2 px stroke, no fill, round caps and joins. Colored with <code>currentColor</code> so they inherit the text around them.</li>
            <li>Rendered at 12–24 px. Never scale an icon above 24 px; enlarge the container instead.</li>
            <li>Never fill an icon, mix filled and outlined glyphs, change the stroke weight, or use an icon as decoration where a label would do.</li>
            <li>No icon fonts, no filled glyphs, no emoji anywhere in the product.</li>
          </ul>
        </div>
      </div>

      <!-- Photos Panel -->
      <div data-tab-panel="photos" hidden>
        {allPhotos.length > 0 ? (
          <div class="media-grid media-grid-photos">
            {allPhotos.map((asset) => (
              <MediaPhotoCard
                src={asset.src}
                title={asset.title}
                description={asset.description}
                format={asset.format}
                dimensions={asset.dimensions}
                size={asset.size}
                credit={asset.credit || 'Bluffline, Inc.'}
                date={asset.date}
              />
            ))}
          </div>
        ) : (
          <EmptyStateCard
            title="No photos available"
            description="Photos will be available here when uploaded."
            icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`}
          />
        )}
      </div>

      <!-- Videos Panel -->
      <div data-tab-panel="videos" hidden>
        {allVideos.length > 0 ? (
          <div class="media-grid media-grid-videos">
            {allVideos.map((asset) => (
              <MediaVideoCard
                src={asset.src}
                title={asset.title}
                description={asset.description}
                videoType={asset.videoType}
                format={asset.format}
                size={asset.size}
                credit={asset.credit || 'Bluffline, Inc.'}
                date={asset.date}
              />
            ))}
          </div>
        ) : (
          <EmptyStateCard
            title="No videos available"
            description="Videos will be available here when uploaded."
            icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>`}
          />
        )}
      </div>

      <!-- Audio Panel -->
      <div data-tab-panel="audio" hidden>
        {audio.length > 0 ? (
          <div class="audio-list">
            {audio.map((asset) => (
              <MediaAudioItem
                src={asset.src}
                title={asset.title}
                audioType={asset.audioType}
                format={asset.format}
                size={asset.size}
                credit={asset.credit}
              />
            ))}
          </div>
        ) : (
          <EmptyStateCard
            title="No audio files available"
            description="Audio files will be available here when uploaded."
            icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`}
          />
        )}
      </div>
      <!-- Color Palette Panel -->
      <div data-tab-panel="colors" hidden>
        <div class="color-palette-intro">
          <p>Official Bluffline brand colors. Values are sourced directly from the site's design tokens.</p>
        </div>
        <div class="color-palette-grid">
          {brandColors.map((color: { name: string; variable: string; hex: string; rgb: string; usage: string }) => (
            <div class="color-swatch-card">
              <div class="color-swatch" style={`background-color: ${color.hex};`}></div>
              <div class="color-info">
                <span class="color-name">{color.name}</span>
                <div class="color-values">
                  <span class="color-value"><strong>Hex:</strong> {color.hex}</span>
                  <span class="color-value"><strong>RGB:</strong> {color.rgb}</span>
                  <span class="color-value"><strong>CSS:</strong> var({color.variable})</span>
                </div>
                <span class="color-usage">{color.usage}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Tabs>
  </div>

  <!-- Media Contact Section -->
  <div class="media-kit-section">
    <h3 class="media-kit-section-title">Media Contact</h3>
    <div class="contact-card">
      <p>For press inquiries, interviews, or additional information:</p>
      <div class="contact-info">
        <div class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <a href={`mailto:${pd.mediaContactEmail}`}>{pd.mediaContactEmail}</a>
        </div>
      </div>
    </div>
  </div>

  <MediaLightbox />
</PressLayout>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-boilerplate[data-copy-target]').forEach(copyBtn => {
      const source = document.querySelector(copyBtn.dataset.copyTarget || '');
      initCopyButton(copyBtn, source);
    });
  }

  function initCopyButton(copyBtn: HTMLButtonElement, source: Element | null) {
    copyBtn.addEventListener('click', async () => {
      if (!source) return;

      const text = source.textContent || '';

      try {
        await navigator.clipboard.writeText(text);

        // Update button to show success
        const originalHTML = copyBtn.innerHTML;
        copyBtn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Copied!
        `;
        copyBtn.classList.add('copied');

        setTimeout(() => {
          copyBtn.innerHTML = originalHTML;
          copyBtn.classList.remove('copied');
        }, 2000);
      } catch {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  }

  initCopyButtons();
</script>

<style>
  /* Media Kit Styles */
  .media-kit-intro {
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.85;
  }

  .media-kit-section {
    margin-bottom: 3rem;
  }

  .media-kit-section:last-child {
    margin-bottom: 0;
  }

  .media-kit-section-title {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .media-kit-section-desc {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .kit-actions-note {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-top: 0.75rem;
  }

  .kit-actions-note a {
    color: var(--forest);
    text-decoration: underline;
  }

  .kit-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    background: var(--forest);
