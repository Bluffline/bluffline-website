---
import PressLayout from '../../layouts/PressLayout.astro';
import PressCard from '../../components/content/PressCard.astro';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'press');
const pd = page.data;

// Fetch press coverage (external news)
const pressItems = await getCollection('press');
const sortedPress = pressItems.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group press by year
const pressByYear = sortedPress.reduce((acc, item) => {
  const year = item.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {} as Record<number, typeof sortedPress>);

const years = Object.keys(pressByYear).sort((a, b) => Number(b) - Number(a));
---

<PressLayout
  section="news"
  title="Press"
  description="Media coverage of the Bluffline, Pensacola's 20-mile multimodal corridor."
  heroTitle={pd.sections.news.title}
  heroDescription={pd.sections.news.description}
>
  <script is:inline slot="head">
    // The three press sections used to be tabs on this page addressed by hash.
    (function () {
      var moved = { '#releases': '/press/releases', '#brand-kit': '/press/brand-kit', '#media-kit': '/press/brand-kit' };
      var target = moved[window.location.hash];
      if (target) window.location.replace(target);
    })();
  </script>

  {years.map(year => (
    <div class="year-group">
      <h3 class="year-label">{year}</h3>
      <div class="articles-grid">
        {pressByYear[Number(year)].map(item => (
          <PressCard
            outlet={item.data.outlet}
            title={item.data.title}
            date={item.data.date}
            link={item.data.link}
            type={item.data.mediaType}
          />
        ))}
      </div>
    </div>
  ))}
</PressLayout>

<style>
  .year-group { margin-bottom: 3rem; }
  .year-group:last-child { margin-bottom: 0; }
  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--spring);
    display: inline-block;
  }
  .year-group:last-child { margin-bottom: 0; }
  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--spring);
    display: inline-block;
  }
  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--spring);
    display: inline-block;
  }
  .articles-grid { display: grid; gap: 1rem; }

  .releases-grid {
    display: grid;
    gap: 1.5rem;
  }
</style>
