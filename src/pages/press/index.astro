---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PressCard from '../../components/content/PressCard.astro';
import PressReleaseCard from '../../components/content/PressReleaseCard.astro';
import CallToAction from '../../components/ui/CallToAction.astro';
import MediaLightbox from '../../components/ui/MediaLightbox.astro';
import { getCollection } from 'astro:content';
import { getMediaAssetsFromDirectory } from '../../utils/media-metadata';
import path from 'node:path';

// Fetch press coverage (external news)
const pressItems = await getCollection('press');
const sortedPress = pressItems.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group press by year
const pressByYear = sortedPress.reduce((acc, item) => {
  const year = item.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {} as Record<number, typeof sortedPress>);

const years = Object.keys(pressByYear).sort((a, b) => Number(b) - Number(a));

// Fetch press releases
const pressReleases = await getCollection('press-releases', ({ data }) => !data.draft);
const sortedReleases = pressReleases.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Load media kit assets with embedded metadata extraction
const publicDir = path.join(process.cwd(), 'public');

const logos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'logos'),
  '/media-kit/logos',
  'image'
);

const photos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'photos'),
  '/media-kit/photos',
  'image'
);

const videos = await getMediaAssetsFromDirectory(
  path.join(publicDir, 'media-kit', 'videos'),
  '/media-kit/videos',
  'video'
);
---

<BaseLayout
  title="Press"
  description="Media coverage, press releases, and press resources for the Bluffline — Pensacola's 20-mile multimodal corridor."
>
  <PageHero
    label="Press"
    title="News & Press Releases"
    description="Media coverage and official announcements from the Bluffline."
  />

  <section class="tabs-section">
    <div class="section-inner">
      <div class="tabs" role="tablist" aria-label="Press content">
        <button
          role="tab"
          aria-selected="true"
          aria-controls="news-panel"
          id="news-tab"
          class="tab active"
        >
          In the News
        </button>
        <button
          role="tab"
          aria-selected="false"
          aria-controls="releases-panel"
          id="releases-tab"
          class="tab"
          tabindex="-1"
        >
          Press Releases
        </button>
        <button
          role="tab"
          aria-selected="false"
          aria-controls="media-kit-panel"
          id="media-kit-tab"
          class="tab"
          tabindex="-1"
        >
          Media Kit
        </button>
      </div>

      <div
        role="tabpanel"
        id="news-panel"
        aria-labelledby="news-tab"
        class="tab-panel active"
      >
        {years.map(year => (
          <div class="year-group">
            <h3 class="year-label">{year}</h3>
            <div class="articles-grid">
              {pressByYear[Number(year)].map(item => (
                <PressCard
                  outlet={item.data.outlet}
                  title={item.data.title}
                  date={item.data.date}
                  link={item.data.link}
                  type={item.data.type}
                />
              ))}
            </div>
          </div>
        ))}
      </div>

      <div
        role="tabpanel"
        id="releases-panel"
        aria-labelledby="releases-tab"
        class="tab-panel"
        hidden
      >
        {sortedReleases.length > 0 ? (
          <div class="releases-grid">
            {sortedReleases.map(release => (
              <PressReleaseCard
                title={release.data.title}
                pubDate={release.data.pubDate}
                summary={release.data.summary}
                slug={release.slug}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">No press releases available yet.</p>
        )}
      </div>

      <div
        role="tabpanel"
        id="media-kit-panel"
        aria-labelledby="media-kit-tab"
        class="tab-panel"
        hidden
      >
        <div class="media-kit-intro">
          <p>Download official Bluffline logos, photos, and videos for media use. All assets are free to use with proper attribution.</p>
        </div>

        <!-- Boilerplate Section -->
        <div class="media-kit-section">
          <h3 class="media-kit-section-title">About the Bluffline</h3>
          <div class="boilerplate-card">
            <div class="boilerplate">
              <p>Bluffline, Inc. is a 501(c)(3) nonprofit organization advancing a 20-mile multimodal corridor connecting the University of West Florida to Naval Air Station Pensacola. As the Corridor Management Entity for the Pensacola Scenic Bay Bluffs Highway, the Bluffline is building safe, connected infrastructure for walking, cycling, and water transit that will reconnect communities to Pensacola's waterfront.</p>
            </div>
            <div class="boilerplate-actions">
              <button class="copy-boilerplate" aria-label="Copy boilerplate text">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                Copy to clipboard
              </button>
            </div>
          </div>
        </div>

        <!-- Logos Section -->
        <div class="media-kit-section">
          <h3 class="media-kit-section-title">Logos</h3>
          <p class="media-kit-section-desc">High-resolution logos for print and digital use.</p>
          {logos.length > 0 ? (
            <div class="media-grid media-grid-logos">
              {logos.map((asset) => (
                <button
                  class="media-item"
                  data-lightbox-trigger
                  data-media-src={asset.src}
                  data-media-type={asset.type}
                  data-media-title={asset.title}
                  data-media-description={asset.description}
                  data-media-format={asset.format}
                  data-media-dimensions={asset.dimensions}
                  data-media-size={asset.size}
                  data-media-credit={asset.credit}
                  data-media-date={asset.date}
                  data-media-download={asset.src}
                  data-media-filename={asset.src.split('/').pop()}
                >
                  <div class="media-item-preview logo-preview">
                    <img src={asset.src} alt={asset.title} loading="lazy" />
                  </div>
                  <div class="media-item-info">
                    <span class="media-item-title">{asset.title}</span>
                    <span class="media-item-meta">{asset.format}{asset.size && ` · ${asset.size}`}</span>
                  </div>
                  <div class="media-item-actions">
                    <span class="preview-hint">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                      </svg>
                      Preview
                    </span>
                  </div>
                </button>
              ))}
            </div>
          ) : (
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <p class="empty-state-text">Logo files will appear here</p>
              <p class="empty-state-hint">Add logo files to <code>public/media-kit/logos/</code></p>
            </div>
          )}
        </div>

        <!-- Photos Section -->
        <div class="media-kit-section">
          <h3 class="media-kit-section-title">Photos</h3>
          <p class="media-kit-section-desc">High-resolution photographs available for editorial use.</p>
          {photos.length > 0 ? (
            <div class="media-grid media-grid-photos">
              {photos.map((asset) => (
                <button
                  class="media-item"
                  data-lightbox-trigger
                  data-media-src={asset.src}
                  data-media-type={asset.type}
                  data-media-title={asset.title}
                  data-media-description={asset.description}
                  data-media-format={asset.format}
                  data-media-dimensions={asset.dimensions}
                  data-media-size={asset.size}
                  data-media-credit={asset.credit || 'Bluffline, Inc.'}
                  data-media-date={asset.date}
                  data-media-download={asset.src}
                  data-media-filename={asset.src.split('/').pop()}
                >
                  <div class="media-item-preview photo-preview">
                    <img src={asset.src} alt={asset.title} loading="lazy" />
                  </div>
                  <div class="media-item-info">
                    <span class="media-item-title">{asset.title}</span>
                    <span class="media-item-meta">{asset.format}{asset.dimensions && ` · ${asset.dimensions}`}{asset.size && ` · ${asset.size}`}</span>
                  </div>
                  <div class="media-item-actions">
                    <span class="preview-hint">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                      </svg>
                      Preview
                    </span>
                  </div>
                </button>
              ))}
            </div>
          ) : (
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <p class="empty-state-text">Photos will appear here</p>
              <p class="empty-state-hint">Add image files to <code>public/media-kit/photos/</code></p>
            </div>
          )}
        </div>

        <!-- Videos Section -->
        <div class="media-kit-section">
          <h3 class="media-kit-section-title">Videos</h3>
          <p class="media-kit-section-desc">Video content available for broadcast and digital media.</p>
          {videos.length > 0 ? (
            <div class="media-grid media-grid-videos">
              {videos.map((asset) => (
                <button
                  class="media-item"
                  data-lightbox-trigger
                  data-media-src={asset.src}
                  data-media-type={asset.type}
                  data-media-video-type={asset.videoType}
                  data-media-title={asset.title}
                  data-media-description={asset.description}
                  data-media-format={asset.format}
                  data-media-size={asset.size}
                  data-media-credit={asset.credit || 'Bluffline, Inc.'}
                  data-media-date={asset.date}
                  data-media-download={asset.src}
                  data-media-filename={asset.src.split('/').pop()}
                >
                  <div class="media-item-preview video-preview">
                    <video src={asset.src} preload="metadata" />
                    <div class="video-play-icon">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                      </svg>
                    </div>
                  </div>
                  <div class="media-item-info">
                    <span class="media-item-title">{asset.title}</span>
                    <span class="media-item-meta">{asset.format}{asset.size && ` · ${asset.size}`}</span>
                  </div>
                  <div class="media-item-actions">
                    <span class="preview-hint">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                      </svg>
                      Play
                    </span>
                  </div>
                </button>
              ))}
            </div>
          ) : (
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                  <line x1="7" y1="2" x2="7" y2="22"/>
                  <line x1="17" y1="2" x2="17" y2="22"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <line x1="2" y1="7" x2="7" y2="7"/>
                  <line x1="2" y1="17" x2="7" y2="17"/>
                  <line x1="17" y1="17" x2="22" y2="17"/>
                  <line x1="17" y1="7" x2="22" y2="7"/>
                </svg>
              </div>
              <p class="empty-state-text">Videos will appear here</p>
              <p class="empty-state-hint">Add video files to <code>public/media-kit/videos/</code></p>
            </div>
          )}
        </div>

        <!-- Media Contact Section -->
        <div class="media-kit-section">
          <h3 class="media-kit-section-title">Media Contact</h3>
          <div class="contact-card">
            <p>For press inquiries, interviews, or additional information:</p>
            <div class="contact-info">
              <div class="contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href="mailto:press@bluffline.org">press@bluffline.org</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Support the Bluffline"
    description="Help us build the infrastructure that will transform how Pensacola moves, plays, and connects."
    primaryLabel="Get Involved"
    primaryHref="/support"
  />

  <MediaLightbox />
</BaseLayout>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll('[role="tab"]');
    const panels = document.querySelectorAll('[role="tabpanel"]');

    // Map of hash values to tab IDs
    const hashToTab: Record<string, string> = {
      '#news': 'news-tab',
      '#releases': 'releases-tab',
      '#media-kit': 'media-kit-tab',
    };

    // Map of tab IDs to hash values
    const tabToHash: Record<string, string> = {
      'news-tab': '#news',
      'releases-tab': '#releases',
      'media-kit-tab': '#media-kit',
    };

    // Check for hash in URL
    const hash = window.location.hash;
    if (hash && hashToTab[hash]) {
      activateTab(hashToTab[hash]);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        activateTab(tab.id);
      });

      tab.addEventListener('keydown', (event) => {
        const e = event as KeyboardEvent;
        const tabsArray = Array.from(tabs);
        const currentIndex = tabsArray.indexOf(tab);

        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const nextIndex = e.key === 'ArrowRight'
            ? (currentIndex + 1) % tabsArray.length
            : (currentIndex - 1 + tabsArray.length) % tabsArray.length;

          const nextTab = tabsArray[nextIndex] as HTMLElement;
          nextTab.focus();
          activateTab(nextTab.id);
        }
      });
    });

    function activateTab(tabId: string) {
      tabs.forEach(t => {
        const isSelected = t.id === tabId;
        t.setAttribute('aria-selected', String(isSelected));
        t.classList.toggle('active', isSelected);
        t.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      panels.forEach(panel => {
        const isActive = panel.getAttribute('aria-labelledby') === tabId;
        panel.classList.toggle('active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      // Update URL hash without scrolling
      const newHash = tabToHash[tabId] || '#news';
      history.replaceState(null, '', newHash);
    }
  }

  function initCopyBoilerplate() {
    const copyBtn = document.querySelector('.copy-boilerplate');
    const boilerplate = document.querySelector('.boilerplate p');

    copyBtn?.addEventListener('click', async () => {
      if (!boilerplate) return;

      const text = boilerplate.textContent || '';

      try {
        await navigator.clipboard.writeText(text);

        // Update button to show success
        const originalHTML = copyBtn.innerHTML;
        copyBtn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Copied!
        `;
        copyBtn.classList.add('copied');

        setTimeout(() => {
          copyBtn.innerHTML = originalHTML;
          copyBtn.classList.remove('copied');
        }, 2000);
      } catch {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  }

  initTabs();
  initCopyBoilerplate();
</script>

<style>
  .tabs-section { padding: 0 0 4rem; background: var(--cream); }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(45, 48, 71, 0.1);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    padding: 1rem 1.5rem;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: rgba(45, 48, 71, 0.6);
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tab:hover {
    color: var(--navy);
  }

  .tab.active {
    color: var(--forest);
  }

  .tab.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--forest);
  }

  .tab:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 2px;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .year-group { margin-bottom: 3rem; }
  .year-group:last-child { margin-bottom: 0; }
  .year-label {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--spring);
    display: inline-block;
  }
  .articles-grid { display: grid; gap: 1rem; }

  .releases-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .releases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: rgba(45, 48, 71, 0.6);
    font-size: 1rem;
  }

  /* Media Kit Styles */
  .media-kit-intro {
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.85;
  }

  .media-kit-section {
    margin-bottom: 3rem;
  }

  .media-kit-section:last-child {
    margin-bottom: 0;
  }

  .media-kit-section-title {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .media-kit-section-desc {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  /* Boilerplate Card */
  .boilerplate-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(45, 48, 71, 0.08);
  }

  .boilerplate {
    background: var(--mist);
    border-radius: 8px;
    padding: 1.25rem;
    font-size: 0.9rem;
    color: var(--navy);
    line-height: 1.7;
  }

  .boilerplate p {
    margin: 0;
  }

  .boilerplate-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .copy-boilerplate {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--forest);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-boilerplate:hover {
    background: #364519;
  }

  .copy-boilerplate.copied {
    background: var(--spring);
    color: var(--forest);
  }

  .copy-boilerplate svg {
    width: 16px;
    height: 16px;
  }

  /* Empty State Card */
  .empty-state-card {
    background: white;
    border: 2px dashed rgba(45, 48, 71, 0.15);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .empty-state-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    color: rgba(45, 48, 71, 0.25);
  }

  .empty-state-icon svg {
    width: 100%;
    height: 100%;
  }

  .empty-state-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .empty-state-hint {
    font-size: 0.85rem;
    color: rgba(45, 48, 71, 0.5);
  }

  .empty-state-hint code {
    background: var(--mist);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  /* Media Grid */
  .media-grid {
    display: grid;
    gap: 1.25rem;
  }

  .media-grid-logos {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .media-grid-photos {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .media-grid-videos {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .media-item {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(45, 48, 71, 0.08);
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    width: 100%;
  }

  .media-item:hover {
    box-shadow: 0 8px 24px rgba(45, 48, 71, 0.12);
    transform: translateY(-2px);
  }

  .media-item:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 2px;
  }

  .media-item-preview {
    aspect-ratio: 16 / 10;
    background: var(--mist);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .logo-preview {
    aspect-ratio: 3 / 2;
    padding: 1.5rem;
    background: linear-gradient(135deg, #f8f8f8 25%, #e8e8e8 25%, #e8e8e8 50%, #f8f8f8 50%, #f8f8f8 75%, #e8e8e8 75%);
    background-size: 20px 20px;
  }

  .logo-preview img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-preview {
    background: #000;
  }

  .video-preview video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-play-icon {
    position: absolute;
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.95);
