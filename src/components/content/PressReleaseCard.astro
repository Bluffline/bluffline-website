---
interface Props {
  title: string;
  pubDate: Date;
  summary: string;
  slug: string;
}

const { title, pubDate, summary, slug } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<a href={`/press/${slug}`} class="release-card">
  <p class="release-date">{formattedDate}</p>
  <h3>{title}</h3>
  <p class="release-summary">{summary}</p>
  <span class="release-link">
    Read full release
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </span>
</a>

<style>
  .release-card {
    display: block;
    background: var(--card-bg);
    border-radius: 16px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    box-shadow: var(--card-shadow);
    border: var(--card-border);
  }

  .release-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
  }

  .release-date {
    font-size: 0.875rem;
    color: rgba(45, 48, 71, 0.6);
    margin-bottom: 0.75rem;
  }

  .release-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .release-summary {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .release-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--forest);
    transition: gap 0.2s ease;
  }

  .release-card:hover .release-link {
    gap: 0.75rem;
  }

  .release-link svg {
    width: 16px;
    height: 16px;
  }
</style>
