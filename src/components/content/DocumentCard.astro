---
interface Props {
  title: string;
  description: string;
  href: string;
  external?: boolean;
  icon?: string;
  year?: number;
  actionLabel?: string;
  showDownload?: boolean;
}

const {
  title,
  description,
  href,
  external = false,
  icon,
  year,
  actionLabel,
  showDownload = false
} = Astro.props;

const defaultIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`;

const externalArrowIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;

const internalArrowIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;

const downloadIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;
---

<a
  href={href}
  class:list={['document-card', { 'has-year': year }]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  {year && <div class="document-year">{year}</div>}
  {!year && (
    <div class="document-icon">
      <Fragment set:html={icon || defaultIcon} />
    </div>
  )}
  <div class="document-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="document-action">
    {showDownload ? (
      <span class="download-indicator">
        <Fragment set:html={downloadIcon} />
        {actionLabel || 'Download PDF'}
      </span>
    ) : (
      <div class="document-arrow">
        <Fragment set:html={external ? externalArrowIcon : internalArrowIcon} />
      </div>
    )}
  </div>
</a>

<style>
  .document-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: white;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(45, 48, 71, 0.04);
  }

  .document-card:hover {
    box-shadow: 0 4px 16px rgba(45, 48, 71, 0.08);
    transform: translateY(-2px);
  }

  /* Year variant (for annual reports) */
  .document-card.has-year {
    flex-direction: column;
    align-items: stretch;
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid rgba(45, 48, 71, 0.06);
    transition: all 0.3s ease;
  }

  .document-card.has-year:hover {
    box-shadow: 0 12px 32px rgba(45, 48, 71, 0.08);
  }

  .document-year {
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    color: var(--forest);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .document-icon {
    width: 44px;
    height: 44px;
    background: var(--mist);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .document-icon :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--forest);
  }

  .document-content {
    flex: 1;
  }

  .document-content h3 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.125rem;
  }

  .has-year .document-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .document-content p {
    font-size: 0.875rem;
    color: var(--navy);
    opacity: 0.6;
    line-height: 1.5;
  }

  .has-year .document-content p {
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .document-action {
    flex-shrink: 0;
  }

  .has-year .document-action {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
  }

  .document-arrow {
    opacity: 0.3;
    transition: all 0.2s ease;
  }

  .document-arrow :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--forest);
  }

  .document-card:hover .document-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .download-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forest);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .download-indicator :global(svg) {
    width: 18px;
    height: 18px;
  }

  .document-card:hover .download-indicator {
    text-decoration: underline;
  }
</style>
