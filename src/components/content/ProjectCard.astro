---
interface Milestone {
  title: string;
  description: string;
  date: string;
  status: 'complete' | 'current' | 'upcoming';
  nodeRef?: string;
}

interface Project {
  title: string;
  shortTitle: string;
  status: 'active' | 'pending' | 'complete' | 'pursuing';
  funder: string;
  program: string;
  amount?: string;
  awardDate?: string;
  description: string;
  color?: string;
  milestones: Milestone[];
  segments?: any;
}

interface Props {
  project: Project;
  isActive?: boolean;
  href?: string;
}

const { project, isActive = false, href } = Astro.props;

const statusLabels: Record<string, string> = {
  active: 'Active',
  pending: 'Pending Obligation',
  pursuing: 'Pursuing',
  complete: 'Complete',
};

const completedCount = project.milestones.filter(m => m.status === 'complete').length;
const totalCount = project.milestones.length;
---

{href ? (
  <a
    class:list={['project-card', 'project-card-link', { active: isActive }]}
    href={href}
    data-project-id={project.shortTitle}
    data-project-title={project.shortTitle}
    data-project-color={project.color || ''}
    data-project-segments={project.segments ? JSON.stringify(project.segments) : ''}
  >
    <div class="card-header">
      <div>
        <h3 class="card-title">{project.shortTitle}</h3>
        <p class="card-funder">{project.funder} &middot; {project.program}</p>
      </div>
      <span class:list={['status-badge', project.status]}>
        {statusLabels[project.status]}
      </span>
    </div>
    <p class="card-description">{project.description}</p>
    <div class="card-progress">
      <div class="progress-bar-track">
        <div class="progress-bar-fill" style={`width: ${(completedCount / totalCount) * 100}%`}></div>
      </div>
      <span class="progress-label">{completedCount} of {totalCount} milestones complete</span>
    </div>
    <span class="card-view-link">
      View project details
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </span>
  </a>
) : (
  <div
    class:list={['project-card', { active: isActive }]}
    data-project-id={project.shortTitle}
    data-project-title={project.shortTitle}
    data-project-color={project.color || ''}
    data-project-segments={project.segments ? JSON.stringify(project.segments) : ''}
  >
    <div class="card-header">
      <div>
        <h3 class="card-title">{project.shortTitle}</h3>
        <p class="card-funder">{project.funder} &middot; {project.program}</p>
      </div>
      <span class:list={['status-badge', project.status]}>
        {statusLabels[project.status]}
      </span>
    </div>
    <p class="card-description">{project.description}</p>
    <div class="card-progress">
      <div class="progress-bar-track">
        <div class="progress-bar-fill" style={`width: ${(completedCount / totalCount) * 100}%`}></div>
      </div>
      <span class="progress-label">{completedCount} of {totalCount} milestones complete</span>
    </div>
  </div>
)}

<style>
  .project-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1.5px solid rgba(45, 48, 71, 0.08);
    cursor: pointer;
    transition: all 0.25s ease;
    min-width: 0;
    flex-shrink: 0;
  }

  a.project-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .project-card:hover,
  .project-card.active {
    border-color: var(--forest);
    box-shadow: 0 4px 16px rgba(65, 82, 31, 0.1);
  }
  :global(.project-card.map-highlighted) {
    border-color: var(--spring);
    box-shadow: 0 4px 16px rgba(153, 204, 99, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-title {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--navy);
    margin: 0;
    line-height: 1.3;
  }

  .card-funder {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.55;
    margin: 0.25rem 0 0 0;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.625rem;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge.active {
    background: rgba(65, 82, 31, 0.1);
    color: var(--forest);
  }
  .status-badge.pending {
    background: rgba(212, 160, 23, 0.12);
    color: #9a7410;
  }
  .status-badge.pursuing {
    background: var(--mist);
    color: var(--navy);
    opacity: 0.7;
  }
  .status-badge.complete {
    background: rgba(153, 204, 99, 0.15);
    color: var(--forest);
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.55;
    margin: 0 0 1rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-progress {
    margin-bottom: 0.875rem;
  }
  .progress-bar-track {
    height: 4px;
    background: var(--mist);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.375rem;
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--spring);
    border-radius: 2px;
    transition: width 0.5s ease;
  }
  .progress-label {
    font-size: 0.75rem;
    color: var(--navy);
    opacity: 0.5;
  }

  .card-view-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(45, 48, 71, 0.06);
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--forest);
    transition: gap 0.2s ease;
  }
  .project-card:hover .card-view-link {
    gap: 0.5rem;
  }
</style>
