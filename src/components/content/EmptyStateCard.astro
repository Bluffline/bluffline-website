---
interface Props {
  title: string;
  description?: string;
  icon?: string;
  variant?: 'default' | 'dashed';
}

const { title, description, icon, variant = 'dashed' } = Astro.props;

// Default icons for common use cases
const defaultIcons = {
  image: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  video: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>`,
  audio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  document: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
};

const displayIcon = icon || defaultIcons.document;
---

<div class:list={['empty-state-card', `variant-${variant}`]}>
  <div class="empty-state-icon">
    <Fragment set:html={displayIcon} />
  </div>
  <h3 class="empty-state-title">{title}</h3>
  {description && <p class="empty-state-description">{description}</p>}
</div>

<style>
  .empty-state-card {
    text-align: center;
    padding: 3rem 2rem;
  }

  .empty-state-card.variant-dashed {
    background: white;
    border: 2px dashed rgba(45, 48, 71, 0.15);
    border-radius: 12px;
  }

  .empty-state-card.variant-default {
    background: var(--mist);
    border-radius: 16px;
  }

  .empty-state-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    color: rgba(45, 48, 71, 0.25);
  }

  .empty-state-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .empty-state-title {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .empty-state-description {
    font-size: 0.9rem;
    color: rgba(45, 48, 71, 0.5);
    line-height: 1.5;
    max-width: 280px;
    margin: 0 auto;
  }
</style>
