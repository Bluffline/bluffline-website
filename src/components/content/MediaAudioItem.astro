---
interface Props {
  src: string;
  title: string;
  audioType?: string;
  format?: string;
  size?: string;
  credit?: string;
}

const { src, title, size, credit } = Astro.props;
const format = Astro.props.format ?? src.split('.').pop()?.toUpperCase() ?? '';
const ext = src.split('.').pop()?.toLowerCase() ?? '';
const audioType = Astro.props.audioType ?? (
  ext === 'ogg' ? 'audio/ogg' : ext === 'wav' ? 'audio/wav' : 'audio/mpeg'
);
const filename = src.split('/').pop() ?? '';
const meta = [format, size, credit].filter(Boolean).join(' · ');
---

<div class="audio-item">
  <div class="audio-item-info">
    <div class="audio-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </svg>
    </div>
    <div class="audio-details">
      <span class="media-item-title">{title}</span>
      <span class="media-item-meta">{meta}</span>
    </div>
  </div>
  <audio controls preload="metadata">
    <source src={src} type={audioType} />
    Your browser does not support the audio element.
  </audio>
  <a href={src} download={filename} class="audio-download">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" y1="15" x2="12" y2="3"/>
    </svg>
    Download
  </a>
</div>

<style>
  .audio-item {
    background: white;
    border-radius: 12px;
    padding: 1.25rem;
    border: 1px solid rgba(45, 48, 71, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .audio-item {
      flex-direction: row;
      align-items: center;
    }
  }

  .audio-item-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-width: 0;
  }

  .audio-icon {
    width: 48px;
    height: 48px;
    background: var(--mist);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .audio-icon svg {
    width: 24px;
    height: 24px;
    color: var(--forest);
  }

  .audio-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .media-item-title {
    font-weight: 600;
    color: var(--navy);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .media-item-meta {
    font-size: 0.8rem;
    color: rgba(45, 48, 71, 0.6);
  }

  audio {
    flex: 1;
    min-width: 200px;
    max-width: 400px;
    height: 40px;
  }

  .audio-download {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--forest);
    color: white;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .audio-download:hover {
    background: #364519;
  }

  .audio-download svg {
    width: 16px;
    height: 16px;
  }
</style>
