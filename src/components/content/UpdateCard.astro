---
interface Props {
  title: string;
  date: Date;
  excerpt?: string;
  slug: string;
  featuredImage?: string;
  featuredImageAlt?: string;
  sbObjectId?: string;
}

const { title, date, excerpt, slug, featuredImage, featuredImageAlt, sbObjectId } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<a href={`/progress/updates/${slug}`} class:list={['update-card', { 'has-image': featuredImage }]} data-sb-object-id={sbObjectId}>
  {featuredImage && (
    <div class="update-card-image">
      <img src={featuredImage} alt={featuredImageAlt || ''} loading="lazy" data-sb-field-path="featuredImage" />
    </div>
  )}
  <div class="update-card-content">
    <p class="update-card-date" data-sb-field-path="pubDate">{formattedDate}</p>
    <h3 data-sb-field-path="title">{title}</h3>
    {excerpt && <p class="update-card-excerpt" data-sb-field-path="description">{excerpt}</p>}
    <span class="update-card-link">
      Read more
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .update-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 12px rgba(45, 48, 71, 0.06);
    display: flex;
    flex-direction: column;
  }

  .update-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(45, 48, 71, 0.1);
  }

  .update-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .update-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .update-card:hover .update-card-image img {
    transform: scale(1.05);
  }

  .update-card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .update-card-date {
    font-size: 0.8rem;
    color: rgba(45, 48, 71, 0.5);
    margin-bottom: 0.5rem;
  }

  .update-card h3 {
    font-size: 1.125rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    color: var(--navy);
  }

  .update-card-excerpt {
    font-size: 0.9rem;
    color: rgba(45, 48, 71, 0.7);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .update-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--forest);
    margin-top: 1rem;
  }

  .update-card-link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .update-card:hover .update-card-link svg {
    transform: translateX(4px);
  }
</style>
