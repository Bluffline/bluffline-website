---
interface Props {
  name: string;
  title: string;
  year: number;
  photo?: string;
  href: string;
}

const { name, title, year, photo, href } = Astro.props;

const initials = name
  .split(' ')
  .map(n => n[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
---

<a href={href} class="award-recipient-card">
  <div class="recipient-photo">
    {photo ? (
      <img src={photo} alt={name} loading="lazy" />
    ) : (
      <div class="recipient-initials">{initials}</div>
    )}
  </div>
  <div class="recipient-content">
    <span class="recipient-year">{year} Recipient</span>
    <h3 class="recipient-name">{name}</h3>
    <p class="recipient-title">{title}</p>
    <span class="recipient-link">
      View profile
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .award-recipient-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    border: var(--card-border);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .award-recipient-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }

  .recipient-photo {
    aspect-ratio: 1 / 1;
    width: 100%;
    background: var(--mist);
    overflow: hidden;
  }

  .recipient-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .recipient-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', serif;
    font-size: 3rem;
    color: var(--forest);
  }

  .recipient-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .recipient-year {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    margin-bottom: 0.5rem;
  }

  .recipient-name {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    color: var(--navy);
    margin-bottom: 0.35rem;
    line-height: 1.2;
  }

  .recipient-title {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.7;
    line-height: 1.45;
    margin-bottom: 1.25rem;
  }

  .recipient-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest);
    transition: gap 0.2s ease;
  }

  .award-recipient-card:hover .recipient-link {
    gap: 0.65rem;
  }

  .recipient-link svg {
    width: 16px;
    height: 16px;
  }
</style>
