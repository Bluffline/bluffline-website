---
interface Milestone {
  title: string;
  description: string;
  date: string;
  status: 'complete' | 'current' | 'upcoming';
  nodeRef?: string;
}

interface Props {
  milestones: Milestone[];
  projectColor?: string;
}

const { milestones, projectColor } = Astro.props;
---

<div class="milestone-timeline">
  {milestones.map((milestone, i) => (
    <div class:list={['milestone-entry', milestone.status]}>
      <div class="timeline-track">
        <div class="timeline-dot">
          {milestone.status === 'complete' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          )}
          {milestone.status === 'current' && (
            <span class="pulse-ring"></span>
          )}
        </div>
        {i < milestones.length - 1 && (
          <div class:list={['timeline-connector', { filled: milestone.status === 'complete' }]}></div>
        )}
      </div>
      <div class="milestone-body">
        <div class="milestone-header">
          <div class="milestone-title-row">
            <h4>{milestone.title}</h4>
            {milestone.nodeRef && (
              <span class="node-badge">{milestone.nodeRef}</span>
            )}
          </div>
          <span class="milestone-date">{milestone.date}</span>
        </div>
        <p class="milestone-description">{milestone.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .milestone-timeline {
    display: flex;
    flex-direction: column;
  }

  .milestone-entry {
    display: flex;
    gap: 1rem;
    min-height: 80px;
  }
  .milestone-entry:last-child {
    min-height: auto;
  }

  .timeline-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 28px;
  }

  .timeline-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  .complete .timeline-dot {
    background: var(--spring);
  }
  .complete .timeline-dot svg {
    width: 14px;
    height: 14px;
    color: var(--forest);
  }

  .current .timeline-dot {
    background: var(--forest);
  }
  .current .timeline-dot .pulse-ring {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
  }
  .current .timeline-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: none;
    animation: milestone-pulse 2s ease-in-out infinite;
    box-shadow: 0 0 0 3px rgba(65, 82, 31, 0.25);
  }

  .upcoming .timeline-dot {
    background: transparent;
    border: 2px dashed rgba(45, 48, 71, 0.2);
  }

  @keyframes milestone-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(65, 82, 31, 0.25); }
    50% { box-shadow: 0 0 0 7px rgba(65, 82, 31, 0.1); }
  }

  .timeline-connector {
    flex: 1;
    width: 2px;
    background: rgba(45, 48, 71, 0.1);
    min-height: 16px;
  }
  .timeline-connector.filled {
    background: var(--spring);
  }

  .milestone-body {
    flex: 1;
    padding-bottom: 1.5rem;
  }
  .milestone-entry:last-child .milestone-body {
    padding-bottom: 0;
  }

  .milestone-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }

  .milestone-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .milestone-title-row h4 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
    margin: 0;
    line-height: 1.3;
  }
  .upcoming .milestone-title-row h4 {
    opacity: 0.6;
  }

  .node-badge {
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    background: var(--mist);
    color: var(--forest);
    border-radius: 100px;
    white-space: nowrap;
  }

  .milestone-date {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.45;
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .milestone-description {
    font-size: 0.875rem;
    color: var(--navy);
    opacity: 0.65;
    line-height: 1.55;
    margin: 0;
  }
  .upcoming .milestone-description {
    opacity: 0.45;
  }
</style>
