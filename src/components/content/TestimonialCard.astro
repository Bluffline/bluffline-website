---
interface Props {
  quote: string;
  author: string;
  title: string;
  organization: string;
  organizationLink?: string;
  pdfFile: string;
}

const { quote, author, title, organization, organizationLink, pdfFile } = Astro.props;
---

<article class="testimonial-card">
  <div class="quote-mark" aria-hidden="true">"</div>
  <blockquote class="quote">
    {quote}
  </blockquote>
  <div class="attribution">
    <p class="author">{author}</p>
    <p class="title-org">
      <span>{title}</span>,{' '}
      {organizationLink ? (
        <a href={organizationLink} class="org-link" target="_blank" rel="noopener">{organization}</a>
      ) : (
        <span>{organization}</span>
      )}
    </p>
  </div>
  {pdfFile && (
    <a href={pdfFile} class="pdf-link" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      Read Full Letter
    </a>
  )}
</article>

<style>
  .testimonial-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: var(--card-shadow);
    border: var(--card-border);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.2s ease;
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  .testimonial-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
  }

  .quote-mark {
    font-family: 'Fraunces', serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--spring);
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    opacity: 0.5;
  }

  .quote {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--navy);
    margin: 0;
    padding-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .quote {
      font-size: 1.25rem;
    }
  }

  .attribution {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
  }

  .author {
    font-weight: 600;
    color: var(--navy);
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .title-org {
    font-size: 0.9rem;
    color: var(--navy);
    opacity: 0.7;
  }

  .org-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s ease;
  }

  .org-link:hover {
    opacity: 1;
  }

  .pdf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--forest);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .pdf-link:hover {
    gap: 0.75rem;
  }

  .pdf-link svg {
    width: 18px;
    height: 18px;
  }
</style>
