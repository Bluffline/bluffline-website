---
/**
 * CorridorMap — Mapbox GL JS interactive corridor map.
 *
 * Shared geographic data (planning corridor polygon, scenic highway line) is
 * imported directly from src/data/ — these are stable, site-level assets.
 *
 * Project-specific segment geometry travels through props as a GeoJSON
 * FeatureCollection, coming from the project's content entry (project.data.segments).
 * This keeps all project data self-contained in src/content/projects/.
 */
import corridorData from '../../data/planning-corridor.json';
import scenicHighwayData from '../../data/scenic-highway.json';

export interface CorridorNode {
  id: string;
  label: string;
  sublabel: string;
  description: string;
  position: string;
  coordinates: [number, number];
  waterTransit?: boolean;
}

interface Props {
  nodes: CorridorNode[];
  /** Active project's node IDs to highlight */
  activeProjectNodes?: string[];
  /** Active project's segment GeoJSON FeatureCollection to highlight */
  projectSegments?: any;
  /** Highlight color (defaults to --spring #99CC63) */
  projectColor?: string;
  interactive?: boolean;
}

const {
  nodes,
  activeProjectNodes = [],
  projectSegments = null,
  projectColor,
  interactive = true,
} = Astro.props;

const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';
const EMPTY_FC = { type: 'FeatureCollection', features: [] };
---

<div
  id="bluffline-map"
  class="corridor-map"
  data-nodes={JSON.stringify(nodes)}
  data-active-nodes={JSON.stringify(activeProjectNodes)}
  data-project-color={projectColor}
  data-interactive={interactive.toString()}
></div>

<style>
  .corridor-map {
    width: 100%;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .corridor-map { height: 300px; }
  }

  /* Popup overrides scoped to this map */
  :global(#bluffline-map .mapboxgl-popup-content) {
    padding: 0.875rem 1rem;
    border-radius: 10px;
    max-width: 260px;
    box-shadow: 0 4px 16px rgba(45, 48, 71, 0.12);
    font-family: 'Source Sans 3', sans-serif;
  }
  :global(#bluffline-map .mapboxgl-popup-content h3) {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 400;
    color: var(--navy, #2D3047);
    margin: 0 0 0.125rem 0;
    line-height: 1.3;
  }
  :global(#bluffline-map .mapboxgl-popup-content .node-sublabel) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--forest, #41521F);
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }
  :global(#bluffline-map .mapboxgl-popup-content p) {
    font-size: 0.825rem;
    color: var(--navy, #2D3047);
    opacity: 0.75;
    margin: 0 0 0.5rem 0;
    line-height: 1.5;
  }
  :global(#bluffline-map .mapboxgl-popup-content .node-projects) {
    font-size: 0.75rem;
    color: var(--forest, #41521F);
    font-weight: 500;
    margin: 0;
    padding-top: 0.375rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
  }
  :global(#bluffline-map .mapboxgl-popup-close-button) {
    font-size: 1.25rem;
    padding: 0.25rem 0.5rem;
    color: var(--navy, #2D3047);
    opacity: 0.5;
  }
  :global(#bluffline-map .mapboxgl-popup-close-button:hover) {
    opacity: 1;
    background: transparent;
  }

  /* Node marker elements */
  :global(.bluffline-node-marker) {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #2D3047;
    border: 2.5px solid white;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }
  :global(.bluffline-node-marker.water-transit) {
    border-radius: 3px;
    transform: rotate(45deg);
  }
  :global(.bluffline-node-marker.highlighted) {
    width: 18px;
    height: 18px;
    border-color: white;
    box-shadow: 0 0 0 4px rgba(153, 204, 99, 0.35), 0 2px 8px rgba(0,0,0,0.15);
  }
  :global(.bluffline-node-marker.water-transit.highlighted) {
    border-radius: 4px;
  }
  :global(.bluffline-node-marker.dimmed) {
    opacity: 0.3;
  }

  /* Node label elements */
  :global(.bluffline-node-label) {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #2D3047;
    text-shadow: 0 0 4px white, 0 0 4px white, 0 0 4px white, 0 0 4px white;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.25s ease, color 0.25s ease;
    line-height: 1;
  }
  :global(.bluffline-node-label.highlighted) {
    color: #41521F;
    font-weight: 700;
    font-size: 12px;
  }
  :global(.bluffline-node-label.dimmed) {
    opacity: 0.25;
  }
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, corridorData, scenicHighwayData, EMPTY_FC }}>
  const mapboxScript = document.createElement('script');
  mapboxScript.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  mapboxScript.onload = initCorridorMap;
  document.head.appendChild(mapboxScript);

  function initCorridorMap() {
    const container = document.getElementById('bluffline-map');
    if (!container) return;

    const nodes = JSON.parse(container.dataset.nodes || '[]');
    const isInteractive = container.dataset.interactive !== 'false';

    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'bluffline-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.47],
      zoom: 10,
      attributionControl: false,
    });

    map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-right');

    // Marker and label element references for highlight control
    const markerElements = {};
    const labelElements = {};
    let activePopup = null;

    map.on('load', () => {
      // ─── Planning corridor polygon ────────────────────────────────────────
      map.addSource('planning-corridor', {
        type: 'geojson',
        data: corridorData,
      });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: {
          'fill-color': '#41521F',
          'fill-opacity': 0.07,
        },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 1.5,
          'line-opacity': 0.3,
          'line-dasharray': [3, 2],
        },
      });

      // ─── Scenic highway centerline (base corridor) ────────────────────────
      map.addSource('scenic-highway', {
        type: 'geojson',
        data: scenicHighwayData,
      });
      map.addLayer({
        id: 'scenic-highway-glow',
        type: 'line',
        source: 'scenic-highway',
        paint: {
          'line-color': '#41521F',
          'line-width': 10,
          'line-opacity': 0.08,
          'line-blur': 5,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'scenic-highway-line',
        type: 'line',
        source: 'scenic-highway',
        paint: {
          'line-color': '#41521F',
          'line-width': 3,
          'line-opacity': 0.65,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });

      // ─── Project segment highlight layers (start empty) ───────────────────
      map.addSource('project-segments', {
        type: 'geojson',
        data: EMPTY_FC,
      });
      map.addLayer({
        id: 'project-segments-glow',
        type: 'line',
        source: 'project-segments',
        paint: {
          'line-color': ['coalesce', ['get', 'highlightColor'], '#99CC63'],
          'line-width': 12,
          'line-opacity': 0.2,
          'line-blur': 6,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'project-segments-line',
        type: 'line',
        source: 'project-segments',
        paint: {
          'line-color': ['coalesce', ['get', 'highlightColor'], '#99CC63'],
          'line-width': 4.5,
          'line-opacity': 0.9,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });

      // ─── Node markers ─────────────────────────────────────────────────────
      nodes.forEach((node) => {
        // Marker dot
        const markerEl = document.createElement('div');
        markerEl.className = 'bluffline-node-marker';
        if (node.waterTransit) markerEl.classList.add('water-transit');
        markerEl.dataset.nodeId = node.id;

        new mapboxgl.Marker({ element: markerEl, anchor: 'center' })
          .setLngLat(node.coordinates)
          .addTo(map);
        markerElements[node.id] = markerEl;

        // Label
        const labelEl = document.createElement('div');
        labelEl.className = 'bluffline-node-label';
        labelEl.textContent = node.label;

        new mapboxgl.Marker({ element: labelEl, anchor: 'top', offset: [0, 10] })
          .setLngLat(node.coordinates)
          .addTo(map);
        labelElements[node.id] = labelEl;

        // Interactions
        if (isInteractive) {
          markerEl.addEventListener('click', (e) => {
            e.stopPropagation();
            if (activePopup) { activePopup.remove(); activePopup = null; }

            // Find project cards that touch this node
            const projectCards = document.querySelectorAll('[data-project-nodes]');
            const touchingProjects = [];
            projectCards.forEach((card) => {
              const cardNodes = (card.dataset.projectNodes || '').split(',');
              if (cardNodes.includes(node.id)) {
                touchingProjects.push(card.dataset.projectTitle || card.dataset.projectId || '');
              }
            });

            const projectsHtml = touchingProjects.length
              ? `<p class="node-projects">Active project: ${touchingProjects.join(', ')}</p>`
              : '';

            activePopup = new mapboxgl.Popup({ offset: 14, closeButton: true })
              .setLngLat(node.coordinates)
              .setHTML(`
                <h3>${node.label}</h3>
                <p class="node-sublabel">${node.sublabel}</p>
                <p>${node.description}</p>
                ${projectsHtml}
              `)
              .addTo(map);
          });

          markerEl.addEventListener('mouseenter', () => {
            document.querySelectorAll('[data-project-nodes]').forEach((card) => {
              const cardNodes = (card.dataset.projectNodes || '').split(',');
              if (cardNodes.includes(node.id)) card.classList.add('map-highlighted');
            });
          });
          markerEl.addEventListener('mouseleave', () => {
            document.querySelectorAll('[data-project-nodes]').forEach((card) => {
              card.classList.remove('map-highlighted');
            });
          });
        }
      });

      // Fit to corridor bounds
      const bounds = new mapboxgl.LngLatBounds();
      corridorData.features[0].geometry.coordinates[0].forEach((coord) => {
        bounds.extend(coord);
      });
      map.fitBounds(bounds, { padding: 40 });
    });

    // ─── Public highlight API ────────────────────────────────────────────────
    // Called from project card hover/click interactions on the progress page.
    window.blufflineMap = {
      /**
       * @param {string[]} nodeIds - Node IDs to highlight
       * @param {string} [color] - Hex color for the highlight
       * @param {object} [segmentsData] - GeoJSON FeatureCollection of project segments
       */
      highlightProjectNodes(nodeIds, color, segmentsData) {
        const highlightColor = color || '#99CC63';

        // Update node markers
        Object.keys(markerElements).forEach((id) => {
          const el = markerElements[id];
          const labelEl = labelElements[id];
          const isMatch = nodeIds.includes(id);
          el.classList.toggle('highlighted', isMatch);
          el.classList.toggle('dimmed', !isMatch);
          el.style.background = isMatch ? highlightColor : '';
          if (labelEl) {
            labelEl.classList.toggle('highlighted', isMatch);
            labelEl.classList.toggle('dimmed', !isMatch);
          }
        });

        // Update project segment lines
        if (map.getSource('project-segments')) {
          if (segmentsData && segmentsData.features && segmentsData.features.length > 0) {
            const coloredFC = {
              ...segmentsData,
              features: segmentsData.features.map((f) => ({
                ...f,
                properties: { ...f.properties, highlightColor },
              })),
            };
            map.getSource('project-segments').setData(coloredFC);
          } else {
            map.getSource('project-segments').setData(EMPTY_FC);
          }
        }
      },

      resetHighlights() {
        Object.keys(markerElements).forEach((id) => {
          const el = markerElements[id];
          const labelEl = labelElements[id];
          el.classList.remove('highlighted', 'dimmed');
          el.style.background = '';
          if (labelEl) labelEl.classList.remove('highlighted', 'dimmed');
        });
        if (map.getSource('project-segments')) {
          map.getSource('project-segments').setData(EMPTY_FC);
        }
      },
    };
  }
</script>
