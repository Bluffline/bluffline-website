---
/**
 * CorridorMap — Mapbox GL JS interactive corridor map.
 *
 * Shared geographic data (planning corridor polygon, scenic highway line) is
 * imported directly from src/data/ — these are stable, site-level assets.
 *
 * Project segment geometry is passed via the allProjectSegments prop as an array
 * of { id, color, segments } objects. All active project segments are shown by
 * default; hovering a project card brightens that project and dims the rest.
 */
import corridorData from '../../data/planning-corridor.json';
import scenicHighwayData from '../../data/scenic-highway.json';

interface ProjectSegmentEntry {
  id: string;
  color: string;
  segments: any; // GeoJSON FeatureCollection
}

interface Props {
  /** All project segment sets to display on the map */
  allProjectSegments?: ProjectSegmentEntry[];
  interactive?: boolean;
}

const {
  allProjectSegments = [],
  interactive = true,
} = Astro.props;

const MAPBOX_TOKEN = 'pk.eyJ1IjoiYmx1ZmZsaW5lIiwiYSI6ImNtbDU4cWx6cDAxODAzZXBzYXU0ZjVsODkifQ.EQ96tyAGq1SRs0PTaXgcag';
---

<div class="corridor-map-wrapper" id="corridor-map-wrapper">
  <div
    id="bluffline-map"
    class="corridor-map"
    data-interactive={interactive.toString()}
    data-project-segments={JSON.stringify(allProjectSegments)}
  ></div>

  <button class="fullscreen-btn" id="corridor-fullscreen-btn" aria-label="Toggle fullscreen map">
    <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
    <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 14 10 14 10 20"></polyline>
      <polyline points="20 10 14 10 14 4"></polyline>
      <line x1="14" y1="10" x2="21" y2="3"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </button>

  <div class="map-legend">
    <div class="legend-content">
      <div class="legend-item">
        <div class="legend-polygon"></div>
        <span>Planning Corridor</span>
      </div>
      <div class="legend-item">
        <div class="legend-line scenic"></div>
        <span>Scenic Highway</span>
      </div>
      {allProjectSegments.length > 0 && (
        <div class="legend-item">
          <div class="legend-line project"></div>
          <span>Active Project Segments</span>
        </div>
      )}
    </div>
    <button class="legend-toggle" aria-label="Toggle map legend" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </button>
  </div>
</div>

<style>
  .corridor-map-wrapper {
    position: relative;
    overflow: hidden;
  }

  .corridor-map {
    width: 100%;
    height: 70vh;
    min-height: 300px;
    touch-action: pan-y;
  }
  @media (min-width: 768px) {
    .corridor-map {
      min-height: 480px;
      max-height: 700px;
    }
  }

  /* Fullscreen button */
  .fullscreen-btn {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    width: 40px;
    height: 40px;
    background: white;
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fullscreen-btn:hover {
    background: var(--mist);
    transform: scale(1.05);
  }
  .fullscreen-btn .icon-collapse { display: none; }

  /* Fullscreen mode */
  :global(.corridor-map-wrapper.fullscreen) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    border-radius: 0;
    margin: 0;
  }
  :global(.corridor-map-wrapper.fullscreen) .corridor-map {
    height: 100%;
    touch-action: auto;
  }
  :global(.corridor-map-wrapper.fullscreen) .fullscreen-btn {
    top: 20px;
    left: 20px;
  }
  :global(.corridor-map-wrapper.fullscreen) .fullscreen-btn .icon-expand { display: none; }
  :global(.corridor-map-wrapper.fullscreen) .fullscreen-btn .icon-collapse { display: block; }
  :global(.corridor-map-wrapper.fullscreen) .map-legend {
    bottom: 20px;
    right: 20px;
  }

  /* Legend */
  .map-legend {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  /* Info toggle button — visible only on mobile */
  .legend-toggle {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .legend-toggle:hover { background: var(--mist); transform: scale(1.05); }

  /* Legend content panel — hidden on mobile until toggled */
  .legend-content {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    padding: 0.625rem 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
  .map-legend.legend-open .legend-content { display: flex; }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--navy);
    white-space: nowrap;
  }
  .legend-polygon {
    width: 18px;
    height: 12px;
    background: rgba(65, 82, 31, 0.15);
    border: 1.5px dashed var(--forest);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-line {
    width: 20px;
    height: 3px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .legend-line.scenic { background: var(--forest); }
  .legend-line.project { background: var(--spring); }

  /* Desktop: always show full legend, hide the toggle button */
  @media (min-width: 768px) {
    .map-legend {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      max-width: fit-content;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }
    .legend-toggle { display: none; }
    .legend-content {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      background: none;
      backdrop-filter: none;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
    }
  }

  /* Gesture overlay — "Use Ctrl + scroll to zoom" hint */
  :global(.map-gesture-overlay) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 48, 71, 0.45);
    color: white;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 5;
    border-radius: inherit;
  }
  :global(.map-gesture-overlay.visible) {
    opacity: 1;
  }

  /* Popup styles */
  :global(#bluffline-map .mapboxgl-popup-content) {
    padding: 0.75rem 0.875rem;
    border-radius: 8px;
    max-width: 220px;
    box-shadow: 0 4px 16px rgba(45, 48, 71, 0.12);
    font-family: 'Source Sans 3', sans-serif;
  }
  :global(#bluffline-map .mapboxgl-popup-content h3) {
    font-family: 'Fraunces', serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--navy, #2D3047);
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }
  :global(#bluffline-map .mapboxgl-popup-content p) {
    font-size: 0.8rem;
    color: var(--navy, #2D3047);
    opacity: 0.65;
    margin: 0;
    line-height: 1.4;
  }
  :global(#bluffline-map .mapboxgl-popup-close-button) {
    font-size: 1.25rem;
    padding: 0.15rem 0.4rem;
    color: var(--navy, #2D3047);
    opacity: 0.4;
  }
  :global(#bluffline-map .mapboxgl-popup-close-button:hover) {
    opacity: 1;
    background: transparent;
  }
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

<script define:vars={{ MAPBOX_TOKEN, corridorData, scenicHighwayData }}>
  // Legend toggle (no Mapbox dependency)
  (function() {
    var legend = document.querySelector('#corridor-map-wrapper .map-legend');
    var toggleBtn = document.querySelector('#corridor-map-wrapper .legend-toggle');
    if (legend && toggleBtn) {
      toggleBtn.addEventListener('click', function() {
        legend.classList.toggle('legend-open');
        toggleBtn.setAttribute('aria-expanded', legend.classList.contains('legend-open').toString());
      });
    }
  })();

  const mapboxScript = document.createElement('script');
  mapboxScript.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
  mapboxScript.onload = initCorridorMap;
  document.head.appendChild(mapboxScript);

  function initCorridorMap() {
    const container = document.getElementById('bluffline-map');
    if (!container) return;

    const projectSegmentEntries = JSON.parse(container.dataset.projectSegments || '[]');

    mapboxgl.accessToken = MAPBOX_TOKEN;

    const map = new mapboxgl.Map({
      container: 'bluffline-map',
      style: 'mapbox://styles/mapbox/light-v11',
      center: [-87.22, 30.47],
      zoom: 10,
      attributionControl: false,
    });

    map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-right');

    // Cooperative gestures — prevent accidental zoom when scrolling past the map
    map.scrollZoom.disable();
    map.touchZoomRotate.disable();
    map.touchPitch.disable();

    // Track corridor bounds for fitBounds
    const bounds = new mapboxgl.LngLatBounds();

    map.on('load', function() {
      // ─── Planning corridor polygon ────────────────────────────────────────
      map.addSource('planning-corridor', { type: 'geojson', data: corridorData });
      map.addLayer({
        id: 'planning-corridor-fill',
        type: 'fill',
        source: 'planning-corridor',
        paint: { 'fill-color': '#41521F', 'fill-opacity': 0.07 },
      });
      map.addLayer({
        id: 'planning-corridor-outline',
        type: 'line',
        source: 'planning-corridor',
        paint: {
          'line-color': '#41521F',
          'line-width': 1.5,
          'line-opacity': 0.25,
          'line-dasharray': [3, 2],
        },
      });

      // ─── Scenic highway centerline ────────────────────────────────────────
      map.addSource('scenic-highway', { type: 'geojson', data: scenicHighwayData });
      map.addLayer({
        id: 'scenic-highway-glow',
        type: 'line',
        source: 'scenic-highway',
        paint: {
          'line-color': '#41521F',
          'line-width': 10,
          'line-opacity': 0.08,
          'line-blur': 5,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'scenic-highway-line',
        type: 'line',
        source: 'scenic-highway',
        paint: { 'line-color': '#41521F', 'line-width': 3, 'line-opacity': 0.6 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });

      // ─── Project segments — each project gets its own source/layers ───────
      // This allows per-project opacity control for highlight/dim.
      projectSegmentEntries.forEach(function(entry) {
        var sourceId = 'project-' + entry.id;
        var segColor = entry.color || '#99CC63';

        map.addSource(sourceId, { type: 'geojson', data: entry.segments });

        // Glow layer
        map.addLayer({
          id: sourceId + '-glow',
          type: 'line',
          source: sourceId,
          paint: {
            'line-color': segColor,
            'line-width': 10,
            'line-opacity': 0.15,
            'line-blur': 5,
          },
          layout: { 'line-cap': 'round', 'line-join': 'round' },
        });

        // Main line layer
        map.addLayer({
          id: sourceId + '-line',
          type: 'line',
          source: sourceId,
          paint: {
            'line-color': segColor,
            'line-width': 4,
            'line-opacity': 0.7,
          },
          layout: { 'line-cap': 'round', 'line-join': 'round' },
        });

        // Click popup for segment features
        map.on('click', sourceId + '-line', function(e) {
          var feature = e.features && e.features[0];
          if (!feature) return;
          var name = feature.properties.name || entry.id;
          new mapboxgl.Popup({ offset: 10, closeButton: true })
            .setLngLat(e.lngLat)
            .setHTML('<h3>' + name + '</h3><p>Part of the ' + entry.id + '</p>')
            .addTo(map);
        });

        map.on('mouseenter', sourceId + '-line', function() {
          map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', sourceId + '-line', function() {
          map.getCanvas().style.cursor = '';
        });

        // Extend bounds to include segment coordinates
        if (entry.segments && entry.segments.features) {
          entry.segments.features.forEach(function(f) {
            if (f.geometry && f.geometry.coordinates) {
              f.geometry.coordinates.forEach(function(coord) {
                bounds.extend(coord);
              });
            }
          });
        }
      });

      // Add corridor polygon to bounds
      corridorData.features[0].geometry.coordinates[0].forEach(function(coord) {
        bounds.extend(coord);
      });

      map.fitBounds(bounds, { padding: 40 });

      // ─── Fullscreen toggle ─────────────────────────────────────────────────
      var wrapper = document.getElementById('corridor-map-wrapper');
      var fsBtn = document.getElementById('corridor-fullscreen-btn');

      function toggleFullscreen() {
        wrapper.classList.toggle('fullscreen');
        var isFs = wrapper.classList.contains('fullscreen');
        document.body.style.overflow = isFs ? 'hidden' : '';
        // In fullscreen, allow free scroll-to-zoom; otherwise keep cooperative mode
        if (isFs) {
          map.scrollZoom.enable();
          map.touchZoomRotate.enable();
          map.touchPitch.enable();
        } else {
          map.scrollZoom.disable();
          map.touchZoomRotate.disable();
          map.touchPitch.disable();
        }
        setTimeout(function() {
          map.resize();
          map.fitBounds(bounds, { padding: isFs ? 60 : 40 });
        }, 100);
      }

      if (fsBtn) {
        fsBtn.addEventListener('click', toggleFullscreen);
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && wrapper.classList.contains('fullscreen')) {
          toggleFullscreen();
        }
      });

      // ─── Gesture overlay hint ──────────────────────────────────────────────
      var gestureOverlay = document.createElement('div');
      gestureOverlay.className = 'map-gesture-overlay';
      gestureOverlay.setAttribute('aria-hidden', 'true');
      var isMac = /Mac|iPhone|iPad/.test(navigator.platform || '');
      gestureOverlay.textContent = isMac ? 'Use \u2318 + scroll to zoom' : 'Use Ctrl + scroll to zoom';
      wrapper.appendChild(gestureOverlay);

      var hintTimer;
      function showGestureHint() {
        gestureOverlay.classList.add('visible');
        clearTimeout(hintTimer);
        hintTimer = setTimeout(function() {
          gestureOverlay.classList.remove('visible');
        }, 1500);
      }

      container.addEventListener('wheel', function(e) {
        if (wrapper.classList.contains('fullscreen')) return;
        if (e.ctrlKey || e.metaKey) {
          map.scrollZoom.enable();
          clearTimeout(hintTimer);
          hintTimer = setTimeout(function() {
            map.scrollZoom.disable();
          }, 400);
        } else {
          showGestureHint();
        }
      }, { passive: true });

      // Mobile: show hint when user tries to pinch-zoom on the map
      container.addEventListener('touchstart', function(e) {
        if (wrapper.classList.contains('fullscreen')) return;
        if (e.touches.length >= 2) {
          gestureOverlay.textContent = 'Use fullscreen to zoom the map';
          showGestureHint();
        }
      }, { passive: true });
    });

    // ─── Public highlight API ────────────────────────────────────────────────
    window.blufflineMap = {
      /**
       * Highlight one project's segments, dim the rest.
       * @param {string} projectId - The project ID to highlight
       * @param {string} [color] - Override highlight color
       */
      highlightProject: function(projectId, color) {
        projectSegmentEntries.forEach(function(entry) {
          var sourceId = 'project-' + entry.id;
          var isMatch = entry.id === projectId;

          if (map.getLayer(sourceId + '-line')) {
            map.setPaintProperty(sourceId + '-line', 'line-opacity', isMatch ? 1 : 0.15);
            map.setPaintProperty(sourceId + '-line', 'line-width', isMatch ? 5.5 : 3);
          }
          if (map.getLayer(sourceId + '-glow')) {
            map.setPaintProperty(sourceId + '-glow', 'line-opacity', isMatch ? 0.3 : 0.03);
            map.setPaintProperty(sourceId + '-glow', 'line-width', isMatch ? 14 : 8);
          }
        });
      },

      /** Reset all project segments to default state. */
      resetHighlights: function() {
        projectSegmentEntries.forEach(function(entry) {
          var sourceId = 'project-' + entry.id;
          if (map.getLayer(sourceId + '-line')) {
            map.setPaintProperty(sourceId + '-line', 'line-opacity', 0.7);
            map.setPaintProperty(sourceId + '-line', 'line-width', 4);
          }
          if (map.getLayer(sourceId + '-glow')) {
            map.setPaintProperty(sourceId + '-glow', 'line-opacity', 0.15);
            map.setPaintProperty(sourceId + '-glow', 'line-width', 10);
          }
        });
      },
    };
  }
</script>
