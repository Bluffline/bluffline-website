---
interface Props {
  label?: string;
  title: string;
  description?: string;
  sbObjectId?: string;
  labelFieldPath?: string;
  titleFieldPath?: string;
  descriptionFieldPath?: string;
}

const { label, title, description, sbObjectId, labelFieldPath, titleFieldPath, descriptionFieldPath } = Astro.props;
---

<section class="page-hero" data-sb-object-id={sbObjectId}>
  <div class="page-hero-inner">
    {label && <p class="section-label" data-sb-field-path={labelFieldPath}>{label}</p>}
    <h1 data-sb-field-path={titleFieldPath}>{title}</h1>
    {description && <p data-sb-field-path={descriptionFieldPath}>{description}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: calc(8rem + var(--banner-height, 0px)) 1.5rem 4rem;
    background: linear-gradient(135deg, var(--mist) 0%, var(--cream) 100%);
    position: relative;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: calc(10rem + var(--banner-height, 0px)) 3rem 5rem;
    }
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 40% at 80% 20%, rgba(201, 251, 255, 0.4), transparent);
    pointer-events: none;
  }

  .page-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--forest);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--navy);
    margin-bottom: 1.25rem;
    max-width: 800px;
  }

  .page-hero-inner > p:not(.section-label) {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.8;
    max-width: 650px;
  }
</style>
