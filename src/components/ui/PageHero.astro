---
interface Props {
  label?: string;
  title: string;
  description?: string;
  /** Optional hero image displayed below the text content */
  heroImage?: string;
  heroImageAlt?: string;
}

const { label, title, description, heroImage, heroImageAlt = '' } = Astro.props;
---

<section class:list={['page-hero', { 'has-image': !!heroImage }]}>
  {heroImage && (
    <div class="page-hero-image">
      <img src={heroImage} alt={heroImageAlt} />
    </div>
  )}
  <div class="page-hero-inner">
    {label && <p class="section-label">{label}</p>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: calc(8rem + var(--banner-height, 0px)) 1.5rem 4rem;
    background: linear-gradient(135deg, var(--mist) 0%, var(--cream) 100%);
    position: relative;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: calc(10rem + var(--banner-height, 0px)) 3rem 5rem;
    }
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 40% at 80% 20%, rgba(201, 251, 255, 0.4), transparent);
    pointer-events: none;
  }

  /* Hero image styling */
  .page-hero.has-image {
    padding-bottom: 0;
    overflow: hidden;
  }

  .page-hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-hero.has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(239, 247, 255, 0.88) 0%,
      rgba(248, 246, 240, 0.82) 100%
    );
    z-index: 0;
    pointer-events: none;
  }

  .page-hero.has-image .page-hero-inner {
    padding-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .page-hero.has-image .page-hero-inner {
      padding-bottom: 5rem;
    }
  }

  .page-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--forest);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--navy);
    margin-bottom: 1.25rem;
    max-width: 800px;
  }

  .page-hero-inner > p:not(.section-label) {
    font-size: 1.15rem;
    color: var(--navy);
    opacity: 0.8;
    max-width: 650px;
  }
</style>
