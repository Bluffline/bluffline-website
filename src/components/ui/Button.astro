---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'small';
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', class: className, target, rel } = Astro.props;

const baseClasses = 'btn';
const variantClasses = {
  primary: '',
  outline: 'btn-outline',
  small: 'btn-small'
};

const classes = [baseClasses, variantClasses[variant], className].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button class={classes} type="button">
    <slot />
  </button>
)}

<!-- Button styles are defined in global.css for consistency across the site -->
