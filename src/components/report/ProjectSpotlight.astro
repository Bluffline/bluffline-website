---
import PhaseTracker from '../ui/PhaseTracker.astro';
import type { Phase } from '../ui/PhaseTracker.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  status: 'planning' | 'funded' | 'in-delivery' | 'complete';
  targetDate?: string;
  partner?: string;
  funder?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const { title, subtitle, description, status, targetDate, partner, funder, imageSrc, imageAlt } = Astro.props;

const statusConfig = {
  planning: { label: 'Planning', color: 'var(--navy)', bg: 'rgba(255, 255, 255, 0.95)' },
  funded: { label: 'Funded', color: 'var(--forest)', bg: 'rgba(255, 255, 255, 0.95)' },
  'in-delivery': { label: 'In Delivery', color: 'var(--forest)', bg: 'rgba(255, 255, 255, 0.95)' },
  complete: { label: 'Complete', color: 'var(--forest)', bg: 'var(--spring)' }
};

const currentStatus = statusConfig[status];

const statusOrder = ['planning', 'funded', 'in-delivery', 'complete'] as const;
const currentIndex = statusOrder.indexOf(status);

const phases: Phase[] = [
  { label: 'Planning', status: currentIndex > 0 ? 'complete' : currentIndex === 0 ? 'current' : 'upcoming' },
  { label: 'Funded', status: currentIndex > 1 ? 'complete' : currentIndex === 1 ? 'current' : 'upcoming' },
  { label: 'In Delivery', status: currentIndex > 2 ? 'complete' : currentIndex === 2 ? 'current' : 'upcoming' },
  { label: 'Complete', status: currentIndex > 3 ? 'complete' : currentIndex === 3 ? 'current' : 'upcoming' },
];
---

<article class="project-spotlight">
  <div class="spotlight-content">
    <div class="spotlight-header">
      {subtitle && <span class="spotlight-subtitle">{subtitle}</span>}
      <h3 class="spotlight-title">{title}</h3>
    </div>

    <p class="spotlight-description">{description}</p>

    <div class="spotlight-meta">
      {partner && (
        <div class="meta-item">
          <span class="meta-label">Partner</span>
          <span class="meta-value">{partner}</span>
        </div>
      )}
      {funder && (
        <div class="meta-item">
          <span class="meta-label">Funding</span>
          <span class="meta-value">{funder}</span>
        </div>
      )}
    </div>

    <div class="spotlight-status-bar">
      <PhaseTracker phases={phases} />
      {targetDate && (
        <div class="target-date">
          <span class="target-label">Target completion:</span>
          <span class="target-value">{targetDate}</span>
        </div>
      )}
    </div>
  </div>

  {imageSrc && (
    <div class="spotlight-image">
      <img src={imageSrc} alt={imageAlt || title} loading="lazy" />
      <div class="image-badge" style={`background: ${currentStatus.bg}; color: ${currentStatus.color}`}>
        {currentStatus.label}
      </div>
    </div>
  )}
</article>

<style>
  .project-spotlight {
    display: grid;
    gap: 2rem;
    background: white;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid rgba(45, 48, 71, 0.08);
    box-shadow: 0 4px 16px rgba(45, 48, 71, 0.04);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .project-spotlight {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      padding: 2.5rem;
    }
  }

  .spotlight-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .spotlight-subtitle {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .spotlight-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    line-height: 1.2;
    margin: 0;
  }

  .spotlight-description {
    font-size: 1.05rem;
    color: var(--navy);
    opacity: 0.8;
    line-height: 1.7;
    margin: 0;
  }

  .spotlight-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--navy);
    opacity: 0.5;
    font-weight: 600;
  }

  .meta-value {
    font-size: 0.95rem;
    color: var(--navy);
    font-weight: 500;
  }

  .spotlight-status-bar {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
  }

  .target-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .target-label {
    font-size: 0.8rem;
    color: var(--navy);
    opacity: 0.5;
  }

  .target-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest);
  }

  .spotlight-image {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--mist);
  }

  .spotlight-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
</style>
