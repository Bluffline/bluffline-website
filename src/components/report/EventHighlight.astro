---
interface Props {
  title: string;
  date?: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  imageCaption?: string;
  sponsor?: string;
}

const { title, date, description, imageSrc, imageAlt, imageCaption, sponsor } = Astro.props;
---

<article class="event-highlight">
  {imageSrc && (
    <div class="event-image">
      <img src={imageSrc} alt={imageAlt || title} loading="lazy" />
      {imageCaption && <span class="image-caption">{imageCaption}</span>}
    </div>
  )}
  <div class="event-content">
    {date && <span class="event-date">{date}</span>}
    <h3 class="event-title">{title}</h3>
    <p class="event-description">{description}</p>
    {sponsor && (
      <div class="event-sponsor">
        <span class="sponsor-label">Event sponsored by</span>
        <span class="sponsor-name">{sponsor}</span>
      </div>
    )}
    <slot />
  </div>
</article>

<style>
  .event-highlight {
    display: grid;
    gap: 2rem;
    background: white;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(45, 48, 71, 0.08);
  }

  @media (min-width: 768px) {
    .event-highlight {
      grid-template-columns: 1fr 1.2fr;
      gap: 0;
    }
  }

  .event-image {
    position: relative;
    aspect-ratio: 16/10;
    background: var(--mist);
  }

  @media (min-width: 768px) {
    .event-image {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: white;
    font-size: 0.85rem;
  }

  .event-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .event-content {
      padding: 3rem;
    }
  }

  .event-date {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--forest);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .event-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    color: var(--navy);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .event-description {
    font-size: 1rem;
    color: var(--navy);
    opacity: 0.8;
    line-height: 1.7;
    margin: 0;
  }

  .event-sponsor {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sponsor-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--navy);
    opacity: 0.5;
  }

  .sponsor-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
  }

  .event-highlight :global(.big-quote) {
    padding: 1.5rem 0 0 0;
    margin-top: 1.5rem;
    border-top: 1px solid rgba(45, 48, 71, 0.08);
  }

  .event-highlight :global(.big-quote p) {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
</style>
