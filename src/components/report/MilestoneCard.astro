---
interface Props {
  level: string;
  title: string;
  description: string;
  year?: string;
  status?: 'complete' | 'current' | 'upcoming';
}

const { level, title, description, year, status = 'complete' } = Astro.props;

const statusLabels = {
  complete: 'Adopted',
  current: 'In Progress',
  upcoming: 'Upcoming'
};
---

<div class:list={['milestone-card', status]}>
  <div class="milestone-header">
    <span class="milestone-level">{level}</span>
    {year && <span class="milestone-year">{year}</span>}
  </div>
  <h3 class="milestone-title">{title}</h3>
  <p class="milestone-description">{description}</p>
  <div class="milestone-status">
    <span class="status-dot"></span>
    <span class="status-label">{statusLabels[status]}</span>
  </div>
</div>

<style>
  .milestone-card {
    background: white;
    border-radius: 16px;
    padding: 1.75rem;
    border: 1px solid rgba(45, 48, 71, 0.08);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .milestone-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--spring);
    transition: width 0.3s ease;
  }

  .milestone-card:hover {
    box-shadow: 0 8px 24px rgba(45, 48, 71, 0.08);
    transform: translateY(-2px);
  }

  .milestone-card:hover::before {
    width: 6px;
  }

  .milestone-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .milestone-level {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--forest);
    font-weight: 600;
  }

  .milestone-year {
    font-size: 0.85rem;
    color: var(--navy);
    opacity: 0.5;
    font-weight: 500;
  }

  .milestone-title {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .milestone-description {
    font-size: 0.95rem;
    color: var(--navy);
    opacity: 0.75;
    line-height: 1.5;
    margin: 0 0 1rem 0;
  }

  .milestone-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--spring);
  }

  .milestone-card.current .status-dot {
    background: var(--forest);
    animation: pulse 2s infinite;
  }

  .milestone-card.upcoming .status-dot {
    background: var(--navy);
    opacity: 0.3;
  }

  .status-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy);
    opacity: 0.6;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
