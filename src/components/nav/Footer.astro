---
import Logo from '../ui/Logo.astro';
---

<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <Logo variant="reverse" />
        </a>
        <p>Transformative active transit infrastructure for the Pensacola region.</p>
      </div>
      <div class="footer-col">
        <h4>About</h4>
        <a href="/about">Overview</a>
        <a href="/about/corridor">The Corridor</a>
        <a href="/about/impact">Impact</a>
        <a href="/about/community-support">Our Friends</a>
        <a href="/about/governance">Governance</a>
      </div>
      <div class="footer-col">
        <h4>Progress</h4>
        <a href="/progress">Overview</a>
        <a href="/progress/planning">Planning</a>
        <a href="/progress/updates">Updates</a>
      </div>
      <div class="footer-col">
        <h4>Get Involved</h4>
        <a href="/support">Support</a>
        <a href="/support#get-involved">Volunteer</a>
        <a href="https://shop.thebluffline.org" target="_blank" rel="noopener">Shop</a>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <a href="/press">Press</a>
        <a href="/documents/annual-reports">Annual Reports</a>
        <a href="https://www.guidestar.org/profile/shared/3f2988d3-05cc-4b67-a1e8-3124c25d670c" target="_blank" rel="noopener noreferrer">GuideStar Profile</a>
        <a href="/legal">Legal</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Bluffline, Inc. A 501(c)(3) nonprofit organization.</p>
      <div class="social-links">
        <a href="https://www.facebook.com/bluffline/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/thebluffline/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/bluffline/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--navy);
    color: white;
    padding: 4rem 1.5rem 2rem;
  }

  @media (min-width: 768px) {
    footer {
      padding: 5rem 3rem 2rem;
    }
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 600px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      gap: 4rem;
    }
  }

  .footer-brand p {
    opacity: 0.7;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    max-width: 300px;
  }

  .footer-logo :global(svg) {
    height: 40px;
    width: auto;
  }

  .footer-col h4 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
    font-weight: 600;
    opacity: 0.5;
  }

  .footer-col a {
    display: block;
    color: white;
    opacity: 0.7;
    text-decoration: none;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    transition: opacity 0.2s ease;
  }

  .footer-col a:hover {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-bottom p {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-links a {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0.7;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.2);
  }
</style>
