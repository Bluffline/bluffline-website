# OpenAI ChatKit configuration
# Copy this file to .env.local for local development.
# In production, set these in the Netlify dashboard under Site > Environment Variables.

# Your OpenAI API key (keep secret — never commit the real value)
OPENAI_API_KEY=sk-...

# The Workflow ID from OpenAI Agent Builder
# Found at: platform.openai.com/agent-builder > your agent > publish > Workflow ID
OPENAI_WORKFLOW_ID=wf_...

# Sveltia CMS login (/admin): GitHub OAuth app credentials.
# Create the app at github.com/settings/developers (or under the Bluffline org settings)
# with callback URL https://thebluffline.org/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
